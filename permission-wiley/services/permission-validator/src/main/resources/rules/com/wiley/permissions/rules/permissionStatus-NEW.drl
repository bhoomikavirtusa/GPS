rule "Not Managed 2"
agenda-group "Asset-Managed"
salience 5400
	when
		not PermissionStatus()
		asset : Asset(managed == Boolean.FALSE)
		contract : Contract()
	then
		// -- this should be identical to code in 5100
		validationResult.setNeedPaymentRequest(contract.isNeedPaymentRequest());
		validationResult.setPaid(contract.isPaid());
end

rule "Not Managed 3"
agenda-group "Asset-Managed"
salience 5300
	when
		not PermissionStatus()
		asset : Asset(managed == Boolean.FALSE && royaltyFree == Boolean.FALSE)
	then
		insert(PermissionStatus.GRANTED);
		validationResult.setStatus(PermissionStatus.GRANTED);
		String explanation = "NOT managed AND NOT feeRequired -> GRANTED";
		validationResult.setExplanation(explanation);
		RuleLog.debug(explanation);
end

// from this point on we are only dealing with Asset(managed == Boolean.TRUE)
// so we are not going to bother specifying this

rule "If no POs or Contracts"
agenda-group "Asset-Managed"
salience 5200
	when
		not PermissionStatus()
		purchaseOrderList : PurchaseOrderList()
		contractList : ContractList()
		eval(CollectionUtils.isEmpty(purchaseOrderList))
		eval(CollectionUtils.isEmpty(contractList))
		asset : Asset()
	then
		PermissionStatus status = PermissionStatus.UNREQUESTED;
		// James says only one of the "will-be" flags will be checked at a time
		if (asset.isWillBeWorkForHire())  status = PermissionStatus.NOT_REQUESTED_BE_WORKFORHIRE;
		else if (asset.isWillBeRoyaltyFree())  status = PermissionStatus.NOT_REQUESTED_ROYALTY_FREE;
		insert(status);
		validationResult.setStatus(status);
		String explanation = "managed AND No POs or Contracts - Not Requested";
		validationResult.setExplanation(explanation);
		RuleLog.debug(explanation);
end

rule "Check contract"
agenda-group "Asset-Managed"
salience 5100
	when
		not PermissionStatus()
		contract : Contract()
		source : Source()
		assetUse : AssetUse()
	then
		RuleLog.debug("Then: Check contract");

		ApplicationContext ctx = AppContext.getApplicationContext();
		ConditionRepository conditionRepository = (ConditionRepository) ctx.getBean("repository.ConditionRepository");
		ContractRepository contractRepository = (ContractRepository) ctx.getBean("repository.ContractRepository");

		if (contract.isDateExpired()) {
			insert(PermissionStatus.OUT_OF_COMPLIANCE_EXPIRED);
			validationResult.setStatus(PermissionStatus.OUT_OF_COMPLIANCE_EXPIRED);
			String explanation = "Most recent contract expired - OUT_OF_COMPLIANCE";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation);
		} else {
			ConditionMatchResult matchResult = conditionRepository.matches(contract, assetUse);
			
			if (!matchResult.isMatch()) {

// Added for SS Task 12 - Start			
				int totalAssets = contract.getAssets().size();	
				int assetId = assetUse.getAsset().getId().intValue();		
				int assetIndex = 0;		
				for(int assetIdx = 0;assetIdx < totalAssets; assetIdx++){
					if(assetId == contract.getAssets().get(assetIdx).getAssetBaseId().intValue()){
						assetIndex = assetIdx;
						break;
					}
				}
				if (contract.getAssets().get(assetIndex).getApproverName() != null && contract.getAssets().get(assetIndex).getApproverRemarks() != null) {
					insert(PermissionStatus.GRANTED_INSUFFICIENT_APPROVED);
					validationResult.setStatus(PermissionStatus.GRANTED_INSUFFICIENT_APPROVED);
					String explanation = "CONTRACT_INSUFFICIENT exception is approved by - " + contract.getAssets().get(assetIndex).getApproverName() + " with remarks - " + contract.getAssets().get(assetIndex).getApproverRemarks();
					validationResult.setExplanation(explanation);
					RuleLog.debug(explanation);
				}
// Added for SS Task 12 - End						
				else {
				insert(PermissionStatus.CONTRACT_INSUFFICIENT);
				validationResult.setStatus(PermissionStatus.CONTRACT_INSUFFICIENT);
				String explanation = "Most recent contract did not match - CONTRACT_INSUFFICIENT: " + matchResult.getExplanation();
				validationResult.setExplanation(explanation);
				RuleLog.debug(explanation);
				}
			}
		    else if (contractRepository.doesContractNeedAmendment(contract)) {
			    if (contract.hasAmendment()) {
		    		insert(PermissionStatus.AMENDMENT_SENT);
					validationResult.setStatus(PermissionStatus.AMENDMENT_SENT);
					String explanation = "Most recent contract has amendment sent - AMENDMENT_SENT";
					validationResult.setExplanation(explanation);
					RuleLog.debug(explanation);
				}
			}
			else if (contractRepository.exceededPrinting(contract)) {
				RuleLog.debug("Contract exceeded printing.");	
				insert(PermissionStatus.OUT_OF_COMPLIANCE_PRINT_RUN);
				validationResult.setStatus(PermissionStatus.OUT_OF_COMPLIANCE_PRINT_RUN);
				String explanation = "Most recent contract exceeded printing - OUT_OF_COMPLIANCE";
				validationResult.setExplanation(explanation);
				RuleLog.debug(explanation);
			}
			else if (assetUse.getAsset().isManagerApproved()) { //Added a new status for DM-374
				insert(PermissionStatus.GRANTED_MANAGER_APPROVED);
				validationResult.setStatus(PermissionStatus.GRANTED_MANAGER_APPROVED);
				String explanation = "Manager Approved this asset - "+PermissionStatus.GRANTED_MANAGER_APPROVED;
				validationResult.setExplanation(explanation);
				RuleLog.debug(explanation);
			}
			else {
				PermissionStatus status = PermissionStatus.GRANTED;
				String explanation = "Most recent contract matches everything and no limits on Print Run, End Date, Language, Sublicense - GRANTED";
				
				String limitedExplanation = contract.getLimitedExplanation();
				if (limitedExplanation.length() > 0) {
					status = contract.isUnlimitedPrintRun() ? PermissionStatus.GRANTED_LIMITED : PermissionStatus.GRANTED_LIMITED_PRINT;
					explanation = "Most recent contract matches everything but " + limitedExplanation + " - GRANTED_LIMITED";
				}

				insert(status);
				validationResult.setStatus(status);
				validationResult.setExplanation(explanation);
				RuleLog.debug(explanation);
				
				// -- this should be identical to code in 5400
				validationResult.setNeedPaymentRequest(contract.isNeedPaymentRequest());
				validationResult.setPaid(contract.isPaid());
			}
		}
end

rule "Check purchase order"
agenda-group "Asset-Managed"
salience 5000
	when
		not PermissionStatus()
		purchaseOrder : PurchaseOrder()
		asset : Asset()
	then
		RuleLog.debug("Then: Check purchase order");
		PermissionStatus status = PermissionStatus.FORM_SENT;
		// James says only one of the "will-be" flags will be checked at a time
		if (asset.isWillBeWorkForHire())  status = PermissionStatus.FORM_SENT_BE_WORKFORHIRE;
		else if (asset.isWillBeRoyaltyFree())  status = PermissionStatus.FORM_SENT_BE_ROYALTYFREE;
	   	insert(status);
		validationResult.setStatus(status);
		String explanation = "Managed AND We have a PO";
		validationResult.setExplanation(explanation);
		RuleLog.debug(explanation + " - FORM_SENT");
end
