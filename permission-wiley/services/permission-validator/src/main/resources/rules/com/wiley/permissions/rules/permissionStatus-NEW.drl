rule "Initializing Block"
agenda-group "Permission-Status"
salience 7000
	when
		not PermissionStatus()
		assetUse : AssetUse()
	then
		// Need to insert the facts required to activate these rules
		insert(assetUse.getAsset());
		insert(assetUse.getCommonWork());

		drools.setFocus("Check-OwnerType");
end

rule "Reviewed Unknown"
agenda-group "Check-OwnerType"
salience 6900
	when
		not PermissionStatus()
		asset : Asset(reviewedUnknown == Boolean.TRUE)
	then
		insert(PermissionStatus.LEGACY_UPLOAD_REVIEWED_UNKNOWN);
		validationResult.setStatus(PermissionStatus.LEGACY_UPLOAD_REVIEWED_UNKNOWN);
		String explanation = "Reviewed Unknown Asset flag set";
		validationResult.setExplanation(explanation);
		RuleLog.debug(explanation);
end

rule "Author Provided Unknown"
agenda-group "Check-OwnerType"
salience 6800
	when
		not PermissionStatus()
		asset : Asset(authorProvidedUnknown == Boolean.TRUE)
	then
		insert(PermissionStatus.LEGACY_UPLOAD_AUTHOR_PROVIDED);
		validationResult.setStatus(PermissionStatus.LEGACY_UPLOAD_AUTHOR_PROVIDED);
		String explanation = "Author Provided Unknown Asset flag set";
		validationResult.setExplanation(explanation);
		RuleLog.debug(explanation);
end

rule "From Filemaker"
agenda-group "Check-OwnerType"
salience 6700
	when
		not PermissionStatus()
		assetUse : AssetUse(importSource == ImportSource.FROM_FILEMAKER)
		contractList : ContractList()
	then
		// there is probably a way to check for empty list above in the "when"
		// section, which would be nicer, but not sure how to do it
		if (CollectionUtils.isEmpty(contractList)) {
			insert(PermissionStatus.MIGRATED_FROM_FILEMAKER);
			validationResult.setStatus(PermissionStatus.MIGRATED_FROM_FILEMAKER);
			String explanation = "Import Source == From Filemaker";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation);
		}
		// else - continue onward to a different status
end

rule "From Australia"
agenda-group "Check-OwnerType"
salience 6600
	when
		not PermissionStatus()
		assetUse : AssetUse(importSource == ImportSource.FROM_AUSTRALIA)
	then
		// at one point checked for contract as above for Filemaker but
		// requirement for AUS is just to show AUS status even if there is a contract
		insert(PermissionStatus.MIGRATED_FROM_AUSTRALIA);
		validationResult.setStatus(PermissionStatus.MIGRATED_FROM_AUSTRALIA);
		String explanation = "Import Source == From Australia";
		validationResult.setExplanation(explanation);
		RuleLog.debug(explanation);
	end

rule "STM Guidelines"
agenda-group "Check-OwnerType"
salience 6400
	when
		not PermissionStatus()
		asset : Asset(stmGuidelines == Boolean.TRUE)
	then
		insert(PermissionStatus.GRANTED_STM_GUIDELINES);
		validationResult.setStatus(PermissionStatus.GRANTED_STM_GUIDELINES);
		String explanation = "STM Guidelines flag set";
		validationResult.setExplanation(explanation);
		RuleLog.debug(explanation);
end

rule "Public Domain"
agenda-group "Check-OwnerType"
salience 6300
	when
		not PermissionStatus()
		asset : Asset(ownerType == OwnerType.PUBLIC_DOMAIN)
		contractList : ContractList()
	then
	    if (asset.isManaged()) {
				insert(PermissionStatus.UNREQUESTED);
				validationResult.setStatus(PermissionStatus.UNREQUESTED);
				String explanation = "Public Domain with Not Requested Status";
				validationResult.setExplanation(explanation);
				RuleLog.debug(explanation);	
			//insert(PermissionStatus.ILLEGAL);
			//validationResult.setStatus(PermissionStatus.ILLEGAL);
			//String explanation = "Public Domain must NOT be Managed";
			//validationResult.setExplanation(explanation);
			//RuleLog.debug(explanation + " - ILLEGAL");
		// 2/2014: James says is no longer possible for an asset to be unmanaged and feeRequired
		//} else if (asset.isFeeRequired()) {
		//    insert(PermissionStatus.UNPAID);
		//    validationResult.setStatus(PermissionStatus.UNPAID);
		//    String explanation = "Public Domain AND feeRequired - UNPAID";
		//    validationResult.setExplanation(explanation);
		//    RuleLog.debug(explanation);
		} else {
				Contract contract = null;				
				if (CollectionUtils.isNotEmpty(contractList)) {
					contract = contractList.get(0);  // first is newest
					validationResult.setContractId(contract.getId());
				}
		        insert(PermissionStatus.GRANTED_PUBLIC_DOMAIN);
			    validationResult.setStatus(PermissionStatus.GRANTED_PUBLIC_DOMAIN);
			    String explanation = "Public Domain AND no feeRequired - GRANTED_PUBLIC_DOMAIN";
			    validationResult.setExplanation(explanation);
			    RuleLog.debug(explanation);
		}
end

rule "Fair Use"
agenda-group "Check-OwnerType"
salience 6300
	when
		not PermissionStatus()
		asset : Asset(ownerType == OwnerType.FAIR_USE)
	then
	    if (asset.isManaged()) {
			insert(PermissionStatus.ILLEGAL);
			validationResult.setStatus(PermissionStatus.ILLEGAL);
			String explanation = "Fair Use must NOT be Managed";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation + " - ILLEGAL");
		} else if (asset.isFeeRequired()) {
		    insert(PermissionStatus.ILLEGAL);
		    validationResult.setStatus(PermissionStatus.ILLEGAL);
		    String explanation = "Fair Use cannot have feeRequired";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation + " - ILLEGAL");
		} else {
		    insert(PermissionStatus.GRANTED_FAIR_USE);
		    validationResult.setStatus(PermissionStatus.GRANTED_FAIR_USE);
		    String explanation = "Fair Use AND no feeRequired - GRANTED_FAIR_USE";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
		}
end

rule "Third Party"
agenda-group "Check-OwnerType"
salience 6200
	when
		not PermissionStatus()
		asset : Asset(ownerType == OwnerType.THIRD_PARTY)
	then
		if (CollectionUtils.isEmpty(asset.getSources())) {
			insert(PermissionStatus.NO_SOURCE);
			validationResult.setStatus(PermissionStatus.NO_SOURCE);
			String explanation = "Third Party AND no source - NO_SOURCE";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation);
		} else {
			RuleLog.debug("Third Party - Activating Asset-Managed Agenda");
			drools.setFocus("Asset-Managed");
		}
end

rule "Request"
agenda-group "Check-OwnerType"
salience 6100
	when
		not PermissionStatus()
		asset : Asset(ownerType == OwnerType.PHOTO_REQUEST || ownerType == OwnerType.ILLUSTRATION_REQUEST)
	then
		if (CollectionUtils.isEmpty(asset.getSources())) {
			insert(PermissionStatus.NO_SOURCE);
			validationResult.setStatus(PermissionStatus.NO_SOURCE);
			String explanation = "Photo/Illustration Request AND no source - NO_SOURCE";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation);
		}
		else {
			insert(PermissionStatus.ILLEGAL);
			validationResult.setStatus(PermissionStatus.ILLEGAL);
			String explanation = "Photo/Illustration Request cannot have source(s)";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation + " - ILLEGAL");
		}
end

rule "Wiley Owned"
agenda-group "Check-OwnerType"
salience 6000
	when
		not PermissionStatus()
		asset : Asset(ownerType == OwnerType.WILEY || ownerType == OwnerType.WORK_FOR_HIRE || ownerType == OwnerType.WILEY_CREATED)
		contractList : ContractList()
	then
		if (asset.isManaged()) {
			insert(PermissionStatus.UNREQUESTED);
			validationResult.setStatus(PermissionStatus.UNREQUESTED);
			String explanation = asset.getOwnerType().getCode() + " must NOT be Managed";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation + " - ILLEGAL");
		}
		else {
			if (asset.getOwnerType().equals(OwnerType.WORK_FOR_HIRE)) {
				insert(PermissionStatus.GRANTED_WORK_FOR_HIRE);
		    	validationResult.setStatus(PermissionStatus.GRANTED_WORK_FOR_HIRE);
		    	String explanation = "Work for Hire and not managed - GRANTED_WORK_FOR_HIRE";
		    	validationResult.setExplanation(explanation);
		    	RuleLog.debug(explanation);
			}
			else {
				Contract contract = null;				
				if (CollectionUtils.isNotEmpty(contractList)) {
					contract = contractList.get(0);  // first is newest
					validationResult.setContractId(contract.getId());
				}
				insert(PermissionStatus.GRANTED_WILEY_OWNED);
		    	validationResult.setStatus(PermissionStatus.GRANTED_WILEY_OWNED);
		    	String explanation = "Wiley owned and not managed - GRANTED_WILEY_OWNED";
		    	validationResult.setExplanation(explanation);
		    	RuleLog.debug(explanation);
		    }
		}
end

rule "Author created"
agenda-group "Check-OwnerType"
salience 6000
	when
		not PermissionStatus()
		asset : Asset(ownerType == OwnerType.AUTHOR_OWNED)
	then
		if (CollectionUtils.isEmpty(asset.getSources())) {
			insert(PermissionStatus.NO_SOURCE);
			validationResult.setStatus(PermissionStatus.NO_SOURCE);
			String explanation = "Author owned AND no source - NO_SOURCE";
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation);
		} else {
			RuleLog.debug("Author owned - Activating Asset-Managed Agenda");
			drools.setFocus("Asset-Managed");
		}
		/*	
			//Specification has changes as part of DM-186.
			//Now for Author owned owner type, if the other layer owner type is "Will be work for  hire" or
			//"No value selected on layer 2 owner type" then it has to go through permission work flow.
		*/
end

// This used to be below "Royalty Free" rule below but needs to be above
// so that the contract is set on the validationResult, even though the
// "Royalty Free" rule does not look at it.
rule "Determine newest PO or Contract"
agenda-group "Asset-Managed"
salience 5700
when
	not PermissionStatus()
	poList : PurchaseOrderList()
	contractList : ContractList()
then
	RuleLog.debug("5700: Determine newest PO or Contract");
	// Important: poService and contractService methods to load list above sort by date desc
	// Even if newest Contract has expired, we still want the status for the newest.
	PurchaseOrder po = null;
	Contract contract = null;
	if (CollectionUtils.isNotEmpty(poList)) {
		po = poList.get(0);  // first is the newest
		validationResult.setPoId(po.getId());
	}
	if (CollectionUtils.isNotEmpty(contractList)) {
		contract = contractList.get(0);  // first is newest
		validationResult.setContractId(contract.getId());
	}
	if (contract != null || po != null) {
		if (contract != null && po != null) {
			// if po and contract date are the same then contract should "win"
			//if (contract.getDate().after(po.getDate())) {
			if (!po.getDate().after(contract.getDate())) {
				po = null;
			}
			else {
				contract = null;
			}
		}
		
		if (po != null) {
			// find newest contract for po (but po may not have any contracts)
			for (Contract c : contractList) {
				PurchaseOrder temp = c.getPurchaseOrder();
				if (temp!= null && temp.getId().intValue() == po.getId().intValue()) {
					contract = c;
					validationResult.setContractId(contract.getId());
					po = null;
					break;
				} 
			}
		}
		
		if (contract == null) insert(po);
		else insert(contract);
	}
end

rule "Royalty Free"
agenda-group "Asset-Managed"
salience 5600
	when
		not PermissionStatus()
		asset : Asset(royaltyFree == Boolean.TRUE)
		assetUse : AssetUse()
		contractList : ContractList()
	then
	    // if (royaltyFree) then should be !managed and OwnerType should be 3rd Party but
	    // for now we aren't going to check/enforce this (maybe not necessary)
	    // James is certain that royaltyFree implies 3rd Party but little less about royaltyFree implies !managed
		// *******************************************************
		// if no seat limit then status = Granted RF Unlimited
		// if user already has seat then status = Granted RF Limited
		// if seat is available allocate seat to user, decrement count status = Granted RF Limited
		// if no seat available then treat like a rights managed 3rd party asset. Initial status = Unrequested. Asset goes through standard request workflow. During invoice entry do not allow user to select RightsManaged option.
		// After invoice entered add new seat allotment to existing total (if new is unlimited then set to unlimited). Same for print run limit.
		
		RuleLog.debug("5600: Royalty Free");

		ApplicationContext ctx = AppContext.getApplicationContext();
	    ConditionRepository conditionRepository = (ConditionRepository) ctx.getBean("repository.ConditionRepository");
	   // sandhya manage deals
	   //Added for Paperwork changes to add the Contract
	   Contract contract = null;				
	    if (CollectionUtils.isNotEmpty(contractList)) {
			contract = contractList.get(0);  // first is newest
			validationResult.setContractId(contract.getId());
		} 
		//Ends Added for Paperwork changes to add the Contract
	    if (asset.getTotalPrintRun() > 0 && asset.getTotalSeats() > 0 && asset.isSublicense()) {
	   		RuleLog.debug("5600: Royalty Free - Limited Print Run & Seats");
		    insert(PermissionStatus.GRANTED_RF_LIMITED_PRINT_SEATS);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_LIMITED_PRINT_SEATS);
		    String explanation = "Royalty Free - Limited Print Run & Seats  - GRANTED_RF_LIMITED_PRINT_SEATS";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    } else if(asset.getTotalPrintRun() > 0 && asset.getTotalSeats() <= 0 && (asset.isSublicense())) {
	   		RuleLog.debug("5600: Royalty Free – Limited Print Run");
		    insert(PermissionStatus.GRANTED_RF_LIMITED_PRINTRUN);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_LIMITED_PRINTRUN);
		    String explanation = "Royalty Free – Limited Print Run - GRANTED_RF_LIMITED_PRINTRUN";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    } else if(asset.getTotalPrintRun() > 0 && asset.getTotalSeats() <= 0 && !(asset.isSublicense())) {
	   		RuleLog.debug("5600: Royalty Free  - Limited Print Run & No Sublicensing");
		    insert(PermissionStatus.GRANTED_RF_LIMITED_PRINT_SUBLIC);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_LIMITED_PRINT_SUBLIC);
		    String explanation = "Royalty Free  - Limited Print Run & No Sublicensing - GRANTED_RF_LIMITED_PRINT_SUBLIC";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    } else if(asset.getTotalPrintRun()<= 0 && asset.getTotalSeats() > 0 && (asset.isSublicense())) {
	   		RuleLog.debug("5600: Royalty Free – Limited Seats");
		    insert(PermissionStatus.GRANTED_RF_LIMITED);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_LIMITED);
		    String explanation = "Royalty Free – Limited Seats - GRANTED_RF_LIMITED";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    } else if(asset.getTotalPrintRun() <= 0 && asset.getTotalSeats() > 0 && !(asset.isSublicense())) {
	   		RuleLog.debug("5600: 'Royalty Free – Limited Seats & No Sublicensing");
		    insert(PermissionStatus.GRANTED_RF_LIMITED_SEATS_SUBLIC);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_LIMITED_SEATS_SUBLIC);
		    String explanation = "Royalty Free – Limited Seats & No Sublicensing - GRANTED_RF_LIMITED_SEATS_SUBLIC";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    }else if(asset.getTotalPrintRun() <= 0 && asset.getTotalSeats() <= 0 && (asset.isSublicense())) {
	   		RuleLog.debug("5600: Royalty Free - Unlimited Print Run, Seats & Sublicensing");
		    insert(PermissionStatus.GRANTED_RF_UNLIMITED_PRINT_SUBLIC);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_UNLIMITED_PRINT_SUBLIC);
		    String explanation = "Royalty Free - Unlimited Print Run, Seats & Sublicensing - GRANTED_RF_UNLIMITED_PRINT_SUBLIC";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    } else if(asset.getTotalPrintRun() <= 0 && asset.getTotalSeats() <= 0 && !(asset.isSublicense())) {
	   		RuleLog.debug("5600: Royalty Free - No Sublicensing");
		    insert(PermissionStatus.GRANTED_RF_LIMITED_SUBLIC);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_LIMITED_SUBLIC);
			String explanation = "Royalty Free - No Sublicensing - GRANTED_RF_LIMITED_SUBLIC";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    } else if(asset.getTotalPrintRun() > 0 && asset.getTotalSeats() > 0 && !(asset.isSublicense())) {
	   		RuleLog.debug("5600: Royalty Free – Limited Print Run, Seats & No Sublicensing");
		    insert(PermissionStatus.GRANTED_RF_LIMITED_PRINT_SWAR_SUBLIC);
		    validationResult.setStatus(PermissionStatus.GRANTED_RF_LIMITED_PRINT_SWAR_SUBLIC);
		    String explanation = "Royalty Free – Limited Print Run, Seats & No Sublicensing - GRANTED_RF_LIMITED_PRINT_SWAR_SUBLIC";
		    validationResult.setExplanation(explanation);
		    RuleLog.debug(explanation);
	    }
end	    

