// Documentation on rule language (for Drools 5.2 but seems the same):
// http://docs.jboss.org/drools/release/5.2.0.Final/drools-expert-docs/html/ch05.html

//declare any global variables here
global com.wiley.permissions.validator.rules.service.ValidationResult validationResult;

// The facts added to start (by PermissionStatusRequiresNew.updatePermissionStatus(AssetUse))
// are a single AssetUse and a single Source (if the Asset has multiple sources the
// status is calculated for one at a time).
// - Also a PurchaseOrderList and ContractList - these may be empty (will always be empty
// if there is no source)

rule "Start AssetUse status"
agenda-group "Permission-Status"
salience 7400
	when
	    not PermissionStatus()
		assetUse : AssetUse()
	then 
		RuleLog.debug("Starting AssetUse status calculation");
end

rule "Check if AssetUse is Replaced"
agenda-group "Permission-Status"
salience 7300
	when
		assetUse : AssetUse(cancelReplacement != null)
	then
		/* keep other rules from taking effect by inserting the status as a fact */
		insert(PermissionStatus.REPLACED);
		validationResult.setStatus(PermissionStatus.REPLACED);
		validationResult.setExplanation("AssetUse is Replaced");
		RuleLog.debug("AssetUse is Replaced - REPLACED");
end

rule "Check if AssetUse is Canceled but not Replaced"
agenda-group "Permission-Status"
salience 7300
	when
		assetUse : AssetUse(canceled == Boolean.TRUE && cancelReplacement == null) 
	then
		/* keep other rules from taking effect by inserting the status as a fact */
		PermissionStatus status = assetUse.isRemoved() ? PermissionStatus.REMOVED : PermissionStatus.CANCELED;
		insert(status);
		validationResult.setStatus(status);
		validationResult.setExplanation("AssetUse is Canceled");
		RuleLog.debug("AssetUse is Canceled - CANCELED");
end

rule "Check if  Asset is Missing Info (OwnerType or MediaType)"
agenda-group "Permission-Status"
salience 7200
	when
	    not PermissionStatus()
		assetUse : AssetUse()
	then 
		if (assetUse.getAsset().getOwnerType() == null || assetUse.getAsset().getMediaType() == null) {
			insert(PermissionStatus.MISSING_INFO);
			validationResult.setStatus(PermissionStatus.MISSING_INFO);
			String explanation = "OwnerType is missing";
			if (assetUse.getAsset().getOwnerType() != null) {
			    explanation = "Media Type is missing";
			}
			validationResult.setExplanation(explanation);
			RuleLog.debug(explanation + " - MISSING_INFO");
		}
end

