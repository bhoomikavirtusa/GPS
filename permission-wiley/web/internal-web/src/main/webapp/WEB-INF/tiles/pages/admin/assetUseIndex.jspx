<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form">
	
	<jsp:directive.page pageEncoding="UTF-8"/>

	<table class="width100">
		<tr>
			<th colspan="2">Asset Use Index Info</th>
		</tr>
		<tr>
			<td class="label">Exists?</td>
			<td>${info.indexExists ? "yes" : "no"}</td>
		</tr>
		<tr>
			<td class="label">NumDocs</td>
			<td><fmt:formatNumber value="${info.numDocs}" /></td>
		</tr>
		<tr>
			<td class="label">NumDeletedDocs</td>
			<td><fmt:formatNumber value="${info.numDeletedDocs}" /></td>
		</tr>
		<tr>
			<td class="label">Version</td>
			<td>${info.version}</td>
		</tr>
		<tr>
			<td class="label">NumFiles</td>
			<td><fmt:formatNumber value="${info.numFiles}" /></td>
		</tr>
		<tr>
			<td class="label">TotalFileBytes</td>
			<td><fmt:formatNumber value="${info.totalFileBytes}" /></td>
		</tr>
		<tr>
			<td class="label">NumSegments</td>
			<td><fmt:formatNumber value="${info.numSegments}" /></td>
		</tr>
	</table>
	
	<c:if test="${empty indexedInfo}">
		<c:url var="thisUrl" value="/sapp/admin/assetUseIndex/load?extendedInfo=true" />
		<p><a href="${thisUrl}">Extended Info</a></p>
	</c:if>
	
	<c:if test="${not empty indexedInfo}">
		<table>
			<tr>
				<th colspan="3">Indexed Fields - #unique values - [first 3 values]</th>
			</tr>
			<c:forEach items="${indexedInfo}" var="fieldInfo">
				<tr>
					<td>${fieldInfo.name}</td>
					<td><fmt:formatNumber value="${fieldInfo.count}" /></td>
					<td><c:out value="${fieldInfo.valuesString}" /></td>
				</tr>
			</c:forEach>
		</table>
	</c:if>
	
	<c:if test="${not empty storedInfo}">
		<table>
			<tr>
				<th colspan="2">Stored Fields - #occurrences (may occur more than once in a document)</th>
			</tr>
			<c:forEach items="${storedInfo}" var="fieldInfo">
				<tr>
					<td>${fieldInfo.name}</td>
					<td><fmt:formatNumber value="${fieldInfo.count}" /></td>
				</tr>
			</c:forEach>
		</table>
	</c:if>
	
	<c:url var="buildUrl" value="/sapp/admin/assetUseIndex/build" />
	
	<jsp:directive.include file="/WEB-INF/tiles/pages/include/generalMessage.jspx" />
    
    <div style="margin-top: 1em">	
	<form method="post" action="${buildUrl}">
		CW id(s) <input type="text" name="cwIds" id="cwIds" size="35" />
    	<input type="submit" value="Build Index (partly async)" />
    	(blank means rebuild the entire index, or you can enter CW ids separated by spaces) <br />
    	<input type="checkbox" name="overridePrimeTime" /> Run regardless of "Prime Time" (M-F 8am-7pm)
   	  <c:if test="${not empty cwId}">
   	     <input type="submit" id="buildCurrProd" value="Build Index for current product" /> 
   	  </c:if>
    </form>
    </div>
    
    <form method="get">
    	<table style="margin-top: 2em">
    		<tr>
    			<th>Search index by AssetUse Id</th>
    		</tr>
    		<tr>
    			<td>
    				<input type="text" name="searchAssetUseId" size="20" />
    				<input type="submit" value="Search" />
    			</td>
    		</tr>
    	</table>
    </form>
    
    <c:if test="${not empty searchAssetUseId}">
    	<c:if test="${searchResult == null}">
    		<p class="message">${searchAssetUseId} not found in index.</p>
    	</c:if>
    	<c:if test="${searchResult != null}">
    		<table>
    			<tr>
    				<th colspan="2">Result for ${searchAssetUseId}:</th>
    			</tr>
    			<tr>
    				<td class="label">CW.id</td>
    				<td class="value">${searchResult.commonWorkId}</td>
    			</tr>
    			<tr>
    				<td class="label">CW.interiorCWStatus</td>
    				<td class="value">${searchResult.interiorCWStatus.description}</td>
    			</tr>
    			
    			<tr>
    				<td class="label">Asset.id</td>
    				<td class="value">${searchResult.assetId}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] Source Name(s)</td>
    				<td class="value">${searchResult.sourceNames}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] Media Type (Description)</td>
    				<td class="value">${searchResult.mediaType}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] Description</td>
    				<td class="value">${searchResult.description}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] WorkForHire</td>
    				<td class="value">${searchResult.workForHire}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] OwnerType (Code / Description)</td>
    				<td class="value">${searchResult.ownerTypeCode} / ${searchResult.ownerType}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] SourceRef</td>
    				<td class="value">${searchResult.sourceRef}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] Artist</td>
    				<td class="value">${searchResult.artist}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] restrictedUse</td>
    				<td class="value">${searchResult.restrictedUse}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] active</td>
    				<td class="value">${searchResult.active}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] sourceNofly</td>
    				<td class="value">${searchResult.sourceNofly}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] Has Asset files</td>
    				<td class="value">${searchResult.hasAssetFiles}</td>
    			</tr>
    			<tr>
    				<td class="label">[Asset] Has contracts</td>
    				<td class="value">${searchResult.hasContracts}</td>
    			</tr>
    			
    			<tr>
    				<td class="label">[AU/A] Has files (hasAssetUseFiles || latestContractHasFile)</td>
    				<td class="value">${searchResult.hasFiles}</td>
    			</tr>
    			
    			<tr>
    				<td class="label">[AssetUse] id</td>
    				<td class="value">${searchResult.assetUseId}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] restrictedUseApproved</td>
    				<td class="value">${searchResult.restrictedUseApproved}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] printRunWarning</td>
    				<td class="value">${searchResult.printRunWarning}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] usage (Description)</td>
    				<td class="value">${searchResult.usage}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] permissionStatus</td>
    				<td class="value"><c:out value="${searchResult.permissionStatus}" /></td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] canceled</td>
    				<td class="value">${searchResult.canceled}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] creditLine</td>
    				<td class="value">${searchResult.creditLine}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] position</td>
    				<td class="value">${searchResult.position}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] component id / name</td>
    				<td class="value">${searchResult.componentId} / ${searchResult.componentName}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] manuscriptPage</td>
    				<td class="value">${searchResult.manuscriptPage}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] finalPage</td>
    				<td class="value">${searchResult.finalPage}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] pickup</td>
    				<td class="value">${searchResult.pickup}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] needPaymentRequest</td>
    				<td class="value">${searchResult.needPaymentRequest}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] sentToProduction</td>
    				<td class="value">${searchResult.sentToProduction}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] lastUpdatedDate</td>
    				<td class="value"><fmt:formatDate type="both" value="${searchResult.lastUpdatedDate}" /></td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] needToConfirmCancels</td>
    				<td class="value">${searchResult.needToConfirmCancels}</td>
    			</tr>
    			<tr>
    				<td class="label">[AssetUse] createdGroupId</td>
    				<td class="value">${searchResult.createdGroupId}</td>
    			</tr>
    			<tr>
    				<td class="label">Index Date</td>
    				<td class="value"><fmt:formatDate type="both" value="${searchResult.indexDate}" /></td>
    			</tr>
    		</table>
    	</c:if>
    </c:if>
	<script type="text/javascript">
 
		$('#buildCurrProd').click (function() {
			$("#cwIds").val("${cwId}");
			return true;
		});
		
	</script>
    
</jsp:root>
