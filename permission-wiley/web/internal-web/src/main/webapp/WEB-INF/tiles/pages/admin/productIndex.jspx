<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form">
	
	<jsp:directive.page pageEncoding="UTF-8"/>

	<table class="width100">
		<tr>
			<th colspan="2">Product Index Info</th>
		</tr>
		<tr>
			<td class="label">Exists?</td>
			<td>${info.indexExists ? "yes" : "no"}</td>
		</tr>
		<tr>
			<td class="label">NumDocs</td>
			<td><fmt:formatNumber value="${info.numDocs}" /></td>
		</tr>
		<tr>
			<td class="label">NumDeletedDocs</td>
			<td><fmt:formatNumber value="${info.numDeletedDocs}" /></td>
		</tr>
		<tr>
			<td class="label">Version</td>
			<td>${info.version}</td>
		</tr>
		<tr>
			<td class="label">NumFiles</td>
			<td><fmt:formatNumber value="${info.numFiles}" /></td>
		</tr>
		<tr>
			<td class="label">TotalFileBytes</td>
			<td><fmt:formatNumber value="${info.totalFileBytes}" /></td>
		</tr>
		<tr>
			<td class="label">NumSegments</td>
			<td><fmt:formatNumber value="${info.numSegments}" /></td>
		</tr>
	</table>
	
	<c:if test="${empty indexedInfo}">
		<c:url var="thisUrl" value="/sapp/admin/productIndex/load?extendedInfo=true" />
		<p><a href="${thisUrl}">Extended Info</a></p>
	</c:if>
	
	<c:if test="${not empty indexedInfo}">
		<table>
			<tr>
				<th colspan="3">Indexed Fields - #unique values - [first 3 values]</th>
			</tr>
			<c:forEach items="${indexedInfo}" var="fieldInfo">
				<tr>
					<td>${fieldInfo.name}</td>
					<td><fmt:formatNumber value="${fieldInfo.count}" /></td>
					<td><c:out value="${fieldInfo.valuesString}" /></td>
				</tr>
			</c:forEach>
		</table>
	</c:if>
	
	<c:if test="${not empty storedInfo}">
		<table>
			<tr>
				<th colspan="2">Stored Fields - #occurrences (may occur more than once in a document)</th>
			</tr>
			<c:forEach items="${storedInfo}" var="fieldInfo">
				<tr>
					<td>${fieldInfo.name}</td>
					<td><fmt:formatNumber value="${fieldInfo.count}" /></td>
				</tr>
			</c:forEach>
		</table>
	</c:if>

	<c:url var="compareUrl" value="/sapp/admin/productIndex/compare"/>
	<c:url var="fixUrl" value="/sapp/admin/productIndex/fix"/>
	<c:url var="updateComputedFieldsUrl" value="/sapp/admin/productIndex/updateComputedFields"/>
	<c:url var="checkPreAndInProductionUrl" value="/sapp/admin/productIndex/checkPreAndInProduction"/>
	<c:url var="updateProductIndexForCWIds" value="/sapp/admin/productIndex/updateProductIndexForCWIds"/>
	
	<jsp:directive.include file="/WEB-INF/tiles/pages/include/generalMessage.jspx" />
    
    <div style="margin-top: 1em">
		<form method="post" action="${updateProductIndexForCWIds}">
			CW ID(s) <input type="text" name="cwIDs" id="cwIDs" size="35" />
    		<input type="submit" value="Build Index (for all ISBNs within the Common Work)" />
    		(you can enter CW IDs separated by comma)
    	</form>
    </div>
    
    <div style="margin-top: 1em">
		<form method="post" action="${updateComputedFieldsUrl}">
    		<input type="submit" value="Update Computed Fields (complianceStatus, cwPrimary, counts) (see log for output)" />
    		<input type="text" name="wid" size="30"/> (enter wid or blank = all)
    	</form>
    </div>
    
    <div style="margin-top: 1em">
		<form method="post" action="${compareUrl}">
    		<input type="submit" value="Compare DB to Index (see log for output)" />
    	</form>
    </div>
    
    <div style="margin-top: 1em">
		<form method="post" action="${fixUrl}">
    		<input type="submit" value="Fix (see log for output)" />
    	</form>
    </div>

    <div style="margin-top: 1em">
		<form method="post" action="${checkPreAndInProductionUrl}">
    		<input type="submit" value="Check that all Pre/In-Production products in index are in db (see log for output)" />
    	</form>
    </div>
    
    <form method="get">
    	<table style="margin-top: 2em">
    		<tr>
    			<th>Search index by wid (external_id) or ISBN</th>
    		</tr>
    		<tr>
    			<td>
    				<input type="text" name="widOrIsbn" size="40" />
    				<input type="submit" value="Search" />
    			</td>
    		</tr>
    	</table>
    </form>
    
    <c:if test="${not empty searchWidOrIsbn}">
    	<c:if test="${searchResult == null}">
    		<p class="message">${searchWidOrIsbn} not found in index.</p>
    	</c:if>
    	<c:if test="${searchResult != null}">
    		<table>
    			<tr>
    				<th colspan="2">Result for ${searchWidOrIsbn}:</th>
    			</tr>
    			<tr>
    				<td class="label">wid / external_id</td>
    				<td class="value">${searchResult.wid}</td>
    			</tr>
    			<tr>
    				<td class="label">CW.code</td>
    				<td class="value">${searchResult.commonWorkCode}</td>
    			</tr>
    			<tr>
    				<td class="label">Title</td>
    				<td class="value">${searchResult.title}</td>
    			</tr>
    			<tr>
    				<td class="label">Author(s)</td>
    				<td class="value">${searchResult.authorsAsString}</td>
    			</tr>
    			<tr>
    				<td class="label">Short Author Name</td>
    				<td class="value">${searchResult.shortAuthorName}</td>
    			</tr>
    			<tr>
    				<td class="label">PreviousEditionWID</td>
    				<td class="value">${searchResult.previousEditionWID}</td>
    			</tr>
    			<tr>
    				<td class="label">NextEditionWID</td>
    				<td class="value">${searchResult.nextEditionWID}</td>
    			</tr>
    			<tr>
    				<td class="label">DataSource</td>
    				<td class="value">${searchResult.dataSource}</td>
    			</tr>
    			<tr>
    				<td class="label">pnumber</td>
    				<td class="value">${searchResult.pnumber}</td>
    			</tr>
    			<tr>
    				<td class="label">ISBN13</td>
    				<td class="value">${searchResult.isbn13}</td>
    			</tr>
    			<tr>
    				<td class="label">ISBN10</td>
    				<td class="value">${searchResult.isbn10}</td>
    			</tr>
    			<tr>
    				<td class="label">Status</td>
    				<td class="value">${searchResult.status}</td>
    			</tr>
    			<tr>
    				<td class="label">BusinessUnit (code / name)</td>
    				<td class="value">${searchResult.businessUnitCode} / ${searchResult.businessUnitName}</td>
    			</tr>
    			<tr>
    				<td class="label">Copyright Year</td>
    				<td class="value">${searchResult.copyrightYear} @</td>
    			</tr>
    			<tr>
    				<td class="label">Edition Number</td>
    				<td class="value">${searchResult.editionNumber} *</td>
    			</tr>
    			<tr>
    				<td class="label">Medium (code)</td>
    				<td class="value">${searchResult.mediumCode} *</td>
    			</tr>
    			<tr>
    				<td class="label">Product Line (code)</td>
    				<td class="value">${searchResult.productLineCode} @</td>
    			</tr>
    			<tr>
    				<td class="label">Compliance Status</td>
    				<td class="value">${searchResult.complianceStatus} @</td>
    			</tr>
    			<tr>
    				<td class="label">Index Date</td>
    				<td class="value"><fmt:formatDate type="both" value="${searchResult.indexDate}" /></td>
    			</tr>
    			<tr>
    				<td class="label">Index Version</td>
    				<td class="value">${searchResult.indexVersion}</td>
    			</tr>
    			<tr>
    				<td class="label">CwId</td>
    				<td class="value">${searchResult.cwId} @</td>
    			</tr>
    			<tr>
    				<td colspan="2">* = (currently missing from index since not part of Product Notification message)</td>
    			</tr>
    			<tr>
    				<td colspan="2">@ = (only present in the index where we imported the product)</td>
    			</tr>
    		</table>
    	</c:if>
    </c:if>

</jsp:root>
