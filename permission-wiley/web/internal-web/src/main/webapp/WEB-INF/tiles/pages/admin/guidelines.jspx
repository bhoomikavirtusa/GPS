<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:spring="http://www.springframework.org/tags">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>

	<c:url var="addUrl" value="/sapp/admin/guidelines/add" />
	<c:url var="listUrl" value="/sapp/admin/guidelines/list" />
	<c:url var="saveUrl" value="/sapp/admin/guidelines/save" />
	<c:url var="downloadUrl" value="/sapp/admin/guidelines/download" />
	<c:url var="sortUrl" value="/sapp/admin/guidelines/sort" />
	<c:url var="deleteUrl" value="/sapp/admin/guidelines/delete" />

	<c:url var="downIconUrl" value="/images/buttons/down_arrow.png" />
	<c:url var="upIconUrl" value="/images/buttons/up_arrow.png" />
	<c:url var="deleteIconUrl" value="/images/buttons/delete-icon.png" />
	
	<script type="text/javascript">
	//<![CDATA[

	$(document).ready(function() {	
	    $('#guidelineFileForm').submit(function () {
	    	return ($("#guidelineFileForm").validate().form());
	    });
	});
	
	//Start -- Added for implementing Build DM-364
	function fnDeleteFile(id) {
		var deleteURL = "${deleteUrl}?fileId="+id;
		var r = confirm("Are you sure you want to delete this file?");
		if (r == true) {
			document.location.href = deleteURL;
		} else {
		    return false;
		}
	}	
	//End -- Added for implementing Build DM-364
	//]]>		
	</script>
	    	
	<c:if test="${empty guidelineFile}">
		<table class="width100">
			<tr>
				<th>
					Manage Guidelines
					<span class="right top11">
						<a href="${addUrl}" class="button">Add file</a>
					</span>
				</th>
			</tr>		
		<c:if test="${empty guidelines}">
			<tr>
				<td>No files are defined</td>
			</tr>
			</c:if>
			<c:if test="${not empty guidelines}">
			<tr>
				<td>
					<table class="width100 display">
					<tr>
						<th>Delete</th>
						<th>Display name</th>
						<th>File name</th>
						<th colspan="2">Sort</th>
					</tr>
					<c:forEach items="${guidelines}" var="field" varStatus = "status">
						<tr>
							<td>
								<a href="#" onClick="fnDeleteFile(${field.id})"><img src="${deleteIconUrl}" /></a>
							</td>
							<td>
								<c:out value="${field.displayName}" />
							</td>
							<td>
								<a href="${downloadUrl}?fileId=${field.id}"><c:out value="${field.fileName}" /></a>
							</td>			
							<td>
								<c:if test="${not status.first}"> 
									<a href="${sortUrl}?fileId=${field.id}&amp;order=-1"> <img src="${upIconUrl}" /> </a>
								</c:if>
							</td>
							<td>
								<c:if test="${not status.last}">
							 		<a href="${sortUrl}?fileId=${field.id}&amp;order=1"> <img src="${downIconUrl}" /> </a>
							 	</c:if>
							 </td>
						</tr>
					</c:forEach>
					</table>
				</td>
			</tr>
			</c:if>
		</table>
	</c:if>
	<c:if test="${not empty guidelineFile}">
	<h3>Add Guidelines</h3>
	<div class="requiredtxt">* indicates required field</div>
	<form:form modelAttribute="guidelineFileForm" method="post"  action="${saveUrl}" enctype="multipart/form-data">
	<spring:hasBindErrors name="guidelineFileForm">
		<jsp:directive.include file="/WEB-INF/tiles/pages/include/formErrors.jspx" />
	</spring:hasBindErrors>	
	<table class="width100">
		<tr>
			<td>Name*:</td>			
			<td><input type="text" id="displayName" name="displayName" class="required"/></td>			
		</tr>
		<tr>
			<td>File name*:</td>			
			<td><input type="file" id="file" name="file" class="required"/></td>			
		</tr>
	</table>
	<div class="buttonset">			
		<input type="submit" value="Save"/> 
		<a href="${listUrl}" id="cancel" class="button">Cancel</a>
	</div>
	</form:form>
	</c:if>
</jsp:root>
