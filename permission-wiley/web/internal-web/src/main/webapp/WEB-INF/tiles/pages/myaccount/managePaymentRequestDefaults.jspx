<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
>

	<jsp:directive.page pageEncoding="UTF-8"/>

	<c:set var="user" value="${myAccountForm.user}"/>
	<c:set var="userDefaults" value="${myAccountForm.user.userDefaults}"/>

		<form:form modelAttribute="myAccountForm">
			<jsp:attribute name="action">
				<c:url value="/sapp/myaccount/submit"/>
			</jsp:attribute>

			<div style="display: none">
				<input type="hidden" name="page" value="3"/>
				<form:hidden path="mode"/>
			</div>

			<table class="width100">
				<tr>
					<th>Payment Request Defaults</th>
					<th></th>
				</tr>

				<spring:nestedPath path="user.userDefaults">
						<tr>
							<td>
								<form:label path="costCenter" cssClass="required" cssErrorClass="error">Cost Center:</form:label>
							</td>
							<td>
								<form:input path="costCenter"/>
							</td>
						</tr>
						<tr>
							<td>
								<form:label path="account" cssClass="required" cssErrorClass="error">Account Number and Sub Code:</form:label>
							</td>
							<td>
								<spring:bind path="account">
									<select name="${status.expression}">
										<option value=""></option>
										<c:forEach items="${accounts}" var="account">
											<c:choose>
												<c:when test="${account.id == userDefaults.account.id}">
													<option value="${account.id}" selected="selected">
														${account.accountNumber} - ${account.subCode} (${account.description})
													</option>
												</c:when>
												<c:otherwise>
													<option value="${account.id}">
														${account.accountNumber} - ${account.subCode} (${account.description})
													</option>
												</c:otherwise>
											</c:choose>
										</c:forEach>
									</select>
								</spring:bind>
							</td>
						</tr>
				</spring:nestedPath>
			</table>
					
			<div class="buttonset">
				<jsp:element name="input">
					<jsp:attribute name="type">submit</jsp:attribute>
					<jsp:attribute name="value">Save</jsp:attribute>
					<jsp:attribute name="onclick">this.form.elements['mode'].value='MODIFY';</jsp:attribute>
				</jsp:element> 										
				<c:url var="userAccountUrl" value="/sapp/myaccount/form" />
				<a href="${userAccountUrl}" id="cancel" class="button">Cancel</a>				
			</div>
		</form:form>
</jsp:root>
