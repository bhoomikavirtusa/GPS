<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
>
    <jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
    
    <script type="text/javascript">
	//<![CDATA[	
	var last = null;
	
	function onChangeEvent () {
		var form = document.getElementById("ManageComplianceEmailsForm");
		var selection = document.getElementById("bu");
		var currentValue = selection[selection.selectedIndex].value;
		$("#selectedCode").val(currentValue);

		form.submit();
	
		return false;
	}

	function addRole () {
		var selection = document.getElementById("roles");
		var currentValue = $("#warnRoles").val();
		if (currentValue == "none") {
			currentValue = "";
		}
		if (selection[selection.selectedIndex].value == "none") {
			currentValue = "";
		} 
		var separator = ", ";
		if (currentValue == 'undefined' || currentValue.length == 0) {
			separator = "";
		}

		currentValue = currentValue + separator + selection[selection.selectedIndex].value;

		$("#warnRoles").val(currentValue);
	}

	function addRoleCovers() { 
		var selection = document.getElementById("rolesCovers");
		var currentValue = $("#warnRolesCovers").val();
		if (currentValue == "none") {
			currentValue = "";
		}
		if (selection[selection.selectedIndex].value == "none") {
			currentValue = "";
		} 
		var separator = ", ";
		if (currentValue == 'undefined' || currentValue.length == 0) {
			separator = "";
		}
		
		currentValue = currentValue + separator + selection[selection.selectedIndex].value;
		  
		$("#warnRolesCovers").val(currentValue);
	}
	
   	//]]>
	</script>

    <c:url var="doneUrl" value="/sapp/cwlanding/main" />
    
    <c:url var="editImageURL" value="/images/buttons/new-icon.png" />
    
  <form:form modelAttribute="ManageComplianceEmailsForm">
    <form:hidden path="selectedCode" />
	<table class="width100">
			<tr>
				<th colspan="3">Manage Out of Compliance Emails by Business Unit</th>
			</tr>			
			<tr>
				<td> Business Unit:</td>
				<td>
					<select id="bu" size="5" onchange="javascript: onChangeEvent();">
						<c:forEach items="${ManageComplianceEmailsForm.businessUnits}" var="bu">
							<option value="${bu.code}"><c:out value="${bu.name}" /></option>
						</c:forEach>
					</select>
					
					<h1>Currently Selected:
					<c:out value="${ManageComplianceEmailsForm.currentBusinessUnit.code}" /> - 
					<c:out value="${ManageComplianceEmailsForm.currentBusinessUnit.name}" /></h1>
				</td>
				<td>
					
				</td>
			</tr>		
			<tr><td><h1>NON COVERS</h1><td><td>click to add new value to the left</td></td></td></tr>
			<tr>
				<td>Warn people with following roles (NON COVERS):</td>
				<td>
					<form:input path="currentBusinessUnit.warnRoles" id="warnRoles" size="100"/>
				</td>
				
				<td>
					<img src="${editImageURL}" />
					<select id="roles" size="1" onchange="javascript: addRole();">
						<c:forEach items="${ManageComplianceEmailsForm.roles}" var="role">
							<option value="${role.code}"><c:out value="${role.code} - ${role.description}" /></option>
						</c:forEach>
					</select>
				</td>
				
			</tr>		

			<tr>
				<td>Warn following Email Addresses (NON COVERS):</td>
				<td>
					<form:input path="currentBusinessUnit.email" size="100"/>
				</td>
				<td>
				</td>
			</tr>		
			<tr>
				<td>Warn last updating user (NON COVERS):</td>
				<td>
					<form:checkbox path="currentBusinessUnit.warnLastUpdateUser"/> 
				</td>
				<td>
				</td>
			</tr>		
			
			<tr><td> <td><td></td></td></td></tr>
			
			<tr><td><h1>COVERS</h1><td><td>click to add new value to the left</td></td></td></tr>
			<tr>
				<td>Warn people with following roles (COVERS):</td>
				<td>
					<form:input path="currentBusinessUnit.warnRolesCovers" id="warnRolesCovers" size="100"/>
				</td>
				
				<td>
					<img src="${editImageURL}" />
					<select id="rolesCovers" size="1" onchange="javascript: addRoleCovers(); ">
						<c:forEach items="${ManageComplianceEmailsForm.roles}" var="rolec">
							<option value="${rolec.code}"><c:out value="${rolec.code} - ${rolec.description}" /></option> 
						</c:forEach> 
					</select>
				</td>
			</tr>		

			<tr>
				<td>Warn following Email Addresses (COVERS):</td>
				<td>
					<form:input path="currentBusinessUnit.emailCovers" size="100"/>
				</td>
				<td>
				</td>
			</tr>		
			<tr>
				<td>Warn last updating user (COVERS):</td>
				<td>
					<form:checkbox path="currentBusinessUnit.warnLastUpdateUserCovers"/> 
				</td>
				<td>
				</td>
			</tr>		
			
	</table>

	<div class="buttonset">		
		<input type="submit" value="save" />	
	</div>

</form:form>

<c:url var="cronUrl" value="/sapp/admin/manageComplianceEmails/cron" />
<div>
<a href="${cronUrl}">Test Cron method</a> (nothing will be shown on screen, may trigger emails)
</div>

</jsp:root>
