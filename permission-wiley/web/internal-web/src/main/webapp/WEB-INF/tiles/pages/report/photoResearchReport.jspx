<?xml version="1.0" encoding="UTF-8" ?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<c:url var="nextUrl" value="/sapp/commonwork/report/submitPhotoResearch.pdf" />
	
	<jsp:directive.page pageEncoding="UTF-8" />

	<fmt:setBundle basename="messages" />

	<jsp:body>
		<h3>Assets to Production Criteria</h3>
		<form method="post" id="photoResearchForm">
			<table class="width100">
				<tr>
					<td>
						Date to production for assets in these components	
						<input type="text" id="d_dateToProd" name="d_dateToProd" size="10" maxlength="10" class="datepicker required"/>(${dateFormat})
						<input type="hidden" id="dateToProd" name="dateToProd"  class="datepicker required" />
					</td>
				</tr>
				
				<c:if test="${not empty userGroupList}">
					<tr>
						<th>
							All User Groups 
						</th>
					</tr>
					<tr>
						<td> 
							<select name="userGroupId" id="userGroupId">
								<option value="0" >All User Groups</option>
								<c:forEach items="${userGroupList}" var="userGroup">
									<option value="${userGroup.id}" >${userGroup.name}</option>
								</c:forEach>
							</select>
						</td>
					</tr>
				</c:if>
				
				<c:if test="${not empty componentList}">
					<tr>
						<th>
							All <input type="checkbox" id="check_all" onclick="checkAll(this)" />
						</th>
					</tr>				
					<c:forEach items="${componentList}" var="component">
					<tr>
						<td>
							<input type="checkbox" name="componentId" id="componentId" value="${component.id}" class="required"/><c:out value="${component.name}" />
						</td>
					</tr>
					</c:forEach>
					<tbody style="display:none;">
					<tr>
						<td>
							<input type="checkbox" name="componentId" id="componentId" value="0" class="required"/>No Component
						</td>
					</tr>
					</tbody>
				</c:if>
				
				<c:if test="${empty componentList}">
					<tr>
						<td>
							No components available
						</td>
					</tr>
				</c:if>
			</table>
		</form>		
		<div class="buttonset">					
			<input type="submit" id="generateB" value="Generate-Spreadsheet" />
			<a href="#" id="cancelLink" class="button">Cancel</a> 	 															
		</div>
	</jsp:body>
	
	
	<script type="text/javascript">
	//<![CDATA[

	function checkAll(master) {
		$("input[id='componentId']").attr('checked', master.checked);
	}

	$(document).ready(function() {

		$.datepicker.setDefaults({
		     dateFormat: '${dateFormat}'
		});
		
        $("#dateToProd").datepicker();
        $("#d_dateToProd").datepicker();
    	var d1 = $.datepicker.parseDate('mm/dd/yy', $("#dateToProd").val());
		var d2 = $.datepicker.formatDate('${dateFormat}', d1);
    	$("#d_dateToProd").val(d2);

    	$("#d_dateToProd").change(function() {
			var d1 = $.datepicker.parseDate('${dateFormat}', $("#d_dateToProd").val());
			var d2 = $.datepicker.formatDate('mm/dd/yy', d1);
    		$("#dateToProd").val(d2);
		});
        
        
		$('#generateB').click (function() {
			if ($("#photoResearchForm").validate().form() == true) {
				$.ajax({
		            async: true,
		            type: 'get',
		            url: '${nextUrl}',
		            data: $('#photoResearchForm').serialize(),
		            success: function (response){
		            	window.open(response);
		            	// $('#modalDiv').empty().html(response);
		            	// repositionDialog();
		            	$modalDialog.dialog("close");
		            }
		        });
			}
		});
	});
	//]]>
	</script>
	
</jsp:root>
