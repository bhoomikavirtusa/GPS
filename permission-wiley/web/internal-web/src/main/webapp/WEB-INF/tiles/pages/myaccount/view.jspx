<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
>
	<jsp:directive.page pageEncoding="UTF-8"/>

	<c:set var="user" value="${myAccountForm.user}"/>
	<c:set var="userDefaults" value="${myAccountForm.user.userDefaults}"/>
	
	<c:url var="projectUrl" value="/sapp/cwlanding/scroll?cwId=${sessionCwId}" />
	<c:url var="actionUrl" value="/sapp/myaccount/form" />
	
	<form:form modelAttribute="myAccountForm" action="${actionUrl}" method="get">
		<form:hidden path="mode" />
		<input type="hidden" name="page" value="0" />

		<table class="width100">
			<tr>
				<th>
					My Preferences
					<jsp:element name="input">
						<jsp:attribute name="type">image</jsp:attribute>
						<jsp:attribute name="src">
							<c:url value="/images/buttons/edit-icon.png" />
						</jsp:attribute>
						<jsp:attribute name="onclick">this.form['page'].value = 5;</jsp:attribute>
					</jsp:element>						
				</th>
				<th style="text-align: right">
					<c:if test="${not empty sessionCwId}">
						<a href="${projectUrl}" class="button">Return to product</a>
					</c:if>
				</th>
			</tr>

			<tr>
				<td>First Name:</td>
				<td>${user.firstName}</td>
			</tr>

			<tr>
				<td>Last Name:</td>
				<td>${user.lastName}</td>
			</tr>

			<tr>
				<td>E-mail:</td>
				<td>${user.email}</td>
			</tr>

			<tr>
				<td>Enable asset request:</td>
				<td>
					${wileyfn:formatBoolean (userDefaults.showRequest)}
				</td>
			</tr>
			<tr>
				<td>Enable quick asset creation: </td>
				<td>
					${wileyfn:formatBoolean (userDefaults.customMode)}
				</td>
			</tr>
			<!-- 
			<tr>
				<td>Enable filter:</td>
				<td>
					${userDefaults.customFilterDescription}
				</td>
			</tr>
			 -->
			<tr>
				<td>Default Wiley entity: </td>
				<td>
					${userDefaults.wileyEntity != null ? userDefaults.wileyEntity.description : "&amp;nbsp;"}
				</td>
			</tr>	
			<tr>
				<td>Default currency:</td>
				<td>
					${userDefaults.currency.code}
				</td>
			</tr>
			<tr>
				<td>Default country:</td>
				<td>
					${userDefaults.country.description}
				</td>
			</tr>
			<tr>
				<td>Location:</td>
				<td>
					${userDefaults.userLocation != null ? userDefaults.userLocation.name : "&amp;nbsp;"}
				</td>
			</tr>
			<tr>
				<td>Division:</td>
				<td>
					${userDefaults.businessUnit != null ? userDefaults.businessUnit.name : "&amp;nbsp;"}
				</td>
			</tr>
			<tr>
				<td>User Group:</td>
				<td>
					${user.group != null ? user.group.name : "none"}
				</td>
			</tr>
			<tr>
				<td>Size:</td>
				<td>
					${userDefaults.size.description}
				</td>
			</tr>
				<tr>
				<td>Date Format:</td>
				<td>
					${userDefaults.dateFormat}
				</td>
			</tr>
			<tr>
				<th>
					Landing Layout
					<c:url var="userProfileUrl" value="/sapp/cwlanding/user/profile" />
					<c:url var="editIconUrl" value="/images/buttons/edit-icon.png" />
					<a href="${userProfileUrl}"><img src="${editIconUrl}" alt="Edit" title="Edit"/></a>
				</th>
				<th></th>					
			</tr>
			<tr>
				<th>
					My Sources / Favorite Source Group
					<jsp:element name="input">
						<jsp:attribute name="type">image</jsp:attribute>
						<jsp:attribute name="title">Edit</jsp:attribute>
						<jsp:attribute name="src">
							<c:url value="/images/buttons/edit-icon.png" />
						</jsp:attribute>
						<jsp:attribute name="onclick">this.form['page'].value = 6;</jsp:attribute>
					</jsp:element>
				</th>
				<th>
				</th>						
			</tr>
				
			<c:if test="${not empty user.sources}">
				<c:forEach items="${user.sources}" var="node">
					<tr>
						<td>${node.name}</td>
					</tr>
				</c:forEach>
			</c:if>

			<c:if test="${empty user.sources}">
				<tr><td colspan="2">(none specified)</td></tr>
			</c:if>
			<tr>
				<th>
					Purchase Order Defaults
					<jsp:element name="input">
						<jsp:attribute name="type">image</jsp:attribute>
						<jsp:attribute name="title">Edit</jsp:attribute>
						<jsp:attribute name="src">
							<c:url value="/images/buttons/edit-icon.png" />
						</jsp:attribute>
						<jsp:attribute name="onclick">this.form['page'].value = 2;</jsp:attribute>
					</jsp:element>
				</th>
				<th></th>					
			</tr>

			<tr>
				<td>Display estimated cost:</td>
				<td>
					${wileyfn:formatBoolean (userDefaults.showEstimatedCost)}
				</td>
			</tr>

			<tr>
				<td>User Signature:</td>
				<td>
					${userDefaults.userSignature == null ? "(not specified)" : wileyfn:escapeHtmlAndNewline(userDefaults.userSignature)}
				</td>
			</tr>

			<tr>
				<td>Return Address:</td>
				<td>
					${userDefaults.returnAddress == null ? "(not specified)" : wileyfn:escapeHtmlAndNewline(userDefaults.returnAddress)}
				</td>
			</tr>

			<tr>
				<th>
					Payment Request Defaults
					<jsp:element name="input">
						<jsp:attribute name="type">image</jsp:attribute>
						<jsp:attribute name="title">Edit</jsp:attribute>
						<jsp:attribute name="src">
							<c:url value="/images/buttons/edit-icon.png" />
						</jsp:attribute>
						<jsp:attribute name="onclick">this.form['page'].value = 3;</jsp:attribute>
					</jsp:element>
				</th>
				<th style="text-align: right">
					<c:if test="${not empty sessionCwId}">
						<a href="${projectUrl}" class="button">Return to product</a>
					</c:if>
				</th>
			</tr>

			<tr>
				<td>Cost Center:</td>
				<td>
					${userDefaults.costCenter != null ? userDefaults.costCenter : "&amp;nbsp;"}
				</td>
			</tr>

			<tr>
				<td>Account Number and Sub Code:</td>
				<td>
					<c:choose>
						<c:when test="${userDefaults.account == null}">&amp;nbsp;</c:when>
						
						<c:otherwise>
						${userDefaults.account.accountNumberSubCodeDescription}
						</c:otherwise>
					</c:choose>
				</td>
			</tr>

            <!-- Fully functional but we don't use the data at all right now on the landing page -->
            <!--
			<tr>
				<th>
					Product Landing Defaults
					<jsp:element name="input">
						<jsp:attribute name="type">image</jsp:attribute>
						<jsp:attribute name="title">Edit</jsp:attribute>
						<jsp:attribute name="src">
							<c:url value="/images/buttons/edit-icon.png" />
						</jsp:attribute>
						<jsp:attribute name="onclick">this.form['page'].value = 4;</jsp:attribute>
					</jsp:element>
				</th>
				<th>
				</th>					
			</tr>
			<tr>
				<td>
					Component Category:
				</td>

				<td>
					<c:if test="${userDefaults.componentCategory != null}">
						${userDefaults.componentCategory.description}
					</c:if>

					<c:if test="${userDefaults.componentCategory == null}">&amp;nbsp;</c:if>
				</td>
			</tr>
			-->
		</table>
	</form:form>
	
</jsp:root>
