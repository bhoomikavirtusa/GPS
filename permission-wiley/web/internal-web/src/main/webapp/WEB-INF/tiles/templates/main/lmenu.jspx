	<jsp:body>
	<jsp:scriptlet>
	String driverName = "com.mysql.jdbc.Driver";
	String connectionUrl = "jdbc:mysql://AUS-LNDBGPSP-01.wiley.com:3322/";
	String dbName = "perm";
	String userId = "permuser";
	String password = "permuser";
	String lastdate=null;
	try {
	Class.forName(driverName);
	} catch (ClassNotFoundException e) {
	e.printStackTrace();
	}

	Connection connection = null;
	Statement statement = null;
	ResultSet resultSet = null;
	try{ 
	connection = DriverManager.getConnection(connectionUrl+dbName, userId, password);
	statement=connection.createStatement();
	String sql ="select max(last_updated_date) as lastdate from perm.source";

	resultSet = statement.executeQuery(sql);
	while(resultSet.next()){
		DateFormat dateFormat = new SimpleDateFormat("MM-dd-yyyy");
		lastdate=dateFormat.format(resultSet.getDate("lastdate"));
		}
	} catch (Exception e) {
	e.printStackTrace();
	}
	finally{
		resultSet.close();
		connection.close();
	}
	</jsp:scriptlet>
	
