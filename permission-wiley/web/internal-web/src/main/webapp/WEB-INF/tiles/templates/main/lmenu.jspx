<script type="text/javascript">
//<![CDATA[
	
	function openCWConditionViewEditDialog (bContinue) {
		$("#modalDiv").load('${cwConditionViewEditUrl}', function() {
			openModalDialog ('View/Edit Minimum Permissions Requirements');
			if (bContinue) {
				$modalDialog.dialog({
					close: function(event, ui) {
						openCreateComponentDialog ();
					}
				});
			}
        });
	}

	function openCreateComponentDialog() {
		$("#modalDiv").load('${createComponentUrl}', function() {
			openModalDialog ('Create components');
			// reset the close
			$modalDialog.dialog({
				close: function(event, ui) {}
			});										
        });
	}
	
	function openComponentDialog() {
		$("#modalDiv").load('${componentUrl}', function() {
			openModalDialog ('Create/Edit components');
        });
	}
	
	function fnDisplaycount() {
		$.ajax({
	        async: true,
	        type: 'get',
	        dataType: "text",
	        url: '${displayCount}',
	        success: function (response){
	        	alert(response);
	        }
	    });
		//alert("0 out of 10 done");
	}
	
	function confirmExport() {
		 $.ajax({
			 async: false,
			 type: 'post',
			 url: '${exportAssetPreUrl}',
			 success: function (response) {
				 if (response == "msg1"){
					 var r = confirm("Please note that users will not be able to make any changes to this product until the export process has completed.\n Do you want to continue with the export?");
					 if (r == true) {
						 fnStartExportProcess(cwId);
						 return false;
						} else {
							 //$('a#exportAssetsLink').show();
							 //$('#exportInProgress').hide();
					 return false; 
				 }
			 }
				 else{
					 alert(response);
					 return;
				 }
			 }
		 })
	}
	
	function fnStartExportProcess() {
		$.ajax({
	        async: true,
	        type: 'get',
	        url: '${exportToExcelUrl}',
	        success: function (response){
	        	window.open(response);
	        	 setTimeout(
							function(){ 
							window.location.href="${landingMainUrl}";
					}, 2000);
	        	 $modalDialog.dialog("close");
	        }
	    });
		
	}

	$(document).ready(function() {		
		$("div.MenuBar").dmDropDownMenu();	

		$('#renumberLink').click(function() {
			$("#modalDiv").load('${renumUrl}', function() {
				openModalDialog ('Renumber Assets');
	        });
			// prevent the default action, e.g., following a link
			return false;
		});

		$('#chapterMergeLink').click(function() {
			$("#modalDiv").load('${chapterMergeUrl}', function() {
				openModalDialog ('Merge Chapters/components');
	        });
			// prevent the default action, e.g., following a link
			return false;
		});

		$('#chapterInsertLink').click(function() {
