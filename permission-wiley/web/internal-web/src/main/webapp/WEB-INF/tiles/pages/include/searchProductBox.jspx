<?xml version="1.0" encoding="UTF-8" ?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:security="http://www.springframework.org/security/tags"
	xmlns:form="http://www.springframework.org/tags/form">

	<jsp:directive.page pageEncoding="UTF-8" />

	<jsp:element name="script">
		<jsp:attribute name="type">text/javascript</jsp:attribute>
		<jsp:attribute name="src">
			<c:url value="/js/jquery.blockUI-2.38.js"/>
		</jsp:attribute>
		// Placeholder
	</jsp:element>
	
	<script type="text/javascript">
	//<![CDATA[
		$(document).ajaxStop($.unblockUI); 
		
		function search() {
			$.blockUI();
			return true; 
		}
	//]]>
	</script>
	<fmt:setBundle basename="messages" />
	<security:authorize access="hasAnyAuthority('EMPLOYEE_DEFAULT')">
    <c:url value="/sapp/product/product/search" var="action" />
     <c:url value="/sapp/product/product/advancedsearch" var="advanceSearchUrl" />
     </security:authorize>
	<form method="post" action="${action}" id="searchForm" onSubmit="search();">
		<!--<security:authorize access="hasAnyAuthority('EMPLOYEE_DEFAULT')">-->
		<div style="display: none">
			<input type="hidden" name="mode" value="SEARCH"/>
		</div>
		<!--</security:authorize>-->
	<security:authorize access="hasAnyAuthority('EMPLOYEE_DEFAULT')">
	<span id="search-container">
		
		<input type="text" name="searchString" value="${userSession.productSearchString}" size="30" />
		<input type="hidden" name="target" value="landingViewName" />
		
        	<!-- Strings such as "Author" may need to be internationalized later. -->
        	<!-- Maybe do this a better way - instead of hard coding options. -->
  
        	<select name="searchField">
        		<c:choose>
                	<c:when test="${userSession.productSearchField == 'isbn'}">
                    	<option value="isbn" selected="selected">ISBN</option>
                	</c:when>
                	<c:otherwise>
                    	<option value="isbn">ISBN</option>
                	</c:otherwise>
            	</c:choose>
            	
      	         <!--  
            	<c:choose>
                	<c:when test="${userSession.productSearchField == 'author'}">
                    	<option value="author" selected="selected">Author</option>
               		</c:when>
                	<c:otherwise>
                    	<option value="author">Author</option>
                	</c:otherwise>
            	</c:choose>
                
            	<c:choose>
                	<c:when test="${userSession.productSearchField == 'title'}">
                    	<option value="title" selected="selected">Title</option>
                	</c:when>
                	<c:otherwise>
                    	<option value="title">Title</option>
                	</c:otherwise>
            	</c:choose>
            	  -->
            		
        	</select>
        	
			<input value="Search Products" type="submit"/>
			<a href="${advanceSearchUrl}">Advanced Search</a>
				
		</span>
		</security:authorize>	
	</form>
</jsp:root>
