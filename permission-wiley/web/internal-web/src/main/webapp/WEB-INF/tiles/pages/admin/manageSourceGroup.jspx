<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:security="http://www.springframework.org/security/tags"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">

	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>

	<c:set var="group" value="${manageSourceGroupForm.group}"/>

	<script type="text/javascript">
		$(document).ready(function() {
			$('#royaltyFreeDealsTable').dataTable( {
				"aoColumns": [
					{ "sWidth" : "10%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Edit
					{ "sWidth" : "10%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Remove
					{ "sWidth" : "60%", "bSearchable" : false }, // Description
					{ "sWidth" : "10%", "bSearchable" : false }, // Seats
					{ "sWidth" : "10%", "bSearchable" : false } // Print Run
				],
				"aaSorting": [[2, "asc" ]],
				"bAutoWidth": false,
				"sDom" : "rt"
			} );
		} );
		
		$(document).ready(function() {
			$('#masterAgreementDealsTable').dataTable( {
				"aoColumns": [
					{ "sWidth" : "5%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Edit
					{ "sWidth" : "5%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Remove
					{ "sWidth" : "20%", "bSearchable" : false }, // Name
					{ "sWidth" : "20%", "bSearchable" : false }, // File
					{ "sWidth" : "10%", "bSearchable" : false }, // Start Date
					{ "sWidth" : "10%", "bSearchable" : false }, // End Date
					{ "sWidth" : "20%", "bSearchable" : false }, // Locations
					{ "sWidth" : "10%", "bSearchable" : false } // Divisions
				],
				"aaSorting": [[2, "asc" ]],
				"bAutoWidth": false,
				"sDom" : "rt"
			} );
		} );
		
		$(document).ready(function() {
			$('#sourcesTable').dataTable( {
				"aoColumns": [
					{ "sWidth" : "10%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Edit
					{ "sWidth" : "10%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Remove
					{ "sWidth" : "80%", "bSearchable" : false } // Name
				],
				"aaSorting": [[2, "asc" ]],
				"bAutoWidth": false,
				"sDom" : "rt"
			} );
		} );

	</script>
	
	<script type="text/javascript">
		function changeNoFly(value) {
			if (value == true) {
				$("#sourceDiv1").hide();
			}
			if (value == false) {
				$("#sourceDiv1").show();
			}
		}
	</script>

	<c:url var="finishUrl" value="/sapp/admin/manageSourceGroup/finish" />
	<c:url var="processUrl" value="/sapp/admin/manageSourceGroup/process" />

	<form:form modelAttribute="manageSourceGroupForm" action="${finishUrl}">
		<div style="display: none">
			<input type="hidden" name="page" value="0" />
			<input type="hidden" name="targetPage" value="0" />

			<form:hidden path="mode" />
			<form:hidden path="selectedChild" />
			<form:hidden path="selectedDeal" />
		</div>

		<spring:hasBindErrors name="manageSourceGroupForm">
			<jsp:directive.include file="/WEB-INF/tiles/pages/include/formErrors.jspx" />
		</spring:hasBindErrors>
		
		<table class="width100">
			<c:if test="${ErrorMessage != null}">
				<span style="margin-left: 1em; color: red">
					<tr><td>${ErrorMessage}</td></tr>
				</span>
			</c:if>
			<c:choose>
				<c:when test="${manageSourceGroupForm.mode == 'REMOVE'}">
					<tr>
						<th>
							Are you sure you want to remove source group "${group.name}"?
						</th>
					</tr>				
							
					<c:if test="${not empty group.sources}">
						<tr>
							<td> If you continue, source group: "${group.name}" will also be removed for the following sources:</td>
						</tr>
						
						<c:forEach items="${group.sources}" var="sc">
							<tr><td>"<c:out value="${sc.name}" />"</td></tr>
						</c:forEach>
					</c:if>
				</c:when>

				<c:otherwise>
					<spring:nestedPath path="group">
						<tr>
							<th colspan="3">General Information for Source Group</th>
						</tr>

						<tr>
							<td colspan="2">
								<form:label path="name" cssClass="required" cssErrorClass="error">Name: </form:label>
								<c:if test="${group.id == null}">
								     <form:input path="name" class="required" size="50" maxlength="100" />
								</c:if>
								<c:if test="${group.id != null}">
								 	<c:out value="${group.name}" />
								</c:if>								
							</td>
						</tr>
					</spring:nestedPath>			
					
					<tr>
						<td colspan="2">Comment:
							<form:input path="sourceGroupComment" size="50" maxlenghth="100"/>
		
						 	<c:if test="${null != group.id}">
								<security:authorize access="hasAuthority('ADMIN')">
									<jsp:element name="input">
										<jsp:attribute name="type">submit</jsp:attribute>
										<jsp:attribute name="value">Apply To Members</jsp:attribute>
										<jsp:attribute name="onclick">this.form.elements['mode'].value='APPLY_TO_MEMBERS';</jsp:attribute>
									</jsp:element>
								</security:authorize>
							</c:if>
						 </td>
					</tr>
					
					<tr> 
						<td colspan="2">
							<form:radiobutton path="nofly" value="false" onclick="changeNoFly(false)"/>Active 
							<form:radiobutton path="nofly" value="true" onclick="changeNoFly(true)"/>No-Fly
						</td>
					</tr>
						
			<c:if test="${manageSourceGroupForm.nofly == true}">
				<c:set var="hStyle" value="display: none;"/>
			</c:if>	
			<c:if test="${manageSourceGroupForm.nofly != true}">
				<c:set var="hStyle" value=""/>
			</c:if>			
		
			<tbody id="sourceDiv1" style="${hStyle}">
			
					<c:if test="${null != group.id}">
						<tr>
							<th>Royalty Free Deals</th>
							
							<th class="button">
							<security:authorize access="hasAuthority('ADMIN')">
								<jsp:element name="input">
									<jsp:attribute name="type">submit</jsp:attribute>
									<jsp:attribute name="value">Add Deal</jsp:attribute>
									<jsp:attribute name="onclick">
										this.form.elements['mode'].value = 'ADD_ALT_CHILD';
										this.form.action = '${processUrl}';
										this.form.elements['targetPage'].value = 2;
									</jsp:attribute>
								</jsp:element>	
							</security:authorize>	
							</th>
						</tr>
					</c:if>
					<spring:nestedPath path="group">
						<c:if test="${not empty group.royaltyFreeDeals}">
							<tr>
								<td colspan="2">
									<table class="display" id="royaltyFreeDealsTable">
										<thead>
											<tr>
												<th><security:authorize access="hasAuthority('ADMIN')">Edit</security:authorize></th>
												<th><security:authorize access="hasAuthority('ADMIN')">Remove</security:authorize></th>
												<th>Description</th>
												<th>Seats</th>
												<th>Print Run</th>
											</tr>
										</thead>
										<tbody>
											<c:forEach items="${group.royaltyFreeDeals}" var="deal">
												<c:if test="${!deal.disabledFlag}">
													<tr>
														<td>
														<security:authorize access="hasAuthority('ADMIN')">
															<jsp:element name="input">
																<jsp:attribute name="type">image</jsp:attribute>
																<jsp:attribute name="alt">Remove Deal</jsp:attribute>
														
																<jsp:attribute name="onclick">
																	this.form.elements['mode'].value='EDIT_ALT_CHILD';
																	this.form.elements['selectedDeal'].value='${deal.id}';
																	this.form.action = '${processUrl}';
																	this.form.elements['targetPage'].value = 2;
																</jsp:attribute>
														
																<jsp:attribute name="src">
																	<c:url value="/images/buttons/edit-icon.png" />
																</jsp:attribute>
															</jsp:element>	
														</security:authorize>	
														</td>

														<td>
															<c:if test="${not deal.isBeingUsed}">
															<security:authorize access="hasAuthority('ADMIN')">
																<jsp:element name="input">
																	<jsp:attribute name="type">image</jsp:attribute>
																	<jsp:attribute name="alt">Remove Deal</jsp:attribute>
																	<jsp:attribute name="onclick">
																		this.form.elements['mode'].value='REMOVE_ALT_CHILD';
																		this.form.elements['selectedDeal'].value='${deal.id}';
																		this.form.action = '${processUrl}';
																	</jsp:attribute>
																	<jsp:attribute name="src">
																		<c:url value="/images/buttons/delete-icon.png" />
																	</jsp:attribute>
																</jsp:element>
															</security:authorize>
															</c:if>
													
															<c:if test="${deal.isBeingUsed}">
															<security:authorize access="hasAuthority('ADMIN')">
																<jsp:element name="input">
																	<jsp:attribute name="type">image</jsp:attribute>
																	<jsp:attribute name="alt">Disable Deal</jsp:attribute>
																	<jsp:attribute name="onclick">
																		this.form.elements['mode'].value='DISABLE_ALT_CHILD';
																		this.form.elements['selectedDeal'].value='${deal.id}';
																		this.form.action = '${processUrl}';
																	</jsp:attribute>
																	<jsp:attribute name="src">
																		<c:url value="/images/buttons/delete-icon.png" />
																	</jsp:attribute>
																</jsp:element>
															</security:authorize>
															</c:if>
														</td>
														
														<td><c:out value="${deal.description}" /></td>
														<td><c:out value="${deal.seats}" /></td>
														<td><c:out value="${deal.totalPrintRun}" /></td>
													</tr>
												</c:if>
											</c:forEach>
										</tbody>
									</table>
								</td>
							</tr>
						</c:if>
					</spring:nestedPath>
					
					<c:if test="${null != group.id}">
						<tr>
							<th>Master Agreements
								<c:if test="${param.maDealUsedByContract == 'true'}">
									<span class="error" style="margin-left: 2em">Cannot Delete - used by Contract</span>
								</c:if>
							</th>
		
							<th class="button">
							<security:authorize access="hasAuthority('ADMIN')">
								<c:url var="editURL" value="/sapp/admin/sourcegroup/madeal/edit?groupId=${group.id}"/>
								<a href="${editURL}" class="button">Add Agreement</a>
							</security:authorize>
							</th>
						</tr>
						<spring:nestedPath path="group">
						<c:if test="${not empty group.masterAgreementDeals}">
							<tr>
								<td colspan="2">
									<table class="display" id="masterAgreementDealsTable">
										<thead>
											<tr>
												<th><security:authorize access="hasAuthority('ADMIN')">Edit</security:authorize></th>
												<th><security:authorize access="hasAuthority('ADMIN')">Remove</security:authorize></th>
												<th>Name</th>
												<th>File</th>
												<th>Start Date</th>
												<th>End Date</th>
												<th>Locations</th>
												<th>Divisions</th>
											</tr>
										</thead>
										<tbody>
											<c:forEach items="${group.masterAgreementDeals}" var="deal">
												<tr>
													<td>
													<security:authorize access="hasAuthority('ADMIN')">
														<c:url var="editImageURL" value="/images/buttons/edit-icon.png" />
														<c:url var="editURL" value="/sapp/admin/sourcegroup/madeal/edit?dealId=${deal.id}&amp;groupId=${group.id}"/>
														<a href="${editURL}"><img src="${editImageURL}" /></a>
													</security:authorize>
													</td>
											
													<td>
													<security:authorize access="hasAuthority('ADMIN')">
														<c:url var="deleteImageURL" value="/images/buttons/delete-icon.png" />
														<c:url var="deleteURL" value="/sapp/admin/sourcegroup/madeal/delete?dealId=${deal.id}&amp;groupId=${group.id}"/>
														<a href="${deleteURL}"><img src="${deleteImageURL}" /></a>
													</security:authorize>
													</td>
												
													<td><c:out value="${deal.name}" /></td>
													<td>
														<c:url var="downloadURL" value="/sapp/admin/sourcegroup/madeal/download?agreementId=${deal.id}"/>
														<a href="${downloadURL}" title="${deal.name}"> ${deal.fileName}</a> (${wileyfn:filesize(deal.fileData)})
													</td>
													<td><fmt:formatDate type="date" value="${deal.startDate}" /></td>
													<td><fmt:formatDate type="date" value="${deal.endDate}" /></td>
													<td><c:out value="${deal.userLocationsDisplay}" /></td>
													<td><c:out value="${deal.businessUnitsDisplay}" /></td>
												</tr>
											</c:forEach>
										</tbody>
									</table>
								</td>
							</tr>
						</c:if>
						</spring:nestedPath>
					</c:if>
			</tbody>		
 					<c:if test="${null != group.id}">
						<tr>
							<th>Sources</th>
							<th class="button">
							<security:authorize access="hasAuthority('ADMIN')">
								<c:url var="addSRC" value="/sapp/admin/multiSourceSelection/search?sgId=${group.id}"/>
								<a href="${addSRC}" class="button">Add Source(s)</a>
							</security:authorize>
							</th>
						</tr>
					</c:if>

					<spring:nestedPath path="group">
						<c:if test="${not empty group.sources}">
							<tr>
								<td colspan="2">
									<table class="display" id="sourcesTable">
										<thead>
											<tr>
												<th><security:authorize access="hasAuthority('ADMIN')">Edit</security:authorize></th>
												<th><security:authorize access="hasAuthority('ADMIN')">Remove</security:authorize></th>
												<th>Name</th>
											</tr>
										</thead>
										<tbody>
											<c:forEach items="${group.sources}" var="source">
												<tr>
													<td>
													<security:authorize access="hasAuthority('ADMIN')">
														<c:url var="editImageURL" value="/images/buttons/edit-icon.png" />
														<c:url var="editURL" value="/sapp/sources/sources/view?selectedSourceExtId=${source.externalId}&amp;cameFromSourceGroupId=${group.id}"/>
														<a href="${editURL}"><img src="${editImageURL}" /></a>
													</security:authorize>
													</td>
													
													<td>
													<security:authorize access="hasAuthority('ADMIN')">
														<jsp:element name="input">
															<jsp:attribute name="type">image</jsp:attribute>
															<jsp:attribute name="alt">Remove Association</jsp:attribute>
															<jsp:attribute name="onclick">
																this.form.elements['mode'].value='REMOVE_CHILD';
																this.form.elements['selectedChild'].value='${source.id}';
																this.form.action = '${processUrl}';
															</jsp:attribute>
															<jsp:attribute name="src">
																<c:url value="/images/buttons/delete-icon.png" />
															</jsp:attribute>
														</jsp:element>
													</security:authorize>
													</td>

													<td><c:out value="${source.name}" /></td>
												</tr>
											</c:forEach>
										</tbody>
									</table>
								</td>
							</tr>
						</c:if>
					</spring:nestedPath>
				</c:otherwise>
			</c:choose>
		</table>
		<div class="buttonset">
			<c:choose>
				<c:when test="${manageSourceGroupForm.originalMode == 'ADD'}">
				<security:authorize access="hasAuthority('ADMIN')">
					<jsp:element name="input">
						<jsp:attribute name="type">submit</jsp:attribute>
						<jsp:attribute name="value">Add</jsp:attribute>
						<jsp:attribute name="onclick">this.form.elements['mode'].value='ADD';</jsp:attribute>
					</jsp:element>
				</security:authorize>
				</c:when>

				<c:when test="${manageSourceGroupForm.originalMode == 'MODIFY'}">
				<security:authorize access="hasAuthority('ADMIN')">
					<jsp:element name="input">
						<jsp:attribute name="type">submit</jsp:attribute>
						<jsp:attribute name="value">Modify</jsp:attribute>
						<jsp:attribute name="onclick">this.form.elements['mode'].value='MODIFY';</jsp:attribute>
					</jsp:element>
				</security:authorize>	
				</c:when>

				<c:when test="${manageSourceGroupForm.originalMode == 'REMOVE'}">
				<security:authorize access="hasAuthority('ADMIN')">
					<jsp:element name="input">
						<jsp:attribute name="type">submit</jsp:attribute>
						<jsp:attribute name="value">Delete</jsp:attribute>
						<jsp:attribute name="onclick">this.form.elements['mode'].value='REMOVE';</jsp:attribute>
					</jsp:element>
				</security:authorize>
				</c:when>
			</c:choose>
		<security:authorize access="hasAuthority('ADMIN')">
			<jsp:element name="input">
				<jsp:attribute name="type">submit</jsp:attribute>
				<jsp:attribute name="value">Cancel</jsp:attribute>
				<jsp:attribute name="id">cancel</jsp:attribute>
				<jsp:attribute name="class">button</jsp:attribute>
				<jsp:attribute name="onclick">this.form.elements['mode'].value='CANCEL';</jsp:attribute>
			</jsp:element>
		</security:authorize>
		</div>																
	</form:form>
</jsp:root>
