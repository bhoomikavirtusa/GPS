<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
>
    <jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
   
	<c:set var="user" value="${manageUserForm.user}"/>
	
	<c:url var="formUrl" value="/sapp/admin/manageUser/form" />
	<c:url var="finishUrl" value="/sapp/admin/manageUser/finish" />

	<script type="text/javascript">
		function changeActionToForm() {
			var form = document.getElementById("manageUserForm");
			form.action = "${formUrl}";
		}

		function changeActionToFinish() {
			var form = document.getElementById("manageUserForm");
			form.action = "${finishUrl}";
		}
		
		$(document).ready(function() {
			$('#userProductRoleTable').dataTable( {
				"aoColumns": [
					{ "sWidth" : "10%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Edit
					{ "sWidth" : "10%", "sClass" : "center", "bSearchable" : false, "bSortable": false }, // Remove
					{ "sWidth" : "60%" }, // Product Title
					{ "sWidth" : "20%", "bSearchable" : false } // Role
				],
				"aaSorting": [[2, "asc" ]],
				"oLanguage": { "sEmptyTable": "No Product Roles Found" },
				"bAutoWidth": false,
				"bProcessing": true,
				"sPaginationType": "full_numbers",
				"aLengthMenu": [10, 15, 25, 50, 100],  // override default of [10, 25, 50, 100]
				"iDisplayLength": 15
				//"bStateSave": true
			} );
			
			$('#regenLink').click(function() {
				$('#regenDiv').empty().html("Communicating with server...");
				
				$.ajax({
		            async: false,
		            type: 'post',
		            url:  $(this).attr('href'),
		            success: function (response){
					 	$('#regenDiv').empty().html("New password created and emailed to user.");
		            }
		        });

		        return false;
			});
		} );
	</script>

	<form:form modelAttribute="manageUserForm">
		<jsp:attribute name="action">
			<c:url value="/sapp/admin/manageUser/submit" />
		</jsp:attribute>

		<div style="display: none">
			<input type="hidden" name="page" value="0" />

			<form:hidden path="mode"/>
			<form:hidden path="change"/>
			<form:hidden path="selectedChild"/>
			<input type="hidden" name="target" value="adminUserViewName" />
		</div>

		<spring:hasBindErrors name="manageUserForm">
			<jsp:directive.include file="/WEB-INF/tiles/pages/include/formErrors.jspx" />
		</spring:hasBindErrors>

		<table class="width100">
			<c:choose>
				<c:when test="${manageUserForm.mode == 'REMOVE'}">
					<input type="hidden" name="user.id" value="${user.id}" />
					<tr>
						<th>
							${user.firstName} ${user.lastName}
						</th>
						<th></th>
					</tr>		
					<tr>
						<td>
							Are you sure you want to ${user.enabled ? "disable" : "enable"} this user ?
						</td>
					</tr>

					<tr>
						<td>
							<tiles:insertDefinition name="tiles.admin.user">
								<tiles:putAttribute name="user" value="${user}" type="object"/>
							</tiles:insertDefinition>
						</td>
					</tr>
				</c:when>

				<c:otherwise>

					<spring:nestedPath path="user">
						<tr>
							<th>
								General Information
							</th>
							<th></th>
						</tr>							
				<!-- 		<tr>
							<td class="label">
								<form:label path="type" cssClass="required" cssErrorClass="error">Type:</form:label>
							</td>

							<td class="value">
								<form:select path="type" items="${userTypes}">
									<jsp:attribute trim="true" name="onchange">
										this.form.elements['change'].value='true';
										this.form.submit();
									</jsp:attribute>
								</form:select>
							</td>
						</tr>
-->
 						<tr>
							<td class="label">
								<form:label path="enabled" cssClass="required" cssErrorClass="error">Enabled:</form:label>
							</td>

							<td class="value">
								<form:select path="enabled">
									<form:option value="true">Yes</form:option>
									<form:option value="false">No</form:option>
								</form:select>
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="group" cssClass="optional" cssErrorClass="error">Group:</form:label>
							</td>

							<td class="value">
								<form:select path="group" id="group">
									<fmt:message key="select.choose.one" var="chooseOneMsg" />
									<c:if test="${null == user.group}">
										<form:option value="" label="${chooseOneMsg}" />
									</c:if>
									<c:if test="${null != user.group}">
										<form:option value="${user.group.id}" label="${user.group.name}" />
									</c:if>
									<form:options  items="${userGroups}" itemLabel="name" itemValue="id"/>
								</form:select>
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="firstName" cssClass="required" cssErrorClass="error">First Name:</form:label>
							</td>

							<td class="value">
								<form:input path="firstName"/>
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="lastName" cssClass="required" cssErrorClass="error">Last Name:</form:label>
							</td>

							<td class="value">
								<form:input path="lastName"/>
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="email" cssClass="required" cssErrorClass="error">E-mail:</form:label>
							</td>

							<td class="value">
								<form:input path="email" size="50" maxlength="200" />
								<input type="hidden" name="oldEmail" value="${user.email}" />
							</td>
						</tr>
	
					</spring:nestedPath>

					<tr>
						<td class="label">
							Favorite Source Group
						</td>

						<td class="value">	
							<form:select path="favoriteGroupId" id="favoriteGroupId">
								<option	value="0">None Selected</option>	
								<form:options items="${favoriteGroups}" itemLabel="description" itemValue="id"/>
							</form:select>
						</td>
					</tr>


					<c:if test="${user.type == 'AUTHOR' || user.type == 'FREELANCER'}">
						<tr>
							<td class="spacer">&amp;nbsp;</td>
						</tr>
						<tr>
							<th>Security Information</th>
							<th></th>							
						</tr>
						<tr>
							<td colspan="2">
								<c:if test="${not empty manageUserForm.user.email}">
									<c:url var="regenPasswordUrl" value="/sapp/landing/authorAccess/regenPassword" />
									<!--  regenDiv and regenLink are reference above by javascript -->
									<span id="regenDiv"><a href="${regenPasswordUrl}" id="regenLink">Send new password</a></span>
					 			</c:if>
							</td>
						</tr>
					</c:if>

					<tr>
						<td class="spacer">&amp;nbsp;</td>
					</tr>

					<tr>
						<th>Purchase Order Defaults</th>
						<th></th>						
					</tr>
					<spring:nestedPath path="user.userDefaults">
						<tr>
							<td class="label">
								<form:label path="userSignature" cssClass="optional" cssErrorClass="error">User Signature:</form:label>
							</td>

							<td class="value">
								<form:textarea cols="40" rows="6" path="userSignature"/>
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="returnAddress" cssClass="optional" cssErrorClass="error">Return Address:</form:label>
							</td>

							<td class="value">
								<form:textarea cols="40" rows="6" path="returnAddress"/>
							</td>
						</tr>
					</spring:nestedPath>

					<tr>
						<td class="spacer">&amp;nbsp;</td>
					</tr>

					<tr>
						<th>Payment Request Defaults</th>
						<th></th>						
					</tr>

					<spring:nestedPath path="user.userDefaults">
						<tr>
							<td class="label">
								<form:label path="costCenter" cssClass="optional" cssErrorClass="error">Cost Center:</form:label>
							</td>

							<td class="value">
								<form:input path="costCenter"/>
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="account" cssClass="optional" cssErrorClass="error">Account Number and Sub Code:</form:label>
							</td>

							<td class="value">
								<form:select path="account">
					    			<fmt:message key="select.choose.one" var="chooseOneMsg" />
									<form:option value="" label="${chooseOneMsg}" />
									<form:options items="${accounts}" itemLabel="accountNumberSubCodeDescription" itemValue="id" />
								</form:select>
							</td>
						</tr>
					</spring:nestedPath>

					<tr>
						<td class="spacer">&amp;nbsp;</td>
					</tr>

					<tr>
						<th>Product Defaults</th>
						<th></th>						
					</tr>
					<spring:nestedPath path="user.userDefaults">
						<tr>
							<td class="label">
								<form:label path="componentCategory" cssClass="required" cssErrorClass="error">Component Category:</form:label>
							</td>

							<td class="value">
								<form:select path="componentCategory">
									<form:option value="">All</form:option>
									<form:options items="${componentCategoryList}" itemLabel="description" itemValue="code"/>
								</form:select>
							</td>
						</tr>
					</spring:nestedPath>

					<tr>
						<td class="spacer">&amp;nbsp;</td>
					</tr>

					<tr>
						<th>Global Roles</th>
						<th></th>						
					</tr>

					<c:forEach items="${globalRoles}" step="3" var="role" varStatus="status">
						<tr>
							<td>
								<form:checkbox path="globalRoles" label="${role.descriptionAndType}" value="${role.code}"/>
								<br/>

								<c:if test="${fn:length(globalRoles) > 1}">
									<c:choose>
										<c:when test="${status.index + 1 lt fn:length(globalRoles)}">
											<form:checkbox path="globalRoles" label="${globalRoles[status.index+1].descriptionAndType}" value="${globalRoles[status.index+1].code}"/>
										</c:when>

										<c:otherwise>
											&amp;nbsp;
										</c:otherwise>
									</c:choose>
								</c:if>
								<br/>

								<c:if test="${fn:length(globalRoles) > 2}">
									<c:choose>
										<c:when test="${status.index + 2 lt fn:length(globalRoles)}">
											<form:checkbox path="globalRoles" label="${globalRoles[status.index+2].descriptionAndType}" value="${globalRoles[status.index+2].code}"/>
										</c:when>

										<c:otherwise>
											&amp;nbsp;
										</c:otherwise>
									</c:choose>
								</c:if>
								<br/>
							</td>
						</tr>
					</c:forEach>

					<tr>
						<th>
							Product Roles
						</th>
						<th></th>
					</tr>

					<tr>
						<td class="label optional">Add New Product Role - Product Search:</td>
						<td class="button">
							<input type="text" name="searchString" value="${userSession.productSearchString}" />
								    
							<!-- Strings such as "Author" may need to be internationalized later. -->
                       	 	<!-- Maybe do this a better way - instead of hard coding options. -->
    						<select name="searchField">
        						<c:choose>
        							<c:when test="${userSession.productSearchField == 'author'}">
            							<option value="author" selected="selected">Author</option>
        							</c:when>
        							<c:otherwise>
            							<option value="author">Author</option>
        							</c:otherwise>
       							</c:choose>
        
       							<c:choose>
       								<c:when test="${userSession.productSearchField == 'title'}">
           								<option value="title" selected="selected">Title</option>
       								</c:when>
       								<c:otherwise>
           								<option value="title">Title</option>
       								</c:otherwise>
       							</c:choose>
       						
       							<c:choose>
       								<c:when test="${userSession.productSearchField == 'isbn'}">
           								<option value="isbn" selected="selected">ISBN</option>
       								</c:when>
       								<c:otherwise>
           								<option value="isbn">ISBN</option>
       								</c:otherwise>
       							</c:choose>
    						</select>

							<jsp:element name="input">
								<jsp:attribute name="type">submit</jsp:attribute>
								<jsp:attribute name="value">Add</jsp:attribute>
								<jsp:attribute name="onclick">this.form.elements['mode'].value='ADD_CHILD'</jsp:attribute>
							</jsp:element>																
						</td>
					</tr>

					<c:if test="${not empty user.roles}">
						<tr>
							<td colspan="2">
								<table class="display" id="userProductRoleTable">
									<thead>
										<tr>
											<th>Edit</th>
											<th>Remove</th>
											<th>Product Title</th>
											<th>Role</th>
										</tr>
									</thead>
									<tbody>
										<c:forEach items="${user.productUserToRoles}" var="userToRole">
											<tr>
												<td>
													<jsp:element name="input">
														<jsp:attribute name="type">image</jsp:attribute>
														<jsp:attribute name="alt">Edit Association</jsp:attribute>
														<jsp:attribute name="onclick">
															this.form.elements['mode'].value='MODIFY_CHILD';
															this.form.elements['selectedChild'].value='${userToRole.id}';
														</jsp:attribute>
														<jsp:attribute name="src">
															<c:url value="/images/buttons/edit-icon.png" />
														</jsp:attribute>
													</jsp:element>
												</td>

												<td>
													<jsp:element name="input">
														<jsp:attribute name="type">image</jsp:attribute>
														<jsp:attribute name="alt">Remove Association</jsp:attribute>
														<jsp:attribute name="onclick">
															this.form.elements['mode'].value='REMOVE_CHILD';
															this.form.elements['selectedChild'].value='${userToRole.id}';
														</jsp:attribute>
														<jsp:attribute name="src">
															<c:url value="/images/buttons/delete-icon.png" />
														</jsp:attribute>
													</jsp:element>
												</td>

												<td><c:out value="${userToRole.product.title}" /></td>
												<td><c:out value="${userToRole.role.descriptionAndType}" /></td>
											</tr>
										</c:forEach>
									</tbody>
								</table>
							</td>
						</tr>
					</c:if>
				</c:otherwise>
			</c:choose>
		</table>
		<div class="buttonset">	
			<c:choose>
				<!-- Taken away Add button on previous page so this will never happen anymore (can remove later) -->
				<c:when test="${manageUserForm.originalMode == 'ADD'}">
					<jsp:element name="input">
						<jsp:attribute name="type">submit</jsp:attribute>
						<jsp:attribute name="value">Add</jsp:attribute>
						<jsp:attribute name="onclick">this.form.elements['mode'].value='ADD'; changeActionToFinish();</jsp:attribute>
					</jsp:element>
				</c:when>

				<c:when test="${manageUserForm.originalMode == 'MODIFY'}">
					<jsp:element name="input">
						<jsp:attribute name="type">submit</jsp:attribute>
						<jsp:attribute name="value">Modify</jsp:attribute>
						<jsp:attribute name="onclick">this.form.elements['mode'].value='MODIFY'; changeActionToFinish();</jsp:attribute>
					</jsp:element>
				</c:when>

				<c:when test="${manageUserForm.originalMode == 'REMOVE'}">
					<jsp:element name="input">
						<jsp:attribute name="type">submit</jsp:attribute>
						<jsp:attribute name="value">${user.enabled ? "Disable" : "Enable"}					
						</jsp:attribute>
						<jsp:attribute name="onclick">this.form.elements['mode'].value='REMOVE'; changeActionToFinish();</jsp:attribute>
					</jsp:element>
				</c:when>
			</c:choose>

			<jsp:element name="input">
				<jsp:attribute name="type">submit</jsp:attribute>
				<jsp:attribute name="value">Cancel</jsp:attribute>
				<jsp:attribute name="id">cancel</jsp:attribute>
				<jsp:attribute name="class">button</jsp:attribute>						
				<jsp:attribute name="onclick">this.form.elements['mode'].value='CANCEL'; changeActionToFinish();</jsp:attribute>
			</jsp:element>
		</div>
	</form:form>
</jsp:root>
