<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2" xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">

	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8" />
	<c:url var="sourceSearchUrl" value="${wileyfn:getRestUrl(pageContext.request)}/service/source/search" />

	<tiles:importAttribute name="beanName" />

	<form:form modelAttribute="${beanName}">
		<input type="hidden" name="_page1" value="true" />

		<div style="display: none">
			<form:hidden path="selectedSource" />
			<form:hidden path="mode" />
		</div>

		<table class="width100">
			<tr>
				<th colspan="2">Select Source</th>
			</tr>
			<tr>
				<td>
					Source name:
				</td>
				<td>
					<form:input path="sourceName" size="40" maxlength="40"/>
				</td>
			</tr>
		</table>
	<div class="buttonset">
		<jsp:element name="input">
			<jsp:attribute name="name">_target0</jsp:attribute>												
			<jsp:attribute name="type">submit</jsp:attribute>
			<jsp:attribute name="value">Select</jsp:attribute>
		</jsp:element>
	</div>

	</form:form>
	
	<script type="text/javascript">
	//<![CDATA[
	$(document).ready(function() {
			
		$( "#sourceName" ).autocomplete({
			source: function( request, response ) {
				$.jsonp({
					"url": '${sourceSearchUrl}/' + request.term + '?callback=?', 
					"success": function(json) {
						response( $.map( json, function( item ) {
							return {
								value: item.name,					
								id: item.id,
								disabled: item.disabled,
								sourceGroup: item.sourceGroup,
								sourceGroupName: item.sourceGroupName
							}
						}));
					},
					"error": function() {
			        	alert ("Error: failed to search sources");
			        }
		        });				
			},
			minLength: 3,
			select: function( event, ui ) {
				if (ui.item.disabled) {
					alert ("This source may not be used. Please select a different source.");
					$( "#sourceName" ).val ("");
					return false;
				} else {
					if (typeof ui.item.sourceGroup != 'undefined') {
						var doIt=confirm("source is already part of \"" + ui.item.sourceGroupName + "\". Do you want to continue");
					}
					if(doIt) {
						$( "#selectedSource" ).val (ui.item.id);
					}
				}
			},
			open: function() {
				$( this ).removeClass( "ui-corner-all" ).addClass( "ui-corner-top" );
			},
			close: function() {
				$( this ).removeClass( "ui-corner-top" ).addClass( "ui-corner-all" );
			}
		});
		
	});
	//]]>		
	</script>	
</jsp:root>
