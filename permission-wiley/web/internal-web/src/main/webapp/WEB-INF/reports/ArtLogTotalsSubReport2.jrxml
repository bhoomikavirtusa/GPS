<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ArtLogTotalsSubReport2" pageWidth="200" pageHeight="200" columnWidth="100" leftMargin="1" rightMargin="1" topMargin="1" bottomMargin="1">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPONENT_IDS" class="java.lang.String"/>
	<parameter name="USER_GROUP_FILTER" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a1.TOTAL, a2.NEW, a3.PICKUP from
(select count(*) as total from asset_use au join asset a
on au.asset_id = a.id where au.cw_id=$P{CW_ID} $P!{USER_GROUP_FILTER} $P!{COMPONENT_IDS} and a.media_type in ('Photo', 'Cover')) a1,
(select count(*) as new from asset_use au join asset a
on au.asset_id = a.id where au.cw_id=$P{CW_ID} $P!{USER_GROUP_FILTER} $P!{COMPONENT_IDS} and a.media_type in ('Photo', 'Cover')
and au.is_canceled=0 and au.reused_from_prev_ed=0 and au.is_PICKUP=0) a2,
(select count(*) as pickup from asset_use au join asset a
on au.asset_id = a.id where au.cw_id=$P{CW_ID} $P!{USER_GROUP_FILTER} $P!{COMPONENT_IDS} and a.media_type in ('Photo', 'Cover')
and (au.is_PICKUP=1 or au.reused_from_prev_ed=1)) a3]]>
	</queryString>
	<field name="TOTAL" class="java.lang.Long"/>
	<field name="NEW" class="java.lang.Long"/>
	<field name="PICKUP" class="java.lang.Long"/>
	<pageHeader>
		<band height="70" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="1" width="68" height="20"/>
				<textElement lineSpacing="Single"/>
				<text><![CDATA[Total Assets]]></text>
			</staticText>
			<textField>
				<reportElement x="68" y="1" width="100" height="20"/>
				<textElement lineSpacing="Single"/>
				<textFieldExpression class="java.lang.Long"><![CDATA[$F{TOTAL}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="68" y="21" width="100" height="20"/>
				<textElement lineSpacing="Single"/>
				<textFieldExpression class="java.lang.Long"><![CDATA[$F{NEW}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="21" width="68" height="20"/>
				<textElement lineSpacing="Single"/>
				<text><![CDATA[New]]></text>
			</staticText>
			<textField>
				<reportElement x="68" y="41" width="100" height="20"/>
				<textElement lineSpacing="Single"/>
				<textFieldExpression class="java.lang.Long"><![CDATA[$F{PICKUP}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="41" width="68" height="20"/>
				<textElement lineSpacing="Single"/>
				<text><![CDATA[Pickup]]></text>
			</staticText>
		</band>
	</pageHeader>
	<detail>
		<band splitType="Stretch"/>
	</detail>
</jasperReport>
