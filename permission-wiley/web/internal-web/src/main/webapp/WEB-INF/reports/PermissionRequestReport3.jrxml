<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PermissionRequestReport2" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="10" rightMargin="30" topMargin="5" bottomMargin="5">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center" lineSpacing="Single"/>
	<parameter name="PRODUCT_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="PO_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="SOURCE_CONNECTION" class="java.sql.Connection" isForPrompting="false"/>
	<parameter name="sourceSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="assetsSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     P.ID AS PRODUCT_ID,
     P.EXTERNAL_ID AS PRODUCT_EXTERNAL_ID,
     P.ISBN10 AS PRODUCT_ISBN10,
     P.ISBN13 AS PRODUCT_ISBN13,
     P.PNUMBER AS PRODUCT_PNUMBER,
     P.TITLE AS PRODUCT_TITLE,
     P.CONSOLIDATED_RELEASE_DATE,
     P.SHORT_TITLE AS PRODUCT_SHORT_TITLE,
     P.VOLUME AS PRODUCT_VOLUME,
     PO.ID AS PURCHASE_ORDER_ID,
     PO.ID AS PURCHASE_ORDER_NUMBER,
     PO.DATE AS PURCHASE_ORDER_DATE,
     PO.SOURCE_ID AS PURCHASE_ORDER_SOURCE_ID,
     PO.NOTE AS PURCHASE_ORDER_NOTE,
     PO.RETURN_ADDRESS AS PURCHASE_ORDER_RETURN_ADDRESS,
     PO.USER_SIGNATURE AS PURCHASE_ORDER_USER_SIGNATURE,
     WE.DESCRIPTION AS WILEY_ENTITY,
     S.EXTERNAL_ID AS SOURCE_EXTERNAL_ID,
     'To: ' || TRIM(S.NAME) || ':' AS SOURCE_EXTERNAL_NAME,
     S.CREDIT_LINE as SOURCE_CREDIT_LINE,
     CONCAT (CONCAT (UP.FIRST_NAME, ' '), UP.LAST_NAME) AS AUTHOR,
     p.short_author_name PUBLICATION_AUTHOR
     FROM
     SOURCE S INNER JOIN PURCHASE_ORDER PO ON S.ID = PO.SOURCE_ID
	 JOIN USER_TABLE UT ON UT.ID = PO.CREATED_USER_ID JOIN USER_DEFAULTS UD ON UT.ID = UD.USER_ID JOIN WILEY_ENTITY WE ON WE.CODE = UD.WILEY_ENTITY_CODE,
     PRODUCT P
     left JOIN (select UR.PRODUCT_ID, U.* FROM USER_2_ROLE UR
     JOIN USER_TABLE U ON UR.USER_ID = U.ID
     AND UR.ROLE_ID = (select id from role where code = 'A' and role_type = 'AUTHOR')
     AND UR.PRODUCT_ID = $P{PRODUCT_ID} LIMIT 1) UP ON UP.PRODUCT_ID = P.ID
WHERE
     P.ID = $P{PRODUCT_ID}
 AND PO.ID = $P{PO_ID}]]>
	</queryString>
	<field name="PRODUCT_ID" class="java.lang.Integer"/>
	<field name="PRODUCT_EXTERNAL_ID" class="java.lang.String"/>
	<field name="PRODUCT_ISBN10" class="java.lang.String"/>
	<field name="PRODUCT_ISBN13" class="java.lang.String"/>
	<field name="PRODUCT_PNUMBER" class="java.lang.String"/>
	<field name="PRODUCT_TITLE" class="java.lang.String"/>
	<field name="CONSOLIDATED_RELEASE_DATE" class="java.sql.Timestamp"/>
	<field name="PRODUCT_SHORT_TITLE" class="java.lang.String"/>
	<field name="PRODUCT_VOLUME" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_NUMBER" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_DATE" class="java.sql.Timestamp"/>
	<field name="PURCHASE_ORDER_SOURCE_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_NOTE" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_RETURN_ADDRESS" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_USER_SIGNATURE" class="java.lang.String"/>
	<field name="WILEY_ENTITY" class="java.lang.String"/>
	<field name="SOURCE_EXTERNAL_ID" class="java.lang.String"/>
	<field name="SOURCE_EXTERNAL_NAME" class="java.lang.String"/>
	<field name="SOURCE_CREDIT_LINE" class="java.lang.String"/>
	<field name="AUTHOR" class="java.lang.String"/>
	<field name="PUBLICATION_AUTHOR" class="java.lang.String"/>
	<variable name="PREFACE" class="java.lang.String">
		<variableExpression><![CDATA["I am preparing a manuscript to be published by John Wiley & Sons, Inc"]]></variableExpression>
	</variable>
	<variable name="AUTHORTITLE" class="java.lang.String">
		<variableExpression><![CDATA[$F{PUBLICATION_AUTHOR} + "/" + $F{PRODUCT_TITLE}]]></variableExpression>
	</variable>
	<variable name="ESTIMATEDPUBDATE" class="java.lang.String">
		<variableExpression><![CDATA["Estimated Publication date: " +
($F{CONSOLIDATED_RELEASE_DATE} == null ? "" : "" + ($F{CONSOLIDATED_RELEASE_DATE}.getYear()+1900))]]></variableExpression>
	</variable>
	<variable name="PONO" class="java.lang.String">
		<variableExpression><![CDATA["Wiley Permission # " + $F{PURCHASE_ORDER_ID}]]></variableExpression>
	</variable>
	<group name="PurchaseOrder">
		<groupHeader>
			<band height="108" splitType="Stretch">
				<textField evaluationTime="Report" isBlankWhenNull="true">
					<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="5" y="43" width="539" height="18" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true"/>
					<textElement verticalAlignment="Middle" lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$V{PREFACE}]]></textFieldExpression>
				</textField>
				<textField pattern="MMMMM dd, yyyy" isBlankWhenNull="false">
					<reportElement key="textField" x="5" y="1" width="139" height="19" forecolor="#000000" backcolor="#FFFFFF"/>
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.util.Date"><![CDATA[$F{PURCHASE_ORDER_DATE}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Report" isBlankWhenNull="true">
					<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="116" y="62" width="436" height="18" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true"/>
					<textElement verticalAlignment="Middle" lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$V{AUTHORTITLE}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Report" isBlankWhenNull="true">
					<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="5" y="85" width="539" height="18" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true"/>
					<textElement verticalAlignment="Middle" lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$V{ESTIMATEDPUBDATE}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement positionType="Float" x="5" y="64" width="111" height="19"/>
					<textElement lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<text><![CDATA[Author/Tentative Title:]]></text>
				</staticText>
				<staticText>
					<reportElement positionType="Float" x="9" y="20" width="424" height="19"/>
					<textElement lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<text><![CDATA[To: Wiley Permissions Coordinator]]></text>
				</staticText>
			</band>
		</groupHeader>
	</group>
	<pageHeader>
		<band height="66" splitType="Stretch">
			<staticText>
				<reportElement x="63" y="9" width="408" height="46"/>
				<textElement textAlignment="Center" lineSpacing="Single">
					<font size="18"/>
				</textElement>
				<text><![CDATA[Permission Request Form]]></text>
			</staticText>
			<image scaleImage="RetainShape" isLazy="true" onErrorType="Icon">
				<reportElement x="5" y="0" width="64" height="65"/>
				<imageExpression class="java.lang.String"><![CDATA["images/wiley-logo.gif"]]></imageExpression>
			</image>
		</band>
	</pageHeader>
	<detail>
		<band height="378" splitType="Stretch">
			<subreport isUsingCache="false">
				<reportElement x="5" y="67" width="527" height="41" backcolor="#FFFFFF"/>
				<subreportParameter name="PRODUCT_ID">
					<subreportParameterExpression><![CDATA[$P{PRODUCT_ID}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="CW_ID">
					<subreportParameterExpression><![CDATA[$P{CW_ID}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="PO_ID">
					<subreportParameterExpression><![CDATA[$P{PO_ID}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="net.sf.jasperreports.engine.JasperReport"><![CDATA[$P{assetsSubReport}]]></subreportExpression>
			</subreport>
			<staticText>
				<reportElement positionType="Float" x="5" y="182" width="166" height="18"/>
				<textElement lineSpacing="Single"/>
				<text><![CDATA[Thank you.]]></text>
			</staticText>
			<line>
				<reportElement positionType="Float" x="5" y="320" width="518" height="1"/>
			</line>
			<line>
				<reportElement positionType="Float" x="5" y="352" width="202" height="1"/>
			</line>
			<staticText>
				<reportElement positionType="Float" x="5" y="356" width="100" height="13"/>
				<textElement lineSpacing="Single"/>
				<text><![CDATA[Your signature]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement positionType="Float" x="159" y="284" width="376" height="30"/>
				<textElement lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{SOURCE_CREDIT_LINE}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement positionType="Float" x="5" y="205" width="270" height="20"/>
				<textElement lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{PURCHASE_ORDER_USER_SIGNATURE}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement positionType="Float" x="289" y="204" width="263" height="70"/>
				<textElement lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{PURCHASE_ORDER_RETURN_ADDRESS}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="308" y="356" width="100" height="13"/>
				<textElement lineSpacing="Single"/>
				<text><![CDATA[Date ]]></text>
			</staticText>
			<line>
				<reportElement positionType="Float" x="259" y="353" width="202" height="1"/>
			</line>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" x="5" y="157" width="547" height="21" isRemoveLineWhenBlank="true"/>
				<textElement lineSpacing="Single"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{PURCHASE_ORDER_NOTE}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="5" y="0" width="547" height="67"/>
				<textElement lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<text><![CDATA[I request your permission to include the following material in this and all subsequent editions of the above-referenced book, in all media of expression now known or later developed and in all foreign language translations and other derivative works published or prepared by John Wiley & Sons, Inc. or its licensees, for distribution throughout the world, and also in versions made by nonprofit organizations for use by blind or physically handicapped persons.  Appropriate credit will be given as provided below.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="9" y="108" width="547" height="44"/>
				<textElement lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<text><![CDATA[Please indicate your agreement by signing and returning the enclosed copy of this letter to me.  In signing, you warrant that you are the sole owner of the rights granted and that your material does not infringe upon the copyright or other rights of anyone.  If you do not control these rights, I would appreciate your letting me know to whom I should apply.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="5" y="287" width="151" height="19"/>
				<textElement lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<text><![CDATA[Credit and/or copyright notice:]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="5" y="320" width="166" height="18"/>
				<textElement lineSpacing="Single"/>
				<text><![CDATA[AGREED TO AND ACCEPTED]]></text>
			</staticText>
		</band>
	</detail>
</jasperReport>
