<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ArtLogReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center" lineSpacing="Single"/>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="USER_GROUP_FILTER" class="java.lang.String"/>
	<parameter name="USER_GROUP_FILTER_NAME" class="java.lang.String"/>
	<parameter name="artLogSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="artLogTotalsSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="PRODUCT_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPONENT_IDS" class="java.lang.String"/>
	<parameter name="COMPONENT_NAMES" class="java.lang.String"/>
	<queryString>
		<![CDATA[select P.id AS PRODUCT_ID, P.title AS PRODUCT_TITLE, PE.edition_number AS PRODUCT_EDITION,
if(P.isbn13 != null, P.isbn13, P.isbn10)  AS PRODUCT_ISBN13, if (CONCAT (CONCAT(U.first_name, ' '), U.last_name) != null,
CONCAT (CONCAT(U.first_name, ' '), U.last_name), P.SHORT_AUTHOR_NAME) AS PRODUCT_AUTHOR
from product P left join product_edition PE on P.edition =  PE.id left join user_2_role U2R on P.id = U2R.product_id
and U2R.role_id=(select id from role where code = 'A' and role_type = 'AUTHOR')
left join user_table U on U.id = U2R.user_id
where P.ID = $P{PRODUCT_ID} order by P.id, PRODUCT_author LIMIT 1]]>
	</queryString>
	<field name="PRODUCT_ID" class="java.lang.Integer"/>
	<field name="PRODUCT_TITLE" class="java.lang.String"/>
	<field name="PRODUCT_EDITION" class="java.lang.Integer"/>
	<field name="PRODUCT_ISBN13" class="java.lang.String"/>
	<field name="PRODUCT_AUTHOR" class="java.lang.String"/>
	<group name="Product">
		<groupHeader>
			<band height="127" splitType="Stretch">
				<staticText>
					<reportElement positionType="Float" x="10" y="40" width="66" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[Author:]]></text>
				</staticText>
				<staticText>
					<reportElement positionType="Float" x="10" y="60" width="66" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[Edition:]]></text>
				</staticText>
				<staticText>
					<reportElement positionType="Float" x="10" y="20" width="66" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[ISBN:]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement positionType="Float" x="76" y="0" width="233" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{PRODUCT_TITLE}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement positionType="Float" x="76" y="60" width="233" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.Integer"><![CDATA[$F{PRODUCT_EDITION}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement positionType="Float" x="10" y="0" width="66" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[Title:]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement positionType="Float" x="76" y="20" width="233" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{PRODUCT_ISBN13}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement positionType="Float" x="76" y="40" width="233" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{PRODUCT_AUTHOR}]]></textFieldExpression>
				</textField>
				<subreport>
					<reportElement isPrintRepeatedValues="false" x="563" y="3" width="219" height="73" isRemoveLineWhenBlank="true"/>
					<subreportParameter name="CW_ID">
						<subreportParameterExpression><![CDATA[$P{CW_ID}]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter name="COMPONENT_IDS">
						<subreportParameterExpression><![CDATA[$P{COMPONENT_IDS}]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter name="USER_GROUP_FILTER">
						<subreportParameterExpression><![CDATA[$P{USER_GROUP_FILTER}]]></subreportParameterExpression>
					</subreportParameter>
					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					<subreportExpression class="net.sf.jasperreports.engine.JasperReport"><![CDATA[$P{artLogTotalsSubReport}]]></subreportExpression>
				</subreport>
				<staticText>
					<reportElement positionType="Float" x="10" y="80" width="66" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[Components:]]></text>
				</staticText>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement x="76" y="80" width="467" height="20"/>
					<textElement lineSpacing="Single"/>
					<textFieldExpression class="java.lang.String"><![CDATA[$P{COMPONENT_NAMES}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement x="78" y="100" width="467" height="20"/>
					<textElement lineSpacing="Single"/>
					<textFieldExpression class="java.lang.String"><![CDATA[$P{USER_GROUP_FILTER_NAME}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement positionType="Float" x="11" y="100" width="66" height="20"/>
					<textElement lineSpacing="Single">
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[User Group:]]></text>
				</staticText>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<pageHeader>
		<band height="62" splitType="Stretch">
			<staticText>
				<reportElement x="127" y="9" width="216" height="35"/>
				<textElement textAlignment="Center" lineSpacing="Single">
					<font size="17"/>
				</textElement>
				<text><![CDATA[Assets to Production]]></text>
			</staticText>
			<image scaleImage="RetainShape" isLazy="true" onErrorType="Icon">
				<reportElement x="2" y="0" width="115" height="55"/>
				<imageExpression class="java.lang.String"><![CDATA["images/wiley-logo.gif"]]></imageExpression>
			</image>
		</band>
	</pageHeader>
	<detail>
		<band height="48" splitType="Stretch">
			<subreport isUsingCache="false">
				<reportElement mode="Transparent" x="0" y="0" width="842" height="45" isRemoveLineWhenBlank="true" backcolor="#FFFFFF"/>
				<subreportParameter name="CW_ID">
					<subreportParameterExpression><![CDATA[$P{CW_ID}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="USER_GROUP_FILTER">
					<subreportParameterExpression><![CDATA[$P{USER_GROUP_FILTER}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="COMPONENT_IDS">
					<subreportParameterExpression><![CDATA[$P{COMPONENT_IDS}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="net.sf.jasperreports.engine.JasperReport"><![CDATA[$P{artLogSubReport}]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<pageFooter>
		<band height="19" splitType="Stretch">
			<textField pattern="" isBlankWhenNull="false">
				<reportElement key="textField" x="343" y="0" width="170" height="19" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement key="textField" x="2" y="0" width="209" height="19" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement lineSpacing="Single">
					<font size="10"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new Date()]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
