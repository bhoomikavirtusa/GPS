<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="POAssetsReport2" pageWidth="555" pageHeight="200" columnWidth="100" leftMargin="1" rightMargin="1" topMargin="1" bottomMargin="1">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PO_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT distinct
     AU.USAGE_TYPE AS AU_USAGE,
       CASE  WHEN (select name from component where id = AU.COMPONENT_ID) is null
         THEN 'N/A'
          ELSE (select name from component where id = AU.COMPONENT_ID)
        END
     AS AU_COMPONENT,
     CASE  WHEN AU.POSITION is null
         THEN ''
          ELSE AU.POSITION
        END
     AS AU_POSITION,
     CASE
        WHEN (AU.SIZE = 'N/A')
            THEN ''
        WHEN (AU.SIZE = 'n/a')
            THEN ''
     ELSE
        AU.SIZE
     END AS AU_SIZE,
     AU.MANUSCRIPT_PAGE AS AU_MANUSCRIPT_PAG,
     AU.PERMISSION_STATUS AS AU_PERMISSION_STATUS,
     AU.PERMISSION_COMMENT AS AU_PERMISSION_COMMENT,
     AU.CAPTION AS AU_CAPTION,
     AU.REUSED_FROM_PREV_ED AS AU_REUSED_FROM_PR,
     AU.IS_PICKUP AS AU_IS_PICKUP,
     AU.CAMERA_COPY_TO_COME AS AU_CAMERA_COPY_TO,
     AU.IS_CANCELED AS AU_IS_CANCELED,
     AU.MEDIA_RETURN_REQ AS AU_MEDIA_RETURN_R,
     AU.PICKUP_ISBN AS AU_PICKUP_ISBN,
     AU.PICKUP_COMMENT AS AU_PICKUP_COMMENT,
     CASE  WHEN AU.IS_COLOR is null
         THEN 0
          ELSE AU.IS_COLOR
     END AS AU_IS_COLOR,
     A.ARTIST AS ASSET_ARTIST,
       CASE  WHEN A.CREDIT_LINE is null
         THEN ''
          ELSE A.CREDIT_LINE
        END
     AS ASSET_CREDIT_LINE,
     A.IS_FEE_REQUIRED AS ASSET_IS_FEE_REQUIRED,
     A.IS_RESTRICTED_USE AS ASSET_IS_RESTRICTED_USE,
     A.IS_MANAGED AS ASSET_IS_MANAGED,
     A.DESCRIPTION AS ASSET_DESCRIPTION,
     A.ORIGINAL_PUBLICATION_TITLE AS ASSET_PUBLICATION_TITLE,
     A.ORIGINAL_PUBLICATION_AUTHOR AS ASSET_PUBLICATION_AUTHOR,
     A.ORIGINAL_PUBLICATION_ISBN AS ASSET_PUBLICATION_ISBN,
     A.ORIGINAL_FIGURE_NUMBER AS ASSET_FIGURE_NUMBER,
     A.ORIGINAL_PAGE_NUMBER AS ASSET_PAGE_NUMBER,
     A.FROM_1 AS ASSET_FROM_1,
     A.FROM_2 AS ASSET_FROM_2,
     A.FROM_3 AS ASSET_FROM_3,
     A.TO_1 AS ASSET_TO_1,
     A.TO_2 AS ASSET_TO_2,
     A.TO_3 AS ASSET_TO_3,
     CASE  WHEN A.VENDOR_ID is null
         THEN ''
          ELSE A.VENDOR_ID
        END
     AS ASSET_VENDOR_ID,
     A.MEDIA_TYPE AS ASSET_MEDIA_TYPE,
       CASE  WHEN A.CITATION is null
         THEN ''
          ELSE A.CITATION
        END
     AS ASSET_CITATION,
        CASE  WHEN A.BIBLIO is null
         THEN ''
          ELSE A.BIBLIO
        END
     AS ASSET_BIBLIO,
     AU.EXTERNAL_ID AS AU_EXTERNAL_ID,
     AU.ASSET_ID AS AU_ASSET_ID,
     PO2A.PURCHASE_ORDER_ID AS PURCHASE_ORDER_2_ASSET_PURCHAS,
     PO2A.ASSET_BASE_ID AS PURCHASE_ORDER_2_ASSET_ASSET_B,
     PO.SHOW_ESTIMATED_COST AS SHOW_COST,
     AU.ESTIMATED_COST AS AU_COST,
     CASE  WHEN  AU.PICKUP_PAGE is null
         THEN ''
          ELSE  AU.PICKUP_PAGE
        END
     AS  AU_PICKUP_PAGE,
     CASE  WHEN  AU.PICKUP_POSITION is null
         THEN ''
          ELSE  AU.PICKUP_POSITION
        END
     AS  AU_PICKUP_POSITION,
     PPROD.TITlE PPAU_TITLE,
     PPROD.SHORT_AUTHOR_NAME PPAU_AUTHOR,
     PPROD.ISBN13 PPAU_ISBN,
     po2a.purchase_order_id PURCHASE_ORDER_ID
FROM
      PURCHASE_ORDER_2_ASSET PO2A
     INNER JOIN ASSET A ON A.ID = PO2A.ASSET_BASE_ID
     INNER JOIN ASSET_USE AU ON A.ID = AU.ASSET_ID
     INNER JOIN PURCHASE_ORDER PO ON PO.CW_ID = AU.CW_ID
     INNER JOIN ASSET_USE PPAU ON PPAU.ID =  AU.Previous_wileypub_au_id
     INNER JOIN PRODUCT PPROD ON PPROD.CW_ID = PPAU.CW_ID AND PPROD.IS_CW_PRIMARY = 1
WHERE

	AU.CW_ID = $P{CW_ID} AND
    AU.IS_CANCELED = 0 AND
    po2a.purchase_order_id = $P{PO_ID} AND
	AU.PREVIOUS_WILEYPUB_AU_ID is not null]]>
	</queryString>
	<field name="AU_USAGE" class="java.lang.String"/>
	<field name="AU_COMPONENT" class="java.lang.String"/>
	<field name="AU_POSITION" class="java.lang.String"/>
	<field name="AU_SIZE" class="java.lang.String"/>
