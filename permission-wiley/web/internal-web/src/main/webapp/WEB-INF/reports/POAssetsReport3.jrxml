	<field name="AU_CAMERA_COPY_TO" class="java.lang.Integer"/>
	<field name="AU_IS_CANCELED" class="java.lang.Integer"/>
	<field name="AU_MEDIA_RETURN_R" class="java.lang.Integer"/>
	<field name="AU_PICKUP_ISBN" class="java.lang.String"/>
