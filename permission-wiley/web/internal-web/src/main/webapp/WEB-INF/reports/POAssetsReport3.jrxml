	<field name="AU_COST" class="java.math.BigDecimal"/>
	<field name="PURCHASE_ORDER_2_ASSET_PURCHAS" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_2_ASSET_ASSET_B" class="java.lang.Integer"/>
	<field name="SHOW_COST" class="java.lang.Integer"/>
	<field name="AU_PICKUP_POSITION" class="java.lang.String"/>
	<field name="AU_PICKUP_PAGE" class="java.lang.String"/>
	<field name="PPAU_TITLE" class="java.lang.String"/>
	<field name="PPAU_AUTHOR" class="java.lang.String"/>
	<field name="PPAU_ISBN" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_ID" class="java.lang.String"/>
	<variable name="OriginalPublisher1" class="java.lang.String">
		<variableExpression><![CDATA[(    ($F{ASSET_PUBLICATION_TITLE} != null && !$F{ASSET_PUBLICATION_TITLE}.isEmpty()) ?
        "Found in:   " + $F{ASSET_PUBLICATION_TITLE}
        :
        "")
   +
(    ($F{ASSET_PUBLICATION_ISBN} != null && !$F{ASSET_PUBLICATION_ISBN}.isEmpty()) ?
        " (" + $F{ASSET_PUBLICATION_ISBN} + ")"
        :
        "")
    +
(    ($F{ASSET_PUBLICATION_AUTHOR} != null && !$F{ASSET_PUBLICATION_AUTHOR}.isEmpty()) ?
        "      by:   " + $F{ASSET_PUBLICATION_AUTHOR}
        :
        "")
    +
(    ($F{ASSET_PAGE_NUMBER} != null && !$F{ASSET_PAGE_NUMBER}.isEmpty()) ?
        "      on page:   " + $F{ASSET_PAGE_NUMBER}
        :
        "")
    +
(    ($F{ASSET_FIGURE_NUMBER}!= null && !$F{ASSET_FIGURE_NUMBER}.isEmpty()) ?
        "     figure:   " + $F{ASSET_FIGURE_NUMBER}
        :
        "")]]></variableExpression>
	</variable>
	<variable name="PhotoInfo" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{ASSET_ARTIST} != null && !$F{ASSET_ARTIST}.isEmpty()) ?
        "Artist/Photographer:    " + $F{ASSET_ARTIST} + " "
        :
        "")
)]]></variableExpression>
	</variable>
	<variable name="OriginalPublisher2" class="java.lang.String">
		<variableExpression><![CDATA[(    ($F{ASSET_FROM_1} != null && !$F{ASSET_FROM_1}.isEmpty()) ?
        " from:   " +$F{ASSET_FROM_1}
        :
        "")
    +
(    ($F{ASSET_TO_1} != null && !$F{ASSET_TO_1}.isEmpty()) ?
        " to:   " +$F{ASSET_TO_1}
        :
        "")
    +
(    ($F{ASSET_FROM_2} != null & !$F{ASSET_FROM_2}.isEmpty()) ?
        " from:   " +$F{ASSET_FROM_2}
        :
        "")
    +
(    ($F{ASSET_FROM_2} != null && !$F{ASSET_TO_2}.isEmpty()) ?
        " to:   " +$F{ASSET_TO_2}
        :
        "")
    +
(    ($F{ASSET_FROM_3} != null && !$F{ASSET_FROM_3}.isEmpty()) ?
        " from:   " +$F{ASSET_FROM_3}
        :
        "")
    +
(    ($F{ASSET_TO_3} != null && !$F{ASSET_TO_3}.isEmpty()) ?
        " to:   " +$F{ASSET_TO_3}
        :
        "")]]></variableExpression>
	</variable>
	<variable name="Citations" class="java.lang.String">
		<variableExpression><![CDATA[(    (!$F{ASSET_CREDIT_LINE}.isEmpty()) ?
        "Credit Line:   " +$F{ASSET_CREDIT_LINE}
        :
        "")
+
(     (!$F{ASSET_CITATION}.isEmpty()) ?
        "          To be cited:   " +$F{ASSET_CITATION}
        :
        "")
 +
(    (!$F{ASSET_BIBLIO}.isEmpty()) ?
        "          Bibliographic reference:   " +$F{ASSET_BIBLIO}
        :
        "")]]></variableExpression>
	</variable>
	<variable name="Details" class="java.lang.String">
		<variableExpression><![CDATA[(    (!$F{AU_POSITION}.isEmpty()) ?
        "Our Fig #:   " +$F{AU_POSITION} + "       "
        :
        "")
+
(     (!$F{ASSET_VENDOR_ID}.isEmpty()) ?
        "Your Reference #:   " +$F{ASSET_VENDOR_ID}  + "       "
        :
        "")
+
(     (!$F{AU_USAGE}.isEmpty()) ?
        "Usage:   " +$F{AU_USAGE} + "       "
        :
        "")
 +
(    ($F{AU_REUSED_FROM_PR} == 1) ?
        "Reuse:   Yes       "
        :
        "")
+
(    ($F{AU_SIZE} != null && !$F{AU_SIZE}.isEmpty()) ?
        "Size:    " + $F{AU_SIZE}  + "       "
        :
        "")
+
(    ($F{AU_IS_COLOR} == 1 ) ?
        "Format:    Color"  + "       "
        :
        "Format:    B&W")  + "       "
+
(    ($F{SHOW_COST} == 1) ?
        "   Estimated Cost: " + $F{AU_COST} + " "
        :
        "")]]></variableExpression>
	</variable>
