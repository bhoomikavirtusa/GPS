	<field name="PO_ESTIMATED_CURR" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_NUMBER" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_DATE" class="java.sql.Timestamp"/>
	<field name="PURCHASE_ORDER_SOURCE_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_NOTE" class="java.lang.String"/>
	<field name="PO_CONTACT_INFO" class="java.lang.String"/>
	<field name="PO_ADDRESS_INFO" class="java.lang.String"/>
	<field name="SOURCE_NAME" class="java.lang.String"/>
	<field name="GENERIC" class="java.lang.String"/>
	<field name="PRODUCT_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_RETURN_ADDRESS" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_USER_SIGNATURE" class="java.lang.String"/>
	<field name="RETURN_NAME_AND_ADDRESS" class="java.lang.String"/>
	<field name="PO_SHOW_ESTIMATED_COST" class="java.lang.Boolean"/>
	<field name="SOURCE_EXTERNAL_ID" class="java.lang.String"/>
	<variable name="PREPRE" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{GENERIC}.equals("1") ) ?
        $F{RETURN_NAME_AND_ADDRESS} + $R{po.text7} + $F{SOURCE_NAME} + $F{PO_ADDRESS_INFO}
        :
        "")
+
(    ($F{GENERIC}.equals("0") ) ?
           $F{RETURN_NAME_AND_ADDRESS} + $F{PO_CONTACT_INFO} + $F{SOURCE_NAME} + $F{PO_ADDRESS_INFO}
        :
        "")
)]]></variableExpression>
	</variable>
	<variable name="NOTEHEADER" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{PURCHASE_ORDER_NOTE}.isEmpty() ) ?
        ""
        :
        $R{po.notes})
)]]></variableExpression>
	</variable>
	<variable name="TITLEINFO" class="java.lang.String">
		<variableExpression><![CDATA[(
    (($F{PRODUCT_TITLE}.isEmpty() ) ?
        ""
        :
        $F{PRODUCT_TITLE}
    )
    +
(    ($F{PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR} && $F{PRODUCT_COPYRIGHT_YEAR} != null &&  $F{PRODUCT_COPYRIGHT_YEAR} != 0) ?
        " / " + $R{po.text8} + " " + $F{PRODUCT_COPYRIGHT_YEAR}
        :
        "")
+
(    (!$F{PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR} && $F{CONSOLIDATED_RELEASE_DATE} != null ) ?
        " / " +  $R{po.text9} + " " + $F{CONSOLIDATED_RELEASE_DATE}
        :
        "")
)]]></variableExpression>
	</variable>
