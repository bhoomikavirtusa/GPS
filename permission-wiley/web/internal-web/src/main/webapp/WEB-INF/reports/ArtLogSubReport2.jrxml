	<queryString>
		<![CDATA[SELECT UT.ABBREVIATION AS AU_USAGE,
     COALESCE ((select name from component where id = AU.COMPONENT_ID), 'N/A')
     AS AU_COMPONENT,
     AU.POSITION AS AU_POSITION,
     AU.FINAL_PAGE AS AU_FINAL_PAGE,
     AU.SIZE AS AU_SIZE,
     AU.MANUSCRIPT_PAGE AS AU_MANUSCRIPT_PAG,
     AU.PERMISSION_STATUS AS AU_PERMISSION_STATUS,
     AU.PRODUCTION_COMMENT AS AU_PRODUCTION_COMMENT,
     AU.REUSED_FROM_PREV_ED AS AU_REUSED_FROM_PR,
     AU.IS_PICKUP AS AU_IS_PICKUP,
     AU.CAMERA_COPY_TO_COME AS AU_CAMERA_COPY_TO,
     AU.IS_CANCELED AS AU_IS_CANCELED,
     AU.MEDIA_RETURN_REQ AS AU_MEDIA_RETURN_R,
     AU.IS_COLOR AS AU_IS_COLOR,
     A.ARTIST AS ASSET_ARTIST,
     A.CREDIT_LINE AS ASSET_CREDIT_LINE,
     A.IS_FEE_REQUIRED AS ASSET_IS_FEE_REQUIRED,
     A.IS_RESTRICTED_USE AS ASSET_IS_RESTRICTED_USE,
     A.IS_MANAGED AS ASSET_IS_MANAGED,
     A.DESCRIPTION AS ASSET_DESCRIPTION,
     A.ORIGINAL_PUBLICATION_TITLE AS ASSET_PUBLICATION_TITLE,
     A.ORIGINAL_PUBLICATION_AUTHOR AS ASSET_PUBLICATION_AUTHOR,
     A.ORIGINAL_PUBLICATION_ISBN AS ASSET_PUBLICATION_ISBN,
     A.ORIGINAL_FIGURE_NUMBER AS ASSET_FIGURE_NUMBER,
     A.ORIGINAL_PAGE_NUMBER AS ASSET_PAGE_NUMBER,
     A.VENDOR_ID AS ASSET_VENDOR_ID,
     A.MEDIA_TYPE AS ASSET_MEDIA_TYPE,
     AU.ASSET_ID AS AU_ASSET_ID,
         CASE WHEN(AU.PICKUP_ISBN is not null) THEN AU.PICKUP_ISBN
     ELSE
        CASE WHEN(AU.REUSED_ISBN is not null) THEN AU.REUSED_ISBN
      ELSE ' ' END END AS AU_PICKUP_ISBN,
     CASE WHEN( AU.PICKUP_POSITION is not null) THEN  AU.PICKUP_POSITION
     ELSE
        CASE WHEN(AU.REUSED_POSITION is not null) THEN AU.REUSED_POSITION
      ELSE ' ' END END AS AU_PICKUP_POSITION,
     CASE WHEN( AU.PICKUP_PAGE is not null) THEN  'P' || AU.PICKUP_PAGE
     ELSE
        CASE WHEN(AU.REUSED_PAGE is not null) THEN 'P' || AU.REUSED_PAGE
      ELSE ' ' END END AS AU_PICKUP_PAGE,
     AU.DATE_TO_PROD AS AU_DATE_TO_PROD,
     AF.OBJECT_NAME,
     AF.DATA AS ASSET_IMAGE
	 FROM ASSET_USE AU
	    JOIN USAGE_TYPE UT ON UT.CODE = AU.USAGE_TYPE
     	RIGHT JOIN ASSET A ON A.ID = AU.ASSET_ID 
		LEFT JOIN ASSET_FILE AF ON AF.ASSET_ID = AU.ASSET_ID AND
			AF.ID = (SELECT MIN(ID) FROM ASSET_FILE WHERE ASSET_FILE.ASSET_ID = AU.ASSET_ID and asset_file.rendition_type = 'original')
WHERE AU.CW_ID = $P{CW_ID}  $P!{COMPONENT_IDS}  $P!{USER_GROUP_FILTER} AND (AU.IS_CANCELED <> 1 OR AU.IS_CANCELED is null)
ORDER BY AU_COMPONENT ASC, AU_POSITION ASC]]>
	</queryString>
