		<paragraph lineSpacing="Single"/>
	</style>
	<parameter name="PRODUCT_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="PO_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="SOURCE_CONNECTION" class="java.sql.Connection" isForPrompting="false"/>
	<parameter name="sourceSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="assetsSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
        CASE  WHEN (PO.SOURCE_CONTACT_INFO is null)
         THEN ''
         WHEN (PO.SOURCE_CONTACT_INFO = 'To whom it may concern')
         THEN  s.DISPLAY_NAME
          ELSE (PO.SOURCE_CONTACT_INFO)
        END
     AS SALUTATION1,
     CASE  WHEN (PO.SOURCE_CONTACT_INFO is null)
         THEN 'To whom it may concern'
         WHEN (PO.SOURCE_CONTACT_INFO = 'To whom it may concern')
         THEN PO.SOURCE_CONTACT_INFO
          ELSE 'Dear: ' || (s.display_name)
        END
     AS SALUTATION2,
     CASE WHEN (PO.SOURCE_CONTACT_INFO = 'To whom it may concern')
         THEN '1'
         ELSE '0' end as GENERIC,
     CASE WHEN (UT.USER_TYPE = 'AUTHOR' OR UT.USER_TYPE = 'FREELANCER')
	THEN
	(SELECT WE.DESCRIPTION FROM AUTHOR_2_CW A2C JOIN USER_DEFAULTS UD ON A2C.CREATED_USER_ID = UD.USER_ID JOIN WILEY_ENTITY WE ON WE.CODE=UD.WILEY_ENTITY_CODE WHERE A2C.USER_ID=PO.CREATED_USER_ID AND A2C.CW_ID=PO.CW_ID)
	ELSE
	(SELECT WE.DESCRIPTION FROM USER_DEFAULTS UD JOIN WILEY_ENTITY WE ON WE.CODE=UD.WILEY_ENTITY_CODE WHERE UD.USER_ID=UT.ID)
      END
	AS WILEY_ENTITY,
     P.ID AS PRODUCT_ID,
     P.EXTERNAL_ID AS PRODUCT_EXTERNAL_ID,
     P.ISBN10 AS PRODUCT_ISBN10,
     P.ISBN13 AS PRODUCT_ISBN13,
     P.PNUMBER AS PRODUCT_PNUMBER,
     P.TITLE AS PRODUCT_TITLE,
     (select GROUP_CONCAT(last_name SEPARATOR ', ') from user_table where id in (select * from (select user_id from user_2_role where product_id=$P{PRODUCT_ID} and role_id in (1,6,8,9,16,29,38,42,45,64,77,87,93,101,128,131,132,135,137,138,139) limit 6)as id)) as AUTHOR,
     (select count(*) from user_table where id in(select user_id from user_2_role where product_id=$P{PRODUCT_ID} and role_id in (1,6,8,9,16,29,38,42,45,64,77,87,93,101,128,131,132,135,137,138,139))) as AUTHORCOUNT,
     P.SHORT_AUTHOR_NAME AS AUTHORSHORTNAME,
      DATE_FORMAT( P.CONSOLIDATED_RELEASE_DATE, '%m/%d/%Y') AS CONSOLIDATED_RELEASE_DATE,
     P.SHORT_TITLE AS PRODUCT_SHORT_TITLE,
     P.VOLUME AS PRODUCT_VOLUME,
     P.COPYRIGHT_YEAR AS PRODUCT_COPYRIGHT_YEAR,
     PO.ID AS PURCHASE_ORDER_ID,
     PO.ID AS PURCHASE_ORDER_NUMBER,
     PO.DATE AS PURCHASE_ORDER_DATE,
     PO.SOURCE_ID AS PURCHASE_ORDER_SOURCE_ID,
     PO.NOTE AS PURCHASE_ORDER_NOTE,
     PO.RETURN_ADDRESS AS PURCHASE_ORDER_RETURN_ADDRESS,
     PO.USER_SIGNATURE AS PURCHASE_ORDER_USER_SIGNATURE,
     PO.SHOW_ISBN AS PURCHASE_ORDER_SHOW_ISBN,
     PO.SHOW_COPYRIGHT_YEAR AS PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR,
     PO.SOURCE_CONTACT_INFO AS PO_CONTACT_INFO,

     PO.SOURCE_ADDRESS_INFO AS PO_ADDRESS_INFO,
     S.EXTERNAL_ID AS SOURCE_EXTERNAL_ID,
     TRIM(S.NAME) AS SOURCE_EXTERNAL_NAME,
     S.CREDIT_LINE as SOURCE_CREDIT_LINE,
     CONCAT (CONCAT (UP.FIRST_NAME, ' '), UP.LAST_NAME) AS AUTHOR2,
     s.DISPLAY_NAME as SOURCE_NAME
     FROM
     SOURCE S INNER JOIN PURCHASE_ORDER PO ON S.ID = PO.SOURCE_ID
	 JOIN USER_TABLE UT ON UT.ID = PO.CREATED_USER_ID,
     PRODUCT P
     left JOIN (select UR.PRODUCT_ID, U.* FROM USER_2_ROLE UR
     JOIN USER_TABLE U ON UR.USER_ID = U.ID
     AND UR.ROLE_ID = (select id from role where code = 'A' and role_type = 'AUTHOR')
     AND UR.PRODUCT_ID = $P{PRODUCT_ID} LIMIT 1) UP ON UP.PRODUCT_ID = P.ID
WHERE
     P.ID = $P{PRODUCT_ID}
 AND PO.ID = $P{PO_ID}]]>
	</queryString>
