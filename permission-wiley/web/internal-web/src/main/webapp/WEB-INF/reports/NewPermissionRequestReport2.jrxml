<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="NewPermissionRequestReport2" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="10" rightMargin="30" topMargin="5" bottomMargin="0" resourceBundle="ReportsBundle" uuid="b9c6922c-2fd1-4071-8d3a-eb815163645f">
