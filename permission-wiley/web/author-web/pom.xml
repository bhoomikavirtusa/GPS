                    <version>3.0.15</version>
                </dependency>
                <dependency>
                    <groupId>org.codehaus.plexus</groupId>
                    <artifactId>plexus-compiler-api</artifactId>
                    <version>2.6</version>
                </dependency>
                <dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports</artifactId>
			<version>${jasper.version}</version>
		</dependency>
		<dependency>
    <groupId>org.olap4j</groupId>
    <artifactId>olap4j</artifactId>
    <version>1.2.0</version>
</dependency>
<!-- https://mvnrepository.com/artifact/commons-lang/commons-lang -->
<dependency>
    <groupId>commons-lang</groupId>
    <artifactId>commons-lang</artifactId>
    <version>2.6</version>
</dependency>

		
            </dependencies>
	            
	            <executions>
	                <execution>
	                    <phase>process-sources</phase>
	                    <goals>
	                    	<goal>jasper</goal>
	                    </goals>
	                </execution>
	            </executions>
	            <configuration>
	            	<sourceDirectory>src/main/webapp/WEB-INF/reports</sourceDirectory>
	                <outputDirectory>${project.build.directory}/${project.build.finalName}/WEB-INF/reports/compiled</outputDirectory>                    
	            </configuration>
	        </plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>${maven.war.version}</version>
				<configuration>
					<outputDirectory>${perm.tomcat.apps.dir}</outputDirectory>
					<warName>${project.artifactId}</warName>
				</configuration>
			</plugin>

			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>
			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>${maven.antrun.version}</version>
				<executions>
					<execution>
						<phase>process-resources</phase>
						
						<configuration>
							<target>
								<echo>Copying from shared-web to ${project.artifactId}...</echo>

								<!-- The compilation phase is unpredictable, we have to copy before compilation-->
								<copy todir="${project.build.directory}/${project.build.finalName}" >
  									<!-- for some reason "${project.parent.basedir}/shared-web/copy" does not work -->
  									<!-- Exclude shared stub header: war plugin 3.x is first-win / up-to-date and will keep it -->
  									<fileset dir="${basedir}/../shared-web/src/main/webapp">
    									<include name="**/*.*" />
    									<exclude name="WEB-INF/tiles/templates/main/header.jspx" />
  									</fileset>
								</copy>
								<!-- Force this module's real header into the webapp (beats leftover shared stub on dirty builds) -->
								<copy file="${basedir}/src/main/webapp/WEB-INF/tiles/templates/main/header.jspx"
									tofile="${project.build.directory}/${project.build.finalName}/WEB-INF/tiles/templates/main/header.jspx"
									overwrite="true"
									failonerror="true"/>
							</target>
						</configuration>

						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
