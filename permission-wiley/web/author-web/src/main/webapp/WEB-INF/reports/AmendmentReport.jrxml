<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AmendmentReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" resourceBundle="ReportsBundle">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center" lineSpacing="Single"/>
	<parameter name="PRODUCT_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="CONTRACT_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="SOURCE_CONNECTION" class="java.sql.Connection" isForPrompting="false"/>
	<parameter name="assetsSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     P.ID AS PRODUCT_ID,
     P.EXTERNAL_ID AS PRODUCT_EXTERNAL_ID,
     P.ISBN10 AS PRODUCT_ISBN10,
     P.ISBN13 AS PRODUCT_ISBN13,
     P.PNUMBER AS PRODUCT_PNUMBER,
     P.TITLE AS PRODUCT_TITLE,
     P.SHORT_TITLE AS PRODUCT_SHORT_TITLE,
     P.VOLUME AS PRODUCT_VOLUME,
     A.NOTE,
     S.EXTERNAL_ID AS SOURCE_EXTERNAL_ID,
     S.NAME AS SOURCE_NAME,
     WE.DESCRIPTION AS WILEY_ENTITY,
     CONCAT (CONCAT (UP.FIRST_NAME, ' '), UP.LAST_NAME) AS AUTHOR
     FROM
     SOURCE S INNER JOIN CONTRACT C ON S.ID = C.SOURCE_ID INNER JOIN AMENDMENT A ON A.CONTRACT_ID=$P{CONTRACT_ID}
     JOIN USER_TABLE UT ON UT.ID = C.CREATED_USER_ID JOIN USER_DEFAULTS UD ON UT.ID = UD.USER_ID JOIN WILEY_ENTITY WE ON WE.CODE = UD.WILEY_ENTITY_CODE,
     PRODUCT P
     left JOIN (select UR.PRODUCT_ID, U.* FROM USER_2_ROLE UR
     JOIN USER_TABLE U ON UR.USER_ID = U.ID
     AND UR.ROLE_ID=(select id from role where code = 'A' and role_type = 'AUTHOR')
     AND UR.PRODUCT_ID=$P{PRODUCT_ID} LIMIT 1) UP ON UP.PRODUCT_ID = P.ID
WHERE
     P.ID = $P{PRODUCT_ID}
 AND C.ID = $P{CONTRACT_ID}]]>
	</queryString>
	<field name="PRODUCT_ID" class="java.lang.Integer"/>
	<field name="PRODUCT_EXTERNAL_ID" class="java.lang.String"/>
	<field name="PRODUCT_ISBN10" class="java.lang.String"/>
	<field name="PRODUCT_ISBN13" class="java.lang.String"/>
	<field name="PRODUCT_PNUMBER" class="java.lang.String"/>
	<field name="PRODUCT_TITLE" class="java.lang.String"/>
	<field name="PRODUCT_SHORT_TITLE" class="java.lang.String"/>
	<field name="PRODUCT_VOLUME" class="java.lang.String"/>
	<field name="NOTE" class="java.lang.String"/>
	<field name="SOURCE_EXTERNAL_ID" class="java.lang.String"/>
	<field name="SOURCE_NAME" class="java.lang.String"/>
	<field name="WILEY_ENTITY" class="java.lang.String"/>
	<field name="AUTHOR" class="java.lang.String"/>
	<variable name="ASSETS" class="java.lang.String"/>
	<variable name="CONTEXT" class="java.lang.String">
		<variableExpression><![CDATA["Notwithstanding the foregoing, Wiley and Licensor agree that it would be impracticable and extremely " +
