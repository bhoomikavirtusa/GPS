		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="PRODUCT_SHORT_TITLE" class="java.lang.String"/>
	<field name="PRODUCT_VOLUME" class="java.lang.String"/>
	<field name="PRODUCT_COPYRIGHT_YEAR" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_NUMBER" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_DATE" class="java.sql.Timestamp"/>
	<field name="PURCHASE_ORDER_SOURCE_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_NOTE" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_RETURN_ADDRESS" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_USER_SIGNATURE" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_SHOW_ISBN" class="java.lang.Boolean"/>
	<field name="PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR" class="java.lang.Boolean"/>
	<field name="PO_CONTACT_INFO" class="java.lang.String"/>
	<field name="PO_ADDRESS_INFO" class="java.lang.String"/>
	<field name="SOURCE_EXTERNAL_ID" class="java.lang.String"/>
	<field name="SOURCE_EXTERNAL_NAME" class="java.lang.String"/>
	<field name="SOURCE_CREDIT_LINE" class="java.lang.String"/>
	<field name="SOURCE_NAME" class="java.lang.String"/>
	<variable name="PREPRE" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{GENERIC}.equals("1") ) ?
        $R{pr.text7}
        :
        "")
+
(    ($F{GENERIC}.equals("0") ) ?
         $R{pr.text6} + $F{SOURCE_NAME}
        :
        "")
)]]></variableExpression>
	</variable>
	<variable name="PREFACE" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{PRODUCT_TITLE} != null && !$F{PRODUCT_TITLE}.isEmpty()) ?
       $R{pr.preface.text1}  + $F{PRODUCT_TITLE}
        :
        "")
    +
(    ($F{AUTHOR} != null && !$F{AUTHOR}.isEmpty()) ?
         "\n" + $R{pr.preface.text2} + " " + $F{AUTHOR}
        :
        "")
    +
(    ( $F{PURCHASE_ORDER_SHOW_ISBN} && $F{PRODUCT_ISBN13} != null && !$F{PRODUCT_ISBN13}.isEmpty() ) ?
        "\n" + $R{pr.preface.text3} + "       " + $F{PRODUCT_ISBN13}
        :
        "")
    +
(    ($F{WILEY_ENTITY} != null && !$F{WILEY_ENTITY}.isEmpty()) ?
        "\n" + $R{pr.preface.text4} + $F{WILEY_ENTITY} + "(WILEY)"
        :
        "")
    +
(    ($F{PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR} && $F{PRODUCT_COPYRIGHT_YEAR} != null) ?
        $R{pr.preface.text5} + " " + $F{PRODUCT_COPYRIGHT_YEAR}
        :
        "")
    +
(    (!$F{PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR} && $F{CONSOLIDATED_RELEASE_DATE} != null ) ?
        $R{pr.preface.text6} + " " + $F{CONSOLIDATED_RELEASE_DATE}
        :
        "")
)]]></variableExpression>
	</variable>
