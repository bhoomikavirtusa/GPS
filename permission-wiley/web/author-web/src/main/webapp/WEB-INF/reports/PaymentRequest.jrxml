	<parameter name="detailsSubReport" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT
	 INV.SOURCE_ID AS INVOICE_SOURCE_ID,
     INV.ID AS INVOICE_ID,
     INV.NUMBER AS INVOICE_NUMBER,
     INV.DATE AS INVOICE_DATE,
     INV.PRICE AS INVOICE_PRICE,
     INV.CURRENCY AS INVOICE_CURRENCY,
     INV.PURCHASE_ORDER_ID AS INVOICE_PURCHASE_ORDER_ID,
     PR.COST_CENTER AS PAYMENT_REQUEST_COST_CENTER,
     ACCT.ACCT_NUMBER AS PAYMENT_REQUEST_ACCT_NUMBER,
     ACCT.SUB_CODE AS PAYMENT_REQUEST_SUB_CODE,
     PO.ID AS PURCHASE_ORDER_NUMBER,
     PR.DATE_SUBMITTED AS PAYMENT_REQUEST_DATE_SUBMITTED,
     SRC.EXTERNAL_ID AS SOURCE_EXTERNAL_ID
FROM
     PAYMENT_REQUEST PR INNER JOIN CONTRACT INV ON PR.CONTRACT_ID = INV.ID
     LEFT JOIN PURCHASE_ORDER PO ON INV.PURCHASE_ORDER_ID = PO.ID
     LEFT JOIN SOURCE SRC ON SRC.ID = INV.SOURCE_ID
     LEFT JOIN ACCOUNT ACCT ON ACCT.ID = PR.ACCOUNT_ID
WHERE
     PR.ID = $P{PR_ID}]]>
	</queryString>
