<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="POAssetsReport2" pageWidth="555" pageHeight="200" columnWidth="100" leftMargin="1" rightMargin="1" topMargin="1" bottomMargin="1" resourceBundle="ReportsBundle">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PO_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
       CHAR(13,10) as CFLF,
       CASE  WHEN (select name from component where id = AU.COMPONENT_ID) is null
         THEN 'N/A'
          ELSE (select name from component where id = AU.COMPONENT_ID)
        END
     AS AU_COMPONENT,
     AU.PERMISSION_STATUS AS AU_PERMISSION_STATUS,
     AU.PERMISSION_COMMENT AS AU_PERMISSION_COMMENT,
     AU.CAPTION AS AU_CAPTION,
     AU.REUSED_FROM_PREV_ED AS AU_REUSED_FROM_PR,
     AU.CAMERA_COPY_TO_COME AS AU_CAMERA_COPY_TO,
     AU.IS_CANCELED AS AU_IS_CANCELED,
     AU.MEDIA_RETURN_REQ AS AU_MEDIA_RETURN_R,
     CASE  WHEN AU.IS_COLOR is null
         THEN 0
          ELSE AU.IS_COLOR
     END AS AU_IS_COLOR,
     A.ARTIST AS ASSET_ARTIST,
       CASE  WHEN A.CREDIT_LINE is null
         THEN ''
          ELSE A.CREDIT_LINE
        END
     AS ASSET_CREDIT_LINE,
     A.ID AS ASSET_ID,
     A.IS_FEE_REQUIRED AS ASSET_IS_FEE_REQUIRED,
     A.IS_RESTRICTED_USE AS ASSET_IS_RESTRICTED_USE,
     A.IS_MANAGED AS ASSET_IS_MANAGED,
     A.DESCRIPTION AS ASSET_DESCRIPTION,
    CASE  WHEN A.ORIGINAL_PUBLICATION_TITLE is null
         THEN ''
          ELSE A.ORIGINAL_PUBLICATION_TITLE
        END
      AS ASSET_PUBLICATION_TITLE,
    CASE  WHEN  A.ORIGINAL_PUBLICATION_AUTHOR is null
         THEN ''
          ELSE  A.ORIGINAL_PUBLICATION_AUTHOR
        END
      AS ASSET_PUBLICATION_AUTHOR,
     CASE  WHEN   A.ORIGINAL_PUBLICATION_ISBN is null
         THEN ''
          ELSE   A.ORIGINAL_PUBLICATION_ISBN
        END
      AS ASSET_PUBLICATION_ISBN,
     CASE  WHEN   A.ORIGINAL_FIGURE_NUMBER is null
         THEN ''
          ELSE   A.ORIGINAL_FIGURE_NUMBER
        END
       AS ASSET_FIGURE_NUMBER,
    CASE  WHEN    A.ORIGINAL_PAGE_NUMBER is null
         THEN ''
          ELSE    A.ORIGINAL_PAGE_NUMBER
        END
      AS ASSET_PAGE_NUMBER,
     CASE  WHEN ( A.FROM_1 is null)
         THEN ''
          ELSE (A.FROM_1)
        END AS ASSET_FROM_1,
     CASE  WHEN ( A.FROM_2 is null)
         THEN ''
          ELSE (A.FROM_2)
        END AS ASSET_FROM_2,
     CASE  WHEN ( A.FROM_3 is null)
         THEN ''
          ELSE (A.FROM_3)
        END  AS ASSET_FROM_3,
    CASE  WHEN (  A.TO_1 is null)
         THEN ''
          ELSE ( A.TO_1)
        END  AS ASSET_TO_1,
     CASE  WHEN (  A.TO_2 is null)
         THEN ''
          ELSE ( A.TO_2)
        END  ASSET_TO_2,
    CASE  WHEN (  A.TO_3 is null)
         THEN ''
          ELSE ( A.TO_3)
        END AS ASSET_TO_3,
     CASE  WHEN A.VENDOR_ID is null
         THEN ''
          ELSE A.VENDOR_ID
        END
     AS ASSET_VENDOR_ID,
     A.MEDIA_TYPE AS ASSET_MEDIA_TYPE,
       CASE  WHEN A.CITATION is null
         THEN ''
          ELSE A.CITATION
        END
     AS ASSET_CITATION,
        CASE  WHEN A.BIBLIO is null
         THEN ''
          ELSE A.BIBLIO
        END
     AS ASSET_BIBLIO,
     AU.ASSET_ID AS AU_ASSET_ID,
     PO2A.PURCHASE_ORDER_ID AS PURCHASE_ORDER_2_ASSET_PURCHAS,
     PO2A.ASSET_BASE_ID AS PURCHASE_ORDER_2_ASSET_ASSET_B,
     PO2A.COPY_ATTACHED AS COPY_ATTACHED,
     PO.SHOW_ESTIMATED_COST AS SHOW_COST,
     AU.ESTIMATED_COST AS AU_COST,
     AF.DATA AS ASSET_IMAGE
FROM
      PURCHASE_ORDER_2_ASSET PO2A
     INNER JOIN ASSET A ON A.ID = PO2A.ASSET_BASE_ID
     INNER JOIN ASSET_USE AU ON A.ID = AU.ASSET_ID
     INNER JOIN PURCHASE_ORDER PO ON PO.ID = $P{PO_ID}
     LEFT JOIN ASSET_FILE AF on A.ID = AF.ASSET_ID AND RENDITION_TYPE = 'medium_th'
WHERE
	PO2A.PURCHASE_ORDER_ID = $P{PO_ID} AND
    AU.IS_CANCELED <> 1 AND
	AU.CW_ID = $P{CW_ID}
    ORDER BY A.DESCRIPTION]]>
	</queryString>
	<field name="CFLF" class="java.lang.String"/>
	<field name="AU_COMPONENT" class="java.lang.String"/>
	<field name="AU_PERMISSION_STATUS" class="java.lang.String"/>
	<field name="AU_PERMISSION_COMMENT" class="java.lang.String"/>
	<field name="AU_CAPTION" class="java.lang.String"/>
	<field name="AU_REUSED_FROM_PR" class="java.lang.Integer"/>
	<field name="AU_CAMERA_COPY_TO" class="java.lang.Integer"/>
	<field name="AU_IS_CANCELED" class="java.lang.Integer"/>
	<field name="AU_MEDIA_RETURN_R" class="java.lang.Integer"/>
	<field name="AU_IS_COLOR" class="java.lang.Integer"/>
	<field name="ASSET_ID" class="java.lang.Integer"/>
	<field name="ASSET_ARTIST" class="java.lang.String"/>
	<field name="ASSET_CREDIT_LINE" class="java.lang.String"/>
	<field name="ASSET_IS_FEE_REQUIRED" class="java.lang.Integer"/>
	<field name="ASSET_IS_RESTRICTED_USE" class="java.lang.Integer"/>
	<field name="ASSET_IS_MANAGED" class="java.lang.Integer"/>
	<field name="ASSET_DESCRIPTION" class="java.lang.String"/>
	<field name="ASSET_PUBLICATION_TITLE" class="java.lang.String"/>
	<field name="ASSET_PUBLICATION_AUTHOR" class="java.lang.String"/>
	<field name="ASSET_PUBLICATION_ISBN" class="java.lang.String"/>
	<field name="ASSET_FIGURE_NUMBER" class="java.lang.String"/>
	<field name="ASSET_PAGE_NUMBER" class="java.lang.String"/>
	<field name="ASSET_FROM_1" class="java.lang.String"/>
	<field name="ASSET_FROM_2" class="java.lang.String"/>
	<field name="ASSET_FROM_3" class="java.lang.String"/>
	<field name="ASSET_TO_1" class="java.lang.String"/>
	<field name="ASSET_TO_2" class="java.lang.String"/>
	<field name="ASSET_TO_3" class="java.lang.String"/>
	<field name="ASSET_VENDOR_ID" class="java.lang.String"/>
	<field name="ASSET_MEDIA_TYPE" class="java.lang.String"/>
	<field name="ASSET_CITATION" class="java.lang.String"/>
	<field name="ASSET_BIBLIO" class="java.lang.String"/>
	<field name="AU_ASSET_ID" class="java.lang.Integer"/>
	<field name="AU_COST" class="java.math.BigDecimal"/>
	<field name="PURCHASE_ORDER_2_ASSET_PURCHAS" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_2_ASSET_ASSET_B" class="java.lang.Integer"/>
	<field name="COPY_ATTACHED" class="java.lang.Integer"/>
	<field name="SHOW_COST" class="java.lang.Integer"/>
	<field name="ASSET_IMAGE" class="java.io.InputStream"/>
	<variable name="OriginalPublisher2" class="java.lang.String">
		<variableExpression><![CDATA[(    ($F{ASSET_FROM_1} != null && !$F{ASSET_FROM_1}.isEmpty()) ?
        $R{po.asset.publisher.from} +$F{ASSET_FROM_1}
        :
        "")
    +
(    ($F{ASSET_TO_1} != null && !$F{ASSET_TO_1}.isEmpty()) ?
        $R{po.asset.publisher.to} +$F{ASSET_TO_1}
        :
        "")
    +
(    ($F{ASSET_FROM_2} != null & !$F{ASSET_FROM_2}.isEmpty()) ?
        $R{po.asset.publisher.from} +$F{ASSET_FROM_2}
        :
        "")
    +
(    ($F{ASSET_FROM_2} != null && !$F{ASSET_TO_2}.isEmpty()) ?
        $R{po.asset.publisher.to} +$F{ASSET_TO_2}
        :
        "")
    +
(    ($F{ASSET_FROM_3} != null && !$F{ASSET_FROM_3}.isEmpty()) ?
        $R{po.asset.publisher.from} +$F{ASSET_FROM_3}
        :
        "")
    +
(    ($F{ASSET_TO_3} != null && !$F{ASSET_TO_3}.isEmpty()) ?
        $R{po.asset.publisher.to} +$F{ASSET_TO_3}
        :
        "")]]></variableExpression>
	</variable>
	<variable name="DetailType" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{ASSET_MEDIA_TYPE}.equals("Photo") || $F{ASSET_MEDIA_TYPE}.equals("Map") ||
				$F{ASSET_MEDIA_TYPE}.equals("Cartoon") || $F{ASSET_MEDIA_TYPE}.equals("Illustration") || $F{ASSET_MEDIA_TYPE}.equals("Graph")) ?
        "1"
        :
        "")
+
(    ($F{ASSET_MEDIA_TYPE}.equals("Text") || $F{ASSET_MEDIA_TYPE}.equals("Extract") || $F{ASSET_MEDIA_TYPE}.equals("Article")) ?
        "2"
        :
        "")
+
(    (!$F{ASSET_MEDIA_TYPE}.equals("Photo")) &&
     (!$F{ASSET_MEDIA_TYPE}.equals("Map")) &&
     (!$F{ASSET_MEDIA_TYPE}.equals("Cartoon")) &&
     (!$F{ASSET_MEDIA_TYPE}.equals("Illustration")) &&
     (!$F{ASSET_MEDIA_TYPE}.equals("Graph")) &&
     (!$F{ASSET_MEDIA_TYPE}.equals("Text")) &&
     (!$F{ASSET_MEDIA_TYPE}.equals("Article")) &&
     (!$F{ASSET_MEDIA_TYPE}.equals("Extract")) ?
        "3"
        :
        "")
)]]></variableExpression>
	</variable>
	<variable name="AssetTypeDetail1" class="java.lang.String">
		<variableExpression><![CDATA[((    ($V{DetailType}.equals("1")) ?
        $R{pr.asset.detail1.text1} + $F{ASSET_DESCRIPTION} + " "
        :
        "")
+
(   ($F{ASSET_ARTIST} != null && !$F{ASSET_ARTIST}.isEmpty() ) ?
        $R{pr.asset.detail1.text2} + $F{ASSET_ARTIST} + " "
        :
        "")
+
(   (!$F{ASSET_VENDOR_ID}.isEmpty()  )  ?
        $R{pr.asset.detail1.text3} +$F{ASSET_VENDOR_ID}  + " "
        :
        "")
 +

(    ($F{COPY_ATTACHED}== 1) ?
        $F{CFLF} + $R{pr.asset.detail1.text4}
        :
        "")
+
( ($F{ASSET_CREDIT_LINE} != null && !$F{ASSET_CREDIT_LINE}.isEmpty() ) ?
        $F{CFLF} + $R{pr.asset.detail1.text5}
        + $F{CFLF} + $F{ASSET_CREDIT_LINE}
        :
        "")
)]]></variableExpression>
	</variable>
	<variable name="AssetTypeDetail2" class="java.lang.String">
		<variableExpression><![CDATA[((

    ($V{DetailType}.equals("2")) ?
        $R{pr.asset.detail2.text1} + $F{ASSET_DESCRIPTION} + " "
        :
        "")
+
( ($F{ASSET_PUBLICATION_TITLE} != null && !$F{ASSET_PUBLICATION_TITLE}.isEmpty() ) ?
         $F{CFLF} + $R{pr.asset.detail2.text2} + $F{ASSET_PUBLICATION_TITLE}
        :
        "")
   +
(    ($F{ASSET_PUBLICATION_ISBN} != null && !$F{ASSET_PUBLICATION_ISBN}.isEmpty()) ?
        " (" + $F{ASSET_PUBLICATION_ISBN} + ")"
        :
        "")
    +
(    ($F{ASSET_PUBLICATION_AUTHOR} != null && !$F{ASSET_PUBLICATION_AUTHOR}.isEmpty()) ?
        $R{pr.asset.detail2.text3} + $F{ASSET_PUBLICATION_AUTHOR}
        :
        "")

  +
(    ($F{ASSET_PAGE_NUMBER} != null && !$F{ASSET_PAGE_NUMBER}.isEmpty()
         && ($V{OriginalPublisher2} == null || $V{OriginalPublisher2}.isEmpty()) ) ?
        $R{pr.asset.detail2.text4} + $F{ASSET_PAGE_NUMBER}
        :
        "")

    +

(    ($F{ASSET_FIGURE_NUMBER}!= null && !$F{ASSET_FIGURE_NUMBER}.isEmpty()) ?
        $R{pr.asset.detail2.text5} + $F{ASSET_FIGURE_NUMBER}
        :
        "")
   +

(    ($V{OriginalPublisher2} != null && !$V{OriginalPublisher2}.isEmpty()) ?
        $F{CFLF} + $V{OriginalPublisher2}
        :
        "")
+
(     (!$F{ASSET_CITATION}.isEmpty()) ?
       $F{CFLF} + $R{pr.asset.detail2.text6} + $F{ASSET_CITATION}
        :
        "")
 +
(    (!$F{ASSET_BIBLIO}.isEmpty()) ?
        $R{pr.asset.detail2.text7} +$F{ASSET_BIBLIO}
        :
        "")
 +

(    ($F{COPY_ATTACHED}== 1 ) ?
        $F{CFLF} + $R{pr.asset.detail2.text8}
        :
        "")

)]]></variableExpression>
	</variable>
	<variable name="AssetTypeDetail3" class="java.lang.String">
		<variableExpression><![CDATA[((

     ($V{DetailType}.equals("3")) ?
        $F{ASSET_MEDIA_TYPE} + $R{pr.asset.detail3.text1} + $F{ASSET_DESCRIPTION} + " "
        :
        "")
+
(   ($F{ASSET_ARTIST} != null && !$F{ASSET_ARTIST}.isEmpty()) ?
        $F{CFLF} + $R{pr.asset.detail3.text2} + $F{ASSET_ARTIST} + " "
        :
        "")
+
(   (!$F{ASSET_VENDOR_ID}.isEmpty() )  ?
        $R{pr.asset.detail3.text3} +$F{ASSET_VENDOR_ID}  + " "
        :
        "")
+
( ($F{ASSET_PUBLICATION_TITLE} != null && !$F{ASSET_PUBLICATION_TITLE}.isEmpty() ) ?
         $F{CFLF} + $R{pr.asset.detail3.text4} + $F{ASSET_PUBLICATION_TITLE}
        :
        "")
   +
(    ($F{ASSET_PUBLICATION_ISBN} != null && !$F{ASSET_PUBLICATION_ISBN}.isEmpty()) ?
        " (" + $F{ASSET_PUBLICATION_ISBN} + ")"
        :
        "")
    +
(    ($F{ASSET_PUBLICATION_AUTHOR} != null && !$F{ASSET_PUBLICATION_AUTHOR}.isEmpty()) ?
        $R{pr.asset.detail3.text5} + $F{ASSET_PUBLICATION_AUTHOR}
        :
        "")
    +
(    ($F{ASSET_PAGE_NUMBER} != null && !$F{ASSET_PAGE_NUMBER}.isEmpty()
         && ($V{OriginalPublisher2} == null || $V{OriginalPublisher2}.isEmpty()) ) ?
        $R{pr.asset.detail3.text6} + $F{ASSET_PAGE_NUMBER}
        :
        "")


   +
(    ($V{OriginalPublisher2} != null && !$V{OriginalPublisher2}.isEmpty()) ?
        $V{OriginalPublisher2}
        :
        "")
    +

(    ($F{ASSET_FIGURE_NUMBER}!= null && !$F{ASSET_FIGURE_NUMBER}.isEmpty()) ?
        $R{pr.asset.detail3.text7} + $F{ASSET_FIGURE_NUMBER}
        :
        "")
 +

(    ($F{COPY_ATTACHED}== 1 ) ?
        $F{CFLF} + $R{pr.asset.detail3.text8}
        :
        "")
+
( ($F{ASSET_CREDIT_LINE} != null && !$F{ASSET_CREDIT_LINE}.isEmpty() ) ?
        $F{CFLF} + $R{pr.asset.detail3.text9}
        + $F{CFLF} + $F{ASSET_CREDIT_LINE}
        :
        "")

)]]></variableExpression>
	</variable>
	<variable name="mainDetailLine" class="java.lang.String">
		<variableExpression><![CDATA[((

  ($V{DetailType}.equals("1")) ?
        $V{AssetTypeDetail1}
        :
        "")
+
(    ($V{DetailType}.equals("2")) ?
        $V{AssetTypeDetail2}
        :
        "")
+
(    ($V{DetailType}.equals("3")) ?
        $V{AssetTypeDetail3}
        :
        "")

)]]></variableExpression>
	</variable>
	<group name="AssetDetailGroup" minHeightToStartNewPage="200">
		<groupExpression><![CDATA[$F{ASSET_DESCRIPTION}]]></groupExpression>
		<groupHeader>
			<band height="11" splitType="Stretch">
				<line>
					<reportElement positionType="Float" x="1" y="5" width="540" height="1"/>
				</line>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="15" splitType="Stretch"/>
		</groupFooter>
	</group>
	<detail>
		<band height="54" splitType="Stretch">
			<textField isStretchWithOverflow="true" pattern="" isBlankWhenNull="true">
				<reportElement positionType="Float" isPrintRepeatedValues="false" x="7" y="3" width="400" height="14" isRemoveLineWhenBlank="true"/>
				<textElement lineSpacing="Single" markup="none">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$V{mainDetailLine}]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" isLazy="true" onErrorType="Blank">
				<reportElement stretchType="RelativeToTallestObject" isPrintRepeatedValues="false" x="431" y="0" width="59" height="47" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[$F{ASSET_IMAGE} != null]]></printWhenExpression>
				</reportElement>
				<imageExpression class="java.io.InputStream"><![CDATA[$F{ASSET_IMAGE}]]></imageExpression>
			</image>
		</band>
	</detail>
</jasperReport>
