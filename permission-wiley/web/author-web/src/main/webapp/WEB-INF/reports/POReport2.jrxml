<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="POReport2" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="10" bottomMargin="0" resourceBundle="ReportsBundle">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center" lineSpacing="Single"/>
	<parameter name="PRODUCT_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="PO_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="SOURCE_CONNECTION" class="java.sql.Connection" isForPrompting="false"/>
	<parameter name="sourceSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="assetsSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="CW_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     P.EXTERNAL_ID AS PRODUCT_EXTERNAL_ID,
     P.ISBN10 AS PRODUCT_ISBN10,
     P.ISBN13 AS PRODUCT_ISBN13,
     P.PNUMBER AS PRODUCT_PNUMBER,
     P.TITLE AS PRODUCT_TITLE,
     P.SHORT_TITLE AS PRODUCT_SHORT_TITLE,
     P.VOLUME AS PRODUCT_VOLUME,
     P.SHORT_AUTHOR_NAME AS AUTHOR,
     P.COPYRIGHT_YEAR AS PRODUCT_COPYRIGHT_YEAR,
      DATE_FORMAT( P.CONSOLIDATED_RELEASE_DATE, '%m/%d/%Y') AS CONSOLIDATED_RELEASE_DATE,
     PO.SHOW_COPYRIGHT_YEAR AS PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR,
     PO.ID AS PURCHASE_ORDER_ID,
     PO.ESTIMATED_PRICE AS PO_ESTIMATED_PRICE,
     PO.ESTIMATED_CURRENCY AS PO_ESTIMATED_CURR,
     PO.ID AS PURCHASE_ORDER_NUMBER,
     PO.DATE AS PURCHASE_ORDER_DATE,
     PO.SOURCE_ID AS PURCHASE_ORDER_SOURCE_ID,
     PO.NOTE AS PURCHASE_ORDER_NOTE,
     PO.SOURCE_CONTACT_INFO AS PO_CONTACT_INFO,
     PO.SOURCE_ADDRESS_INFO AS PO_ADDRESS_INFO,
     X'0D' ||  X'0D' || S.NAME ||  X'0D' AS SOURCE_NAME,
     CASE WHEN (PO.SOURCE_CONTACT_INFO = 'To whom it may concern')
         THEN '1'
         ELSE '0' end as GENERIC,
     P.ID AS PRODUCT_ID,
     SUBSTRING_INDEX(SUBSTRING_INDEX(PO.RETURN_ADDRESS, X'0D', 8), X'0A', 8) AS PURCHASE_ORDER_RETURN_ADDRESS,
     PO.USER_SIGNATURE AS PURCHASE_ORDER_USER_SIGNATURE,
     PO.USER_SIGNATURE ||  X'0D' || SUBSTRING_INDEX(SUBSTRING_INDEX(PO.RETURN_ADDRESS, X'0D', 8), X'0A', 8) ||  X'0D' ||  X'0D' AS RETURN_NAME_AND_ADDRESS,
     PO.SHOW_ESTIMATED_COST AS PO_SHOW_ESTIMATED_COST,
     S.EXTERNAL_ID AS SOURCE_EXTERNAL_ID FROM
     SOURCE S INNER JOIN PURCHASE_ORDER PO ON S.ID = PO.SOURCE_ID,
     PRODUCT P
WHERE
     P.ID = $P{PRODUCT_ID}
 AND PO.ID = $P{PO_ID}]]>
	</queryString>
	<field name="PRODUCT_EXTERNAL_ID" class="java.lang.String"/>
	<field name="PRODUCT_ISBN10" class="java.lang.String"/>
	<field name="PRODUCT_ISBN13" class="java.lang.String"/>
	<field name="PRODUCT_PNUMBER" class="java.lang.String"/>
	<field name="PRODUCT_TITLE" class="java.lang.String"/>
	<field name="PRODUCT_SHORT_TITLE" class="java.lang.String"/>
	<field name="PRODUCT_COPYRIGHT_YEAR" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR" class="java.lang.Boolean"/>
	<field name="CONSOLIDATED_RELEASE_DATE" class="java.lang.String"/>
	<field name="PRODUCT_VOLUME" class="java.lang.String"/>
	<field name="AUTHOR" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_ID" class="java.lang.Integer"/>
	<field name="PO_ESTIMATED_PRICE" class="java.math.BigDecimal"/>
	<field name="PO_ESTIMATED_CURR" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_NUMBER" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_DATE" class="java.sql.Timestamp"/>
	<field name="PURCHASE_ORDER_SOURCE_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_NOTE" class="java.lang.String"/>
	<field name="PO_CONTACT_INFO" class="java.lang.String"/>
	<field name="PO_ADDRESS_INFO" class="java.lang.String"/>
	<field name="SOURCE_NAME" class="java.lang.String"/>
	<field name="GENERIC" class="java.lang.String"/>
	<field name="PRODUCT_ID" class="java.lang.Integer"/>
	<field name="PURCHASE_ORDER_RETURN_ADDRESS" class="java.lang.String"/>
	<field name="PURCHASE_ORDER_USER_SIGNATURE" class="java.lang.String"/>
	<field name="RETURN_NAME_AND_ADDRESS" class="java.lang.String"/>
	<field name="PO_SHOW_ESTIMATED_COST" class="java.lang.Boolean"/>
	<field name="SOURCE_EXTERNAL_ID" class="java.lang.String"/>
	<variable name="PREPRE" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{GENERIC}.equals("1") ) ?
        $F{RETURN_NAME_AND_ADDRESS} + $R{po.text7} + $F{SOURCE_NAME} + $F{PO_ADDRESS_INFO}
        :
        "")
+
(    ($F{GENERIC}.equals("0") ) ?
           $F{RETURN_NAME_AND_ADDRESS} + $F{PO_CONTACT_INFO} + $F{SOURCE_NAME} + $F{PO_ADDRESS_INFO}
        :
        "")
)]]></variableExpression>
	</variable>
	<variable name="NOTEHEADER" class="java.lang.String">
		<variableExpression><![CDATA[((    ($F{PURCHASE_ORDER_NOTE}.isEmpty() ) ?
        ""
        :
        $R{po.notes})
)]]></variableExpression>
	</variable>
	<variable name="TITLEINFO" class="java.lang.String">
		<variableExpression><![CDATA[(
    (($F{PRODUCT_TITLE}.isEmpty() ) ?
        ""
        :
        $F{PRODUCT_TITLE}
    )
    +
(    ($F{PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR} && $F{PRODUCT_COPYRIGHT_YEAR} != null &&  $F{PRODUCT_COPYRIGHT_YEAR} != 0) ?
        " / " + $R{po.text8} + " " + $F{PRODUCT_COPYRIGHT_YEAR}
        :
        "")
+
(    (!$F{PURCHASE_ORDER_SHOW_COPYRIGHT_YEAR} && $F{CONSOLIDATED_RELEASE_DATE} != null ) ?
        " / " +  $R{po.text9} + " " + $F{CONSOLIDATED_RELEASE_DATE}
        :
        "")
)]]></variableExpression>
	</variable>
