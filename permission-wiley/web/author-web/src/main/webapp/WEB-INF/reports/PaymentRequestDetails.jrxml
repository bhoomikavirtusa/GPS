<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PaymentRequestDetails" pageWidth="250" pageHeight="100" columnWidth="100" leftMargin="1" rightMargin="1" topMargin="1" bottomMargin="1">
	<style name="label" isDefault="false" forecolor="#333333" hAlign="Center" vAlign="Middle" isBlankWhenNull="true" fontSize="7"/>
	<parameter name="INVOICE_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     CNTR.ID AS CONTRACT_INVOICE_ID,
     C2A.ASSET_BASE_ID AS CONTRACT_2_ASSET_ASSET_BASE_ID,
     AB.EXTERNAL_ID AS ASSET_BASE_EXTERNAL_ID,
     A.DESCRIPTION AS ASSET_DESCRIPTION

FROM  CONTRACT CNTR LEFT JOIN CONTRACT_2_ASSET C2A ON CNTR.ID = C2A.CONTRACT_ID
     LEFT JOIN ASSET_BASE AB ON C2A.ASSET_BASE_ID = AB.ID
     LEFT JOIN ASSET A ON AB.ID = A.ID
WHERE
     CNTR.ID = $P{INVOICE_ID}]]>
	</queryString>
	<field name="CONTRACT_INVOICE_ID" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="CONTRACT_2_ASSET_ASSET_BASE_ID" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="ASSET_BASE_EXTERNAL_ID" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="ASSET_DESCRIPTION" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<pageHeader>
		<band height="29">
			<line>
				<reportElement x="3" y="26" width="234" height="1"/>
			</line>
			<staticText>
				<reportElement style="label" x="4" y="3" width="100" height="20"/>
				<textElement/>
				<text><![CDATA[NUMBER]]></text>
			</staticText>
			<staticText>
				<reportElement style="label" x="104" y="3" width="100" height="20"/>
				<textElement markup="styled"/>
				<text><![CDATA[DESCRITION]]></text>
			</staticText>
		</band>
	</pageHeader>
	<detail>
		<band height="26">
			<line>
				<reportElement x="3" y="22" width="234" height="1"/>
			</line>
			<textField hyperlinkType="None">
				<reportElement style="label" x="4" y="2" width="100" height="20"/>
				<textElement/>
			</textField>
			<textField hyperlinkType="None">
				<reportElement style="label" x="104" y="2" width="100" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{ASSET_DESCRIPTION}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
