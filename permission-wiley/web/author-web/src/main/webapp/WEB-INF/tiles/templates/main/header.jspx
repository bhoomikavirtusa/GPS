<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core">

	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<tiles:useAttribute name="title"/>
	<c:url var="guidelinesUrl" value="/sapp/guidelines/smalllist" />
	<c:url var="helpUrl" value="/static/help/index.html" />
	<c:url var="changePasswordUrl" value="/sapp/account/changePassword" />

<div id="uh">
	<div class="left" style="padding: 20px 0px 0px 20px;"> 
		<h1>
			<jsp:element name="img">
				<jsp:attribute name="src">
					<c:url value="/images/wiley-logo.png"/>
				</jsp:attribute>
				<jsp:attribute name="style">
					width:225px; 
				</jsp:attribute>				
				<jsp:attribute name="alt">Permissions</jsp:attribute>
			</jsp:element>
		</h1>
	</div>
	<div class="center">
		<div id="title">PERMISSIONS - ${title}</div>
		<div id="user"> Hello, ${userSession.currentUser.firstName}</div>
	</div>	
	<div id="swirl">
		<div> 
			<div id="profile">
				<!-- disable for now -->
				<!--
				|
				<a href="#">
					Help
				</a>
				-->
				<a href="${guidelinesUrl}" id="guidelinesLink">
					Permission Guidelines
				</a>
				|
				<a href="${helpUrl}" target="_blank" >
					Help
				</a>
				|
				<a id="changePasswordLink" href="${changePasswordUrl}">Change Password</a>
			</div>
		</div>
	</div>
</div>
<div id="guideDiv" style="display: none">
	<p style="font-size: 16pt">
	Loading...
	</p>
</div>
<script type="text/javascript">
//<![CDATA[
	// we might change this if we need dialogs for other actions in the page - we can reuse this one
	var guideDialog;

	$(document).ready(function() {
		createGuideDialog ();
	} );

	function createGuideDialog () 
	{
        $guideDialog = $("#guideDiv").dialog({
			autoOpen: false,
			modal: true,
			title: "Enter details for:",
			height: 'auto',
			// maxHeight: 700 , // not working
			width: 'auto',
			position: 'center'
	    });
		$("#guideDiv").css({'max-height': 700, 'max-width': 900, 'overflow-y': 'auto', 'overflow-x': 'auto'}); 
	}
	
	function openGuideDialog (title, b) {
		$guideDialog.dialog('option', 'title', title);
		$guideDialog.dialog({buttons: b});		
		$guideDialog.dialog("open");
		repositionGuideDialog();
	}
	
	function repositionGuideDialog () {
		$guideDialog.dialog('option', 'position', $guideDialog.dialog('option','position'));
	}
	
	$('#guidelinesLink').click(function() {
		$("#guideDiv").load('${guidelinesUrl}', function() {
			openGuideDialog ('Permissions Guidelines');
        });
		// prevent the default action, e.g., following a link
		return false;
	});

	$('#changePasswordLink').click(function() {
		$("#guideDiv").load('${changePasswordUrl}', function() {
			openGuideDialog('Change Password');
        });
		// prevent the default action, e.g., following a link
		return false;
	});

	// Log out
	function fnLogOut()
	{
	     if(confirm('Are you sure you want to Log out?') == true)
	    {
	        window.close();
	    }
	}
//]]>		
</script>
</jsp:root>
