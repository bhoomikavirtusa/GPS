		    </field>
		    <field property="date" depends="required">
		        <arg key="product.photo.estimate.date" position="0" />
		    </field>
		</form>
	</formset>

	<formset>
		<form name="importAssetsForm">
<!-- lnagy - file can be empty when we resubmit
		    <field property="file" depends="required">
