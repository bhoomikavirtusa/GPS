<form-validation>
	<formset>
		<form name="loginForm">
			<field property="credential" depends="required" >
				<arg key="login.credential" position="0"/>
			</field>
			<field property="password" depends="required" >
				<arg key="login.password" position="0"/>
			</field>
		</form>
	</formset>
    
    <formset>
		<form name="searchProductForm">
			<field property="searchString" depends="required">
				<arg key="product.searchString" position="0"/>
			</field>
		</form>
	</formset>
	
	<formset>
		<form name="purchaseOrderForm">
        	<field property="purchaseOrder.userSignature" depends="required">
				<arg key="purchaseOrder.userSignature" position="0"/>
			</field>
			<field property="purchaseOrder.returnAddress" depends="required">
				<arg key="purchaseOrder.returnAddress" position="0"/>
			</field>
		</form>

		<form name="contractForm">
			<field property="contract.date" depends="required">
				<arg key="invoice.date" position="0"/>
			</field>
			<field property="contract.price" depends="required">
				<arg key="invoice.price" position="0"/>
			</field>
		    <field property="contract.currency" depends="required">
				<arg key="invoice.currency" position="0"/>
			</field>
			
			<field property="contract.startDate" depends="required">
				<arg key="contract.startDate" position="0"/>
			</field>
		</form>
	</formset>
	
	<formset>
		<form name="manageAssetForm">
			<field property="assetUse.asset.description" depends="required">
				<arg key="assetUse.asset.description" position="0"/>
