<?xml version="1.0" encoding="UTF-8"?>
<taglib version="2.0"
	xmlns="http://java.sun.com/xml/ns/j2ee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee web-jsptaglibrary_2_0.xsd">
	
	<tlib-version>1.0</tlib-version>
	<short-name>wileyfn</short-name>
	<uri>http://permissions.wiley.com/tlds/functions</uri>

	<function>
		<name>contains</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>boolean contains(java.util.Collection, java.lang.Object)</function-signature>
	</function>

	<function>
		<name>size</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>int size(java.lang.Object)</function-signature>
	</function>
	
	<function>
		<name>filesize</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String filesize(byte[])</function-signature>
	</function>  

	<function>
		<name>formatBoolean</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String formatBoolean(java.lang.Object)</function-signature>
	</function>

	<function>
		<name>booleanClass</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String booleanClass(java.lang.Object)</function-signature>
	</function>
	
	<function>
		<name>booleanTD</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String booleanTD(java.lang.Object)</function-signature>
	</function>
	
	<function>
		<name>booleanSpan</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String booleanSpan(java.lang.Object)</function-signature>
	</function>

    <function>
        <name>truncate</name>
        <function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
	    <function-signature>String truncate(java.lang.Object, int, boolean)</function-signature>
    </function>

    <function>
        <name>escapeHtmlAndNewline</name>
        <function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
	    <function-signature>String escapeHtmlAndNewline(java.lang.Object)</function-signature>
    </function>

	<function>
		<name>isInstance</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>
			boolean isInstance(java.lang.Object, java.lang.String)
    	</function-signature>
	</function>

<!-- use security:authorize instead
	<function>
		<name>hasPrivilege</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>
			boolean hasPrivilege(javax.servlet.http.HttpServletRequest, java.lang.String)
		</function-signature>
	</function>

	<tag>
		<name>hasPrivilege</name>
		<tag-class>com.wiley.permissions.web.shared.util.SecurityTag</tag-class>
		<body-content>JSP</body-content>
		<attribute>
            <name>code</name>  
            <required>yes</required>  
            <rtexprvalue>no</rtexprvalue>  
        </attribute>  		
	</tag>
-->

	<function>
		<name>sourcesAsHTML</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String sourcesAsHTML (java.util.List)</function-signature>
	</function>

	<function>
		<name>sourceAsHTML</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String sourceAsHTML (java.lang.Object)</function-signature>
	</function>

	<function>
		<name>isActive</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String isActive (java.lang.Object)</function-signature>
	</function>

	<function>
		<name>isResultActive</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String isResultActive (java.lang.Object)</function-signature>
	</function>
	
	<function>
		<name>getRestUrl</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String getRestUrl(javax.servlet.http.HttpServletRequest)</function-signature>
	</function>
	
	<function>
		<name>getEnvironmentString</name>
		<function-class>com.wiley.permissions.web.shared.util.JSTLFunctions</function-class>
		<function-signature>String getEnvironmentString()</function-signature>
	</function>
	
</taglib>
