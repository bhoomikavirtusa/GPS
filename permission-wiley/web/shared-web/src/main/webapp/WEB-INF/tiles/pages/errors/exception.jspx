<?xml version="1.0" encoding="UTF-8"?>

<jsp:root 
	version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">

	<jsp:directive.page pageEncoding="UTF-8" />

	<tiles:importAttribute name="exception" ignore="true"/>

	<jsp:body>
		<c:if test="${not empty exception and wileyfn:isInstance(exception, 'java.lang.Throwable')}">
			<table cellspacing="0" class="exception">
				<tr>
					<th class="exception">
					    <c:choose>
					    <c:when test="${wileyfn:isInstance(exception, 'com.wiley.permissions.common.utils.PermBaseException') and exception.justShowExceptionMessage}">
					        ${exception.message}
					    </c:when>
					    <c:otherwise>
					    	<!-- Cannot say exception.class.name because class is illegal identifier in EL -->
						    ${exception['class'].name}: ${exception}
						</c:otherwise>
						</c:choose>
					</th>
				</tr>

                <c:if test="${not wileyfn:isInstance(exception, 'com.wiley.permissions.common.utils.PermBaseException') or not exception.justShowExceptionMessage}">
				<c:forEach items="${exception.stackTrace}" var="item">
					<tr>
						<td class="exception">
							${item}
						</td>
					</tr>
				</c:forEach>
				</c:if>
			</table>

            <c:if test="${not wileyfn:isInstance(exception, 'com.wiley.permissions.common.utils.PermBaseException') or not exception.justShowExceptionMessage}">
			<c:if test="${not empty exception.cause}">
				<br/>
				<tiles:insertDefinition name="tiles.errors.exception">
					<tiles:putAttribute name="exception" type="object" value="${exception.cause}"/>
				</tiles:insertDefinition>
			</c:if>
			</c:if>
		</c:if>
	</jsp:body>
</jsp:root>
