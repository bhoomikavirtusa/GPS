<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/custom/createSource" />

	<style type="text/css">
	.greybox {
		padding: 0px;
		border: 0px;
		background: transparent;
	}
	
	.ui-widget {
		background: #EEE;
	}
	
	#main {
		margin: 0px;
	}	
	</style>	

	<h3><c:out value="${extendedAssetUse.asset.description}" /></h3>

	<table>
		<tr>
			<td>
				Source name:
			</td>
			<td>
				${param.sourceName}
			</td>
		</tr>
	</table>

	<div class="error">
		<span class="error">Sorry, there are no details about this source in the system.<br/>
		Please enter address and contact information bellow.</span>
	</div>		

	<jsp:include page="/sapp/landing/createSource"/>
	
	<div class="buttonset">	
		<input type="submit" id="createB" value="Create"/> 
		<a href="#" id="cancelLink" class="button">Cancel</a> 	
	</div>

	<script type="text/javascript">
	//<![CDATA[
	var reg = /^[0-9]+(,[0-9]+)*$/;
	var errorReg = /^Error$/;
	
	$(document).ready(function() {	
		// set source name
		$("input[name='source.name']").val("${param.sourceName}");
		
		$('#createB').click (function() {
			if ($("#createSourceForm").validate({
			    rules: {
			        'contact.lastName': {
			            required: function() {
			                return ($("input[name='contact.email']").val() != '');
			            }
			        },
			        'contact.firstName': {
			            required: function() {
			               return ($("input[name='contact.email']").val() != '');
			            }
			        },
			        'contact.email': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val() == '' &&
			                		$("input[name='contactAddress.lineOne']").val() == '')
			            }
			        },
			        'address.lineOne': {
			            required: function() {
			                return ($("input[name='contact.email']").val() == '' && 
			                		$("input[name='contactAddress.lineOne']").val() == '');
			            }
			        },			        
			        'address.city': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val()!= '');
			            }
			        },			        
			        'address.postalCode': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val()!= '');
			            }
			        },			        
			        'address.country': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val()!= '');
			            }
			        },			        
	        		'contactAddress.lineOne': {
			            required: function() {
			                return ($("input[name='contact.email']").val() == '' && 
			                		$("input[name='address.lineOne']").val() == '');
			            }
			        },
			        'contactAddress.city': {
			            required: function() {
			                return ($("input[name='contactAddress.lineOne']").val()!= '');
			            }
			        },			        
			        'contactAddress.postalCode': {
			            required: function() {
			                return ($("input[name='contactAddress.lineOne']").val()!= '');
			            }
			        },			        
			        'contactAddress.country': {
			            required: function() {
			                return ($("input[name='contactAddress.lineOne']").val()!= '');
			            }
			        }						        	
			    },
			    invalidHandler: function(event, validator) {
				    // 'this' refers to the form
				    var errors = validator.numberOfInvalids();
					if (errors) {
				      var message = "You must enter at least a source address, a contact email or contact address.";
				      $("div.error span").html(message);
				      $("div.error").show();
				    } else {
				      $("div.error").hide();
				    }				    
				}
			}).form() == true) {
					$.ajax({
					async: true,
	            	type: 'post',
	            	url: '${nextUrl}',
	            	data: $('#createSourceForm').serialize(),
	            	dataType: 'json',
		            success: function (json) {
		            	if (json.error) {
	            			alert (json.error);	
		            	}
		            	try {
							for (var i=0, iLen = json.auids.length; i < iLen; i++) {
								var n = json.auids[i];
			            		if (${param.auId} <= 0) {
				            		// add the id to the selected ids so we can navigate back to the new entered ones
				            		var newRow = blankRow.slice();
				            		newRow[0] = n;
				            		// insert one row before last empty row
				            		var aNewRow = fnInsertBeforeLast (newRow, true);
				            		fnRefreshRow (aNewRow);
				            	} else {
			            			fnRefreshRowById (n);		            	
				            	}
							}
						} catch (err) {
							// ignore it, maybe log it
						}		            	
		            	if (json.url) {
							// redirect to url
			                $.ajax({
					            async: true,
					            type: 'get',
					            url: json.url,
					            dataType: 'html',
					            success: function (resp){			            
				            		$('#modalDiv').empty().html(resp);
				            		repositionDialog();
					            }
					        });		            	
		            	} else {
		            		$modalDialog.dialog("close");
		            	}
		            }
	    		});
		    }
		});
	});	
	//]]>		
	</script>	
</jsp:root>
