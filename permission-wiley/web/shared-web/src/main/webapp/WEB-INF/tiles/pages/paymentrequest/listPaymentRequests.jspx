<?xml version="1.0" encoding="UTF-8" ?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
>
	<c:url var="landingUrl" value="/sapp/cwlanding/main?cwId=${commonWork.id}" />
	<jsp:directive.include file="/WEB-INF/tiles/pages/include/js/modal.dialog.js.jspx" />
	
	<script type="text/javascript">
	$(document).ready(function() {
		$('#existingPRTable').dataTable( {
			"aoColumns": [
				<c:if test="${not commonWork.permissionComplete}">
				{ "sWidth" : "5%", "bSearchable" : false, "bSortable" : false, "sClass" : "center" }, // Edit
				</c:if>
				{ "sWidth" : "20%" }, // Source
				{ "sWidth" : "5%" }, // Number
				{ "sWidth" : "20%" }, // Date Submitted
				{ "sWidth" : "5%", "sClass" : "center" }, // Paid
				<c:if test="${not commonWork.permissionComplete}">
				{ "sWidth" : "10%", "sClass" : "center", "bSearchable" : false, "bSortable" : false }, // Pay/Cancel
				</c:if>
				{ "sWidth" : "10%", "sClass" : "center" }, // Cost Center
				{ "sWidth" : "10%", "sClass" : "center" }, // Account Number
				{ "sWidth" : "15%", "sClass" : "center" }, // Account Subcode
				{ "sWidth" : "5%", "sClass" : "center", "bSearchable" : false, "bSortable" : false } // Download
			 ],
			<c:if test="${not commonWork.permissionComplete}">
			"aaSorting": [[1, "asc" ], [3, "asc"]],
			</c:if>
			<c:if test="${commonWork.permissionComplete}">
			"aaSorting": [[0, "asc" ], [2, "asc"]],
			</c:if>

			"bAutoWidth": false,
			"bProcessing": true,
			// don't save state since column indexes can change and mess up sorting
			//"bStateSave": true,
			"sPaginationType": "full_numbers",
			"aLengthMenu": [10, 15, 25, 50, 100],  // override default of [10, 25, 50, 100]
			"iDisplayLength": 15 // overide default of 10
		} );
	} );
	</script>

	<script type="text/javascript">
	//<![CDATA[
	
	$('#prevC').click (function() {
		$.ajax({
            async: true,
            type: 'get',
            url: '${landingUrl}',
            success: function (response){
                // $('#modalDiv').empty().html(response);
                $modalDialog.dialog("close");
            }
        });
	});	

	
	//]]>
	</script>
	
<script type="text/javascript">
//<![CDATA[
		$(document).ready(function() {
			createModalDialog();
			dialogInfo=new Object();
			dialogInfo.title = 'Edit Payment Request';
			dialogInfo.UrlPaternSize = 2;
			dialogInfo.UrlPatern1 = "/paymentrequest/viewPaymentRequest";
			dialogInfo.UrlPatern2 = "/sources/viewSource/";
			initModalDialog (dialogInfo);
			
		} );
//]]>		
	</script>
	
	<jsp:body>
		<table class="display" id="existingPRTable">
			<thead>
				<tr>
					<c:if test="${not commonWork.permissionComplete}">
						<th>Edit</th>
					</c:if>
					<th>Source</th>
					<th>Number</th>
					<th>Date Submitted</th>
					<th>Paid</th>
					<c:if test="${not commonWork.permissionComplete}">
						<th>Pay/Cancel</th>
					</c:if>
					<th>Cost Center</th>
					<th>Account Number</th>
					<th>Account Subcode</th>
					<th>Download</th>
				</tr>
			</thead>
			<tbody>
				<c:forEach items="${paymentRequests}" var="paymentRequest">	
					<tr>
						<c:if test="${not commonWork.permissionComplete}">		
							<td>
								<jsp:element name="a">
									<jsp:attribute name="href">
										<c:url value="/sapp/permissions/paymentrequest/viewPaymentRequest?paymentRequestId=${paymentRequest.id}" />
									</jsp:attribute>
									<jsp:element name="img">
										<jsp:attribute name="alt">Edit</jsp:attribute>
										<jsp:attribute name="title">Edit</jsp:attribute>
										<jsp:attribute name="src">
											<c:url value="/images/buttons/edit-icon.png" />
										</jsp:attribute>
									</jsp:element>
								</jsp:element>
							</td>
						</c:if>
						
						<td>
							<c:url var="sourceUrl"
								value="/sapp/sources/viewSource/form?sourceId=${paymentRequest.contract.source.id}" />
							<a href="${sourceUrl}">${wileyfn:sourceAsHTML(paymentRequest.contract.source)}</a>
						</td>

						<td>${paymentRequest.number}</td>
						<td><fmt:formatDate type="date" value="${paymentRequest.dateSubmitted}" /></td>
						${wileyfn:booleanTD(paymentRequest.paid)}
						
						<c:if test="${not commonWork.permissionComplete}">
							<td>
								<jsp:element name="a">
									<jsp:attribute name="href">
										<c:choose>
											<c:when test="${paymentRequest.paid}">
												<c:url
													value="/sapp/permissions/paymentrequest/modifyPaymentRequest?paymentRequestId=${paymentRequest.id}&amp;paid=false" />
											</c:when>
											<c:otherwise>
												<c:url
													value="/sapp/permissions/paymentrequest/modifyPaymentRequest?paymentRequestId=${paymentRequest.id}&amp;paid=true" />
											</c:otherwise>
										</c:choose>
									</jsp:attribute>
									<jsp:element name="img">
										<jsp:attribute name="alt">
											<c:choose>
												<c:when test="${paymentRequest.paid}">Cancel</c:when>
												<c:otherwise>Pay</c:otherwise>
											</c:choose>
										</jsp:attribute>
										<jsp:attribute name="src">
											<c:choose>
												<c:when test="${paymentRequest.paid}">
													<c:url value="/images/buttons/delete-icon.png" />
												</c:when>
												<c:otherwise>
													<c:url value="/images/buttons/add-icon.png" />
												</c:otherwise>
											</c:choose>
										</jsp:attribute>
									</jsp:element>
								</jsp:element>
							</td>
						</c:if>
						
						<td>${paymentRequest.costCenter}</td>
						<td>${paymentRequest.account.accountNumber}</td>
						<td>${paymentRequest.account.subCode}</td>

						<td>
							<jsp:element name="a">
								<jsp:attribute name="href">
									<c:url value="/sapp/permissions/paymentrequest.xls?prId=${paymentRequest.id}" />
								</jsp:attribute>
								<jsp:element name="img">
									<jsp:attribute name="alt">Download</jsp:attribute>
										<jsp:attribute name="src">
											<c:url value="/images/buttons/excel.gif" />
										</jsp:attribute>
								</jsp:element>
							</jsp:element>
						</td>
					</tr>
				</c:forEach>
			</tbody>
		</table>
	</jsp:body>
	
	<div class="buttonset">
			<a class="button" href="${landingUrl}" id="cancelLink">Cancel</a>
	</div>
<div id="modalDiv" style="display: none">
	<p style="font-size: 16pt">
	Loading...
	</p>
</div>
	
</jsp:root>
