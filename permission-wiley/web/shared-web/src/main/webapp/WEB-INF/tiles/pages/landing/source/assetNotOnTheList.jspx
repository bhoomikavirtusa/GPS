<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/landing/source/determine_owner_type" />	
	<c:url var="prevUrl" value="/sapp/landing/source/pub_assets_details" />

	<h3>Asset Not On The List</h3>

	<form:form modelAttribute="sourceWizardForm">
		<table>		
			<tr>
				<td colspan="2">Who Created This Asset?</td>
			</tr>
			<tr>
				<td colspan="2">
					<form:radiobutton path="newOwnerType" label="one of the Authors" value="Author Owned"/>
				</td>
			</tr>
			<tr>
				<td>
					<form:radiobutton path="newOwnerType" label="A Third Party" value="3rd Party"/>
				</td>
				<td> Author who created asset</td>
				<td><form:input path="publicationAuthor" size="100" maxlength="100"/> </td>
			</tr>
			<tr>
				<td colspan="2">
					<form:radiobutton path="newOwnerType" label="Wiley" value="Wiley Owned"/>
				</td>
			</tr>
			<tr>
				<td colspan="2">
					<form:radiobutton path="newOwnerType" label="I'm Not Sure" value="Author Owned"/>
				</td>
			</tr>
		</table>
		
		<div class="buttonset">
			<c:if test="${not empty sourceWizardForm.prevUrl}">
				<input type="button" id="prevB" value="Previous" /> 
			</c:if>
			<input type="submit" id="assetsB" value="Next" /> 
			<a href="#" id="cancelLink" class="button">Cancel</a>
		</div>
	</form:form>

	<script type="text/javascript">
	//<![CDATA[	
		$('#cancelLink').click (function() {
			$modalDialog.dialog("close");
		});

		$('#prevB').click (function() {
			$.ajax({
	            async: true,
	            type: 'get',
	            url: '${prevUrl}',
	            data: $('#sourceWizardForm').serialize(),
	            success: function (response){
	            	$('#modalDiv').empty().html(response);
	            	repositionDialog();
	            }
	        });
		});

		$('#sourceWizardForm').submit(function() {
			$.ajax({
	            type: 'post',
	            url: '${nextUrl}',
	            data: $('#sourceWizardForm').serialize(),
	            success: function (response) {
	                 $('#modalDiv').html(response);
	            }
	        });
			return false;
		});
		
	//]]>		
	</script>

</jsp:root>
