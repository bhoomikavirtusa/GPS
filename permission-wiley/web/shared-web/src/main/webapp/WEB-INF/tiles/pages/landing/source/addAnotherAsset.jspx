<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/landing/source/submit_wiley" />
	<c:url var="prevUrl" value="/sapp/landing/source/main" />
	
	<jsp:directive.include file="js/wizard.buttons.js.jspx" />

	<h3>Add Another Asset</h3>

	<form:form modelAttribute="sourceWizardForm" action="${submitUrl}">
		<table>		
		<tr>
			<td colspan="2">Enter details for asset coming from title ${assetUse.commonWork.description }</td>
		</tr>
		<tr>
			<td colspan="2">Content must be requested separately from the internal request</td>
		</tr>
		
		<tr>
			<td>Description</td>
			
			<td><form:input path="assetUse.asset.description" size="100" maxlength="100"/> </td>
		</tr>
		</table>
		<table>
		<tr>
			<td>
				Original page #:
			</td>
			<td>
				<form:input path="assetUse.pickupPage" size="7" maxlength="7"/>
			</td>
			<td>
				Original figure#:
			</td>
			<td> 
				<form:input path="assetUse.pickupPosition" size="7" maxlength="7"/>
			</td>
			</tr>

		</table>
		
			<form:hidden path="assetUse.pickupTitle"/>
			<form:hidden path="assetUse.pickupAuthor" />
			<form:hidden path="assetUse.pickupISBN"/>
	</form:form> 
			<div class="buttonset">
	<input type="button" id="prevB" value="Previous"/>	
	
	<c:if test="${!sourceWizardForm.multiAsset}">
		<!--  input type="submit" id="finishB" value="Finish"/-->
			<input type="submit" id="nextB" value="Continue"/>
	</c:if>
	<c:if test="${sourceWizardForm.lastAssetUse}">
		<input type="submit" id="finishB" value="Finish"/>
	</c:if>
	
	
	<c:if test="${sourceWizardForm.multiAsset}">
		<c:if test="${!sourceWizardForm.lastAssetUse}">
			<input type="submit" id="finishC" value="Save and process Next Asset"/>
		</c:if>
	</c:if>
	
	<a href="#" id="cancelLink" class="button">Cancel</a> 	
	</div>

<script type="text/javascript">
//<![CDATA[	
		$('#cancelLink').click (function() {
			$modalDialog.dialog("close");
		});

		$('#prevB').click (function() {
			$.ajax({
	            async: true,
	            type: 'get',
	            url: '${prevUrl}',
	            data: $('#sourceWizardForm').serialize(),
	            success: function (response){
	            	$('#modalDiv').empty().html(response);
	            	repositionDialog();
	            }
	        });
		});	


		$('#sourceWizardForm').submit(function() {
			$.ajax({
	            type: 'post',
	            url: '${nextUrl}',
	            data: $('#sourceWizardForm').serialize(),
	            success: function (response) {
	                 $('#modalDiv').html(response);
	            }
	        });
			return false;
		});
		
//]]>		
</script>

</jsp:root>
