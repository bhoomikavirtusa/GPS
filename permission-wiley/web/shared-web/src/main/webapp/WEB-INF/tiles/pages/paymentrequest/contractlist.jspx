<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:form="http://www.springframework.org/tags/form">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/permissions/paymentrequest/select_contract" />
	<c:url var="prevUrl" value="${generatePaymentRequestForm.prevUrl}" />
	
	<!--include as jspx so the jsp variable are recognized-->
	<jsp:directive.include file="js/wizard.buttons.js.jspx" />
	
	<p>Choose permission request form or invoice to enter payment request for: </p>
	
	<form:form modelAttribute="generatePaymentRequestForm">
		<table>
			<c:forEach items="${contracts}" var="contract">
				<tr>
					<td>
						<input type="radio" name="contractId" value="${contract.id}" class="required"/>
						<c:if test="${contract.permissionForm}">
							Permission request form sent on <fmt:formatDate type="date" value="${contract.date}" />
						</c:if> 
						<c:if test="${!contract.permissionForm}">
							Invoice sent on <fmt:formatDate type="date" value="${contract.date}" />
						</c:if>
						(Number: ${contract.number})				
					</td>
				</tr>
			</c:forEach>
		</table>
	</form:form>
	
	<div class="buttonset">
		<c:if test="${not empty generatePaymentRequestForm.prevUrl}">
			<input type="submit" id="prevB" value="Previous" /> 
		</c:if>
		<input type="button" id="selectB" value="Next" /> 
		<a href="#" id="cancelLink" class="button">Cancel</a>
	</div>

</jsp:root>
