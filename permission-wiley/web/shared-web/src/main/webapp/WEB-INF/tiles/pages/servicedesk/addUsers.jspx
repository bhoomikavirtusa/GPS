<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
>
<jsp:directive.include file="/WEB-INF/tiles/pages/include/generalMessage.jspx" />
<c:set var="user" value="${addUsersForm.user}"/>

<form:form modelAttribute="addUsersForm">
		<jsp:attribute name="action">
			<c:url value="/sapp/servicedesk/addUsers" />
		</jsp:attribute>
		<div style="display: none">
			<input type="hidden" name="page" value="0" />

			<form:hidden path="mode"/>
			<form:hidden path="change"/>
			<form:hidden path="selectedChild"/>
			
		</div>
		<spring:hasBindErrors name="addUsersForm">
			<jsp:directive.include file="/WEB-INF/tiles/pages/include/formErrors.jspx" />
		</spring:hasBindErrors>

		<table class="width100">
						<tr>
							<td class="label">
								<form:label path="email" cssClass="required" cssErrorClass="error">E-mail:</form:label>
							</td>

							<td class="value">
								<form:input path="email" size="50" maxlength="200" />
								<input type="hidden" name="oldemail" value="${user.email}" />
							</td>
						</tr>
						
						<tr>
						<td class="label">
								<form:label path="code" cssClass="required" cssErrorClass="error">User Name:</form:label>
						</td>
							<td class="value">
								<form:input path="code" size="45" maxlength="45" />
								
							</td>
						</tr>
		 
						<tr>
							<td class="label">
								<form:label path="firstName" cssClass="required" cssErrorClass="error">First Name:</form:label>
							</td>

							<td class="value">
								<form:input path="firstName"/>
								
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="lastName" cssClass="required" cssErrorClass="error">Last Name:</form:label>
							</td>

							<td class="value">
								<form:input path="lastName"/>
								
							</td>
						</tr>
		 			
						<tr>
							<td class="label">
								<form:label path="enabled" cssClass="required" cssErrorClass="error">Enabled:</form:label>
							</td>

							<td class="value">
								<form:select path="enabled">
									<form:option value="true">Yes</form:option>
									<form:option value="false">No</form:option>
								</form:select>
							</td>
						</tr>

						<tr>
							<td class="label">
								<form:label path="group" cssClass="required" cssErrorClass="error">Group:</form:label>
							</td>

							<td class="value">
								<form:select path="group" id="group">
									<fmt:message key="select.choose.one" var="chooseOneMsg" />
									<c:if test="${null == user.group}">
										<form:option value="" label="${chooseOneMsg}" />
									</c:if>
									<c:if test="${null != user.group}">
										<form:option value="${user.group.id}" label="${user.group.name}" />
										
									</c:if>
									<form:options  items="${userGroups}" itemLabel="name" itemValue="id" value="${user.group}"/>
								</form:select>
							</td>
						</tr>

						
						
				<tr>
						<td class="spacer">&amp;nbsp;</td>
					</tr>

					<tr>
						 <th>Global Roles</th>
						<th></th>	 
								
					</tr> 
					<tr>
						<td class="spacer">&amp;nbsp;</td>
					</tr>
					<tr>
						<td class="label" style="color: #0900C4;">
								Select any one role at least :
						</td>
						<tr>
							<td class="spacer">&amp;nbsp;</td>
						</tr>
					</tr>	
					<c:forEach items="${globalRoles}" var="role" varStatus="status">
						<tr>
							<td>
								<c:choose>
											<c:when test="${role.code=='AUTHOR_DEFAULT'}">
														<form:checkbox path="globalRoles" label="${role.descriptionAndType}" value="${role.code}" />
											</c:when>
											<c:when test="${role.code=='EMPLOYEE_DEFAULT'}">
														<form:checkbox path="globalRoles" label="${role.descriptionAndType}" value="${role.code}" checked="true" />
											</c:when>
								</c:choose>
							</td>
				</tr>
				</c:forEach>
					
	</table>
			
		<div class="buttonset">	
			<input type="submit" value="Add User" />
		</div>
		
</form:form>
</jsp:root>
