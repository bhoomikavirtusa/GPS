<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">

	<jsp:directive.page pageEncoding="UTF-8" />

	<tiles:importAttribute name="source"/>

	<jsp:body>
		<table>
			<tr>
				<td class="value">
					<c:choose>
						<c:when test="${not empty source.files}">
								<table width="100%">
								<c:forEach items="${source.files}" var="file">
									<tr>
										<td>
											<c:url var="tmpURL" value="/sapp/sources/viewSourceFile?fileId=${file.id}"/>
											<a href="${tmpURL}" title="${file.description}"> ${file.fileName}</a> (${wileyfn:filesize(file.fileData)}) uploaded on 
											<fmt:formatDate type="date" value="${file.lastUpdatedDate}" />
										</td>
									</tr>
								</c:forEach>
								</table>
						</c:when>
						<c:otherwise>
							No Files Found For This Source.
						</c:otherwise>
					</c:choose>
				</td>
			</tr>
		</table>
	</jsp:body>

</jsp:root>
