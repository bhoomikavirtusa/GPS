<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/landing/editSource" />

	<!--include as jspx so the jsp variable are recognized-->
	<jsp:directive.include file="js/wizard.buttons.js.jspx" />

	<h3>${poWizardForm.source.name}</h3>
	
	<div class="error">
		<span class="error">Sorry, there are no details about this source in the system.<br/>
		Please enter address and contact information bellow.</span>
	</div>			
	<jsp:include page="/sapp/landing/editSource?sourceId=${poWizardForm.source.id}"/>
	
	<div class="buttonset">	
	<input type="submit" id="detailsB" value="Next"/> 
	<a href="#" id="cancelLink" class="button">Cancel</a> 	
	</div>

	<script type="text/javascript">
//<![CDATA[
	$(document).ready(function() {	
		// set source name
		$("input[name='source.name']").val ("${poWizardForm.source.name}");
		
		$('#detailsB').click (function() {
			if ($("#createSourceForm").validate({
			    rules: {
			        'contact.lastName': {
			            required: function() {
			                return ($("input[name='contact.email']").val() != '');
			            }
			        },
			        'contact.firstName': {
			            required: function() {
			               return ($("input[name='contact.email']").val() != '');
			            }
			        },
			        'contact.email': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val() == '' &&
			                		$("input[name='contactAddress.lineOne']").val() == '')
			            }
			        },
			        'address.lineOne': {
			            required: function() {
			                return ($("input[name='contact.email']").val() == '' && 
			                		$("input[name='contactAddress.lineOne']").val() == '');
			            }
			        },			        
			        'address.city': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val()!= '');
			            }
			        },			        
			        'address.postalCode': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val()!= '');
			            }
			        },			        
			        'address.country': {
			            required: function() {
			                return ($("input[name='address.lineOne']").val()!= '');
			            }
			        },			        
	        		'contactAddress.lineOne': {
			            required: function() {
			                return ($("input[name='contact.email']").val() == '' && 
			                		$("input[name='address.lineOne']").val() == '');
			            }
			        },
			        'contactAddress.city': {
			            required: function() {
			                return ($("input[name='contactAddress.lineOne']").val()!= '');
			            }
			        },			        
			        'contactAddress.postalCode': {
			            required: function() {
			                return ($("input[name='contactAddress.lineOne']").val()!= '');
			            }
			        },			        
			        'contactAddress.country': {
			            required: function() {
			                return ($("input[name='contactAddress.lineOne']").val()!= '');
			            }
			        }						        	
			    },
			    invalidHandler: function(event, validator) {
				    // 'this' refers to the form
				    var errors = validator.numberOfInvalids();
					if (errors) {
				      var message = "You must enter at least a source address, a contact email or contact address.";
				      $("div.error span").html(message);
				      $("div.error").show();
				    } else {
				      $("div.error").hide();
				    }				    
				}
			}).form() == true) {
				$('#createSourceForm').ajaxSubmit({
					type: 'post',
		            url: '${nextUrl}',
			        success: function(response) {
			            $('#modalDiv').empty().html(response);
		                repositionDialog();
			        }
	    		});
		    }
		});
	});	
//]]>		
	</script>	
</jsp:root>
