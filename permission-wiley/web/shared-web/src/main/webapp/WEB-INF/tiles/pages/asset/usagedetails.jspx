<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:security="http://www.springframework.org/security/tags"
	>
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="usageSubmitUrl" value="/sapp/asset/details/usage_submit" />
	
	<script type="text/javascript">
	//<![CDATA[
	$(document).ready(function() {
		$('#submitUsageB').click (function() {
			$.ajax({
	            async: true,
	            type: 'post',
	            url: '${usageSubmitUrl}',
	            data: $('#usageDetailsForm').serialize(),
	            success: function (response){
	                $('#tabs #ui-tabs-2').empty().html(response);
	                fnRefreshRows (${usageDetailsForm.assetUse.id});
	            }
	        });
		});
	});
	//]]>		
	</script>
	
	<!--include as jspx so the jsp variable are recognized-->
	<jsp:directive.include file="/WEB-INF/tiles/pages/include/js/toggleScript.js.jspx" />

	<jsp:directive.include file="/WEB-INF/tiles/pages/include/generalMessage.jspx" />	

	<div class="requiredtxt">* indicates required field</div>
	<br/><br/>
	<form:form modelAttribute="usageDetailsForm">
		<table>
			<tr>
				<td class="label">
					<form:label path="assetUse.usage" cssClass="required" cssErrorClass="error">Usage</form:label>
				</td>
				<td class="value">
					<form:select path="assetUse.usage">
						<form:options items="${usages}" itemValue="code" itemLabel="description" />
					</form:select>
				</td>
				<td class="label">
	    			Position
				</td>
				<td class="value" width="25%">
	    			<form:input path="assetUse.position" size="10" maxlength="64"/>
	    			(e.g. 4-2)
				</td>
			</tr>
			
			<tr>
				<td class="label">
				    Found On
				</td>
				<td class="value" colspan="3">
	    			<form:input path="assetUse.foundOn" size="50" maxlength="200"/> 
	    			<br/>(e.g. pages 2-24, pages 77-90 and all of chapter 29)
				</td>
			</tr>

			<tr>
				<td class="label">
    				Component
				</td>
				<td class="value" colspan="3">
					<form:select path="assetUse.component">
		    			<form:option value="" label="--Select--" />
						<form:options items="${componentList}"
			    			itemValue="id" itemLabel="name" />
					</form:select>
				</td>
			</tr>

			<tr>
				<td class="label">
	    			Manuscript Page
				</td>
				<td class="value">
	    			<form:input path="assetUse.manuscriptPage" size="10" maxlength="10" />
				</td>
				<td class="label">
	    			Final Page
				</td>
				<td class="value">
	    			<form:input path="assetUse.finalPage" size="10" maxlength="10"/>
				</td>
			</tr>
			<tr>
				<td class="label">
	    			Asset Order
				</td>
				<td class="value" colspan="3">
	    			<form:input path="assetUse.sortOrder" size="10" maxlength="10" />
				</td>
			</tr>
			<tr>
				<td class="label">
	    			Color or B&amp;W
				</td>
				<td class="value" colspan="3">
	    			<form:radiobutton path="assetUse.color" value="true"/> color
	    			<form:radiobutton path="assetUse.color" value="false" cssStyle="margin-left: 1em"/> black &amp; white
				</td>
			</tr>
			<tr>
				<td class="label">
				    Size
				</td>
				<td class="value">
					<form:select path="assetUse.size">
						<form:options items="${sizes}" itemValue="code" itemLabel="description" />
					</form:select>
				</td>
				<td class="label">
	    			Page Position
				</td>
				<td class="value">
					<form:select path="assetUse.pagePosition">
	    				<form:option value="" label="--select--" />
						<form:options items="${pagePositions}" itemValue="code" itemLabel="description" />
					</form:select>							
				</td>
			</tr>

			<tr>
				<td class="label">
    				Caption
				</td>
				<td class="value" colspan="3">
	    			<form:input path="assetUse.caption" size="50" maxlength="500"/>
				</td>
			</tr>
			<tr>
				<td class="label">
					Estimated cost:
				</td>
				<td class="value" colspan="3"> 
					<form:input path="assetUse.estimatedCost" size="10" maxlength="10" />
					<form:select path="assetUse.estimatedCurrency">
						<form:options items="${currencies}" itemValue="code" itemLabel="description" />
					</form:select>			
				</td>				
			</tr>
			<tr>
				<td class="label">
					Final cost:
				</td>
				<td class="value" colspan="3"> 
					<fmt:formatNumber type="currency" currencyCode="USD" value="${assetFinalCost}" />
				</td>				
			</tr>
			
			<tr>
				<td class="label">
       				Permission Comment
    			</td>
				<td class="value" colspan="3">
	    			<form:textarea path="assetUse.permissionComment" rows="1" cols="60" maxlength="5000"/>
				</td>
			</tr>

			<tr>
				<td class="label">
       				Production Comment
    			</td>
				<td class="value" colspan="3">
	    			<form:textarea path="assetUse.productionComment" rows="1" cols="60" maxlength="5000"/>
				</td>
			</tr>
			<tr>
				<td>Global BPM Category</td>
				<td>
					<form:select path="assetUse.gbpmCategory">
					    <form:option label="Not Selected" value="0"/>
						<form:options items="${gbpmCategories}" itemValue="code" itemLabel="description" />
					</form:select>
				</td>
							
			</tr>
			
			<c:if test="${usageDetailsForm.assetUse.reusedFromPreviousEdition}">
				<c:set var="reusedStyle" value=""/>
				<c:set var="nonreusedStyle" value="display: none;"/>
			</c:if>
			<c:if test="${not usageDetailsForm.assetUse.reusedFromPreviousEdition}">
				<c:set var="reusedStyle" value="display: none;"/>
				<c:set var="nonreusedStyle" value=""/>
			</c:if>
			<c:if test="${usageDetailsForm.assetUse.pickup}">
				<c:set var="pickupStyle" value=""/>
				<c:set var="nonpickupStyle" value="display: none;"/>
			</c:if>
			<c:if test="${not usageDetailsForm.assetUse.pickup}">
				<c:set var="pickupStyle" value="display: none;"/>
				<c:set var="nonpickupStyle" value=""/>
			</c:if>
		
			<tbody id="details-nonpickup" style="${nonpickupStyle}">
			<tr>
				<td>
				    Reused From Previous Edition 
				</td>
				<td colspan="3">
				    <form:checkbox path="assetUse.reusedFromPreviousEdition"
				        onclick="toggleTBody('reused', this); toggleTBody('nonreused', this);"/>
				</td>
			</tr>
			</tbody>

			<tbody id="details-reused" style="${reusedStyle}">
				<tr>
					<td>
					    Reused ISBN
					</td>
					<td colspan="3">
						<form:input path="assetUse.reusedISBN" size="17" maxlength="17"/>
						<span class="comment">(ISBN will be validated against products)</span>
					</td>
				</tr>

				<tr>
					<td>
					    Reused Comment
					</td>
					<td colspan="3"><form:input path="assetUse.reusedComment" size="50" maxlength="100"/></td>
				</tr>

				<tr>
					<td>
					    Reused Position
					</td>
					<td><form:input path="assetUse.reusedPosition" size="20" maxlength="50"/> (e.g. Figure 4-2)</td>
					<td>
					    Reused Page
					</td>
					<td><form:input path="assetUse.reusedPage" size="10" maxlength="10"/></td>
				</tr>
			</tbody>

			<tbody id="details-nonreused" style="${nonreusedStyle}">
				<tr>
					<td>
					    Pickup From Another Title 
					    <c:if test="${usageDetailsForm.assetUse.pickup}">
					    	(${usageDetailsForm.assetUse.pickupTitle } by: ${usageDetailsForm.assetUse.pickupAuthor } )
					    </c:if>
					</td>
					<td colspan="3">
					    <form:checkbox path="assetUse.pickup"
					        onclick="toggleTBody('pickup', this); toggleTBody('nonpickup', this);"/>
					</td>									
				</tr>
			</tbody>
			
			<tbody id="details-pickup" style="${pickupStyle}">
				<tr>
					<td>
					    Pickup ISBN
					</td>
					<td colspan="3">
						<form:input path="assetUse.pickupISBN" size="17" maxlength="17" />
						<span class="comment">(ISBN will be validated against products)</span>
					</td>
				</tr>

				<tr>
					<td>
					    Pickup Comment
					</td>
					<td colspan="3"><form:input path="assetUse.pickupComment" size="50" maxlength="100"/></td>
				</tr>

				<tr>
					<td>
					    Pickup Position
					</td>
					<td>
					    <form:input path="assetUse.pickupPosition" size="20" maxlength="50"/> (e.g. Figure 4-2)
					</td>
					<td>
					    Pickup Page
					</td>
					<td>
					    <form:input path="assetUse.pickupPage" size="10" maxlength="10" />
					</td>
				</tr>						
			</tbody>
			
			<tr>
				<td colspan="4">
					<table>
						<tr>
							<td>
				    			Camera Copy To Come
							</td>
							<td>
				    			<form:checkbox path="assetUse.cameraCopyToCome"/>
							</td>
							<td>
				    			Media Return Requested
							</td>
							<td>
				    			<form:checkbox path="assetUse.mediaReturnRequested"/>
							</td>
						</tr>
				
						<tr>
							<td>
				    			New
							</td>
							<td>
				    			<form:checkbox path="assetUse.new"/>
							</td>
							<td>
				    			Needs Payment Request
							</td>
							<td>
				    			<form:checkbox path="assetUse.needPaymentRequest" />
							</td>
						</tr>
						<tr>
							<td>
				    			Sent To Production
							</td>
							<td>
				    			<form:checkbox path="assetUse.sentToProduction"/>
							</td>
							<td>
				    			Page Proof Required
							</td>
							<td>
				    			<form:checkbox path="assetUse.pageProofRequired"/>
							</td>
						</tr>	
					<c:if test="${usageDetailsForm.assetUse.importSource != null}">
						<tr>
							<td>This asset originated from</td>
							<td><c:out value="${usageDetailsForm.assetUse.importSource.description}" /></td>
						</tr>
				</c:if>
											
					</table>
				</td>
			</tr>
			<!-- This part until end of table same for view/usagedetails.jspx -->
			<tr>
				<td class="label">Group Created By</td>
				<td class="value">
				<!-- Changes for SS Task 6 starts -->
					<security:authorize access="hasAuthority('ADMIN')" >
						<form:select path="assetUse.userGroup">
							<c:forEach items="${userGroupList}" var="ug">
								<c:choose>
									<c:when test="${ug.id == usageDetailsForm.assetUse.userGroup.id}">
										<option value="${ug.id}" selected="selected">
											${ug.name}
										</option>
									</c:when>
									<c:otherwise>
										<option value="${ug.id}">
											${ug.name}
										</option>
									</c:otherwise>
								</c:choose>
							</c:forEach>
						</form:select>
					</security:authorize>
					<security:authorize access="!hasAuthority('ADMIN')" >
						<c:out value="${usageDetailsForm.assetUse.userGroup == null ? '' : usageDetailsForm.assetUse.userGroup.name}" />
					</security:authorize>
					<!-- Changes for SS Task 6 ends -->
				</td>
			</tr>
			<tr>
				<td class="label">Cancelled</td>
				${wileyfn:booleanTD(usageDetailsForm.assetUse.canceled)}
			</tr>
			<c:if test="${usageDetailsForm.assetUse.canceled}">
				<tr>
					<td class="label">Cancel Timestamp</td>
					<td>
						<!-- cancelTimestamp may be null due to cancellations that occurred before we had this field. -->
						<c:choose>
							<c:when test="${usageDetailsForm.assetUse.cancelTimestamp == null}">
								Not recorded
							</c:when>
							<c:otherwise>
								<fmt:formatDate type="both" value="${usageDetailsForm.assetUse.cancelTimestamp}" />
							</c:otherwise>
						</c:choose>
					</td>
				</tr>
				<tr>
					<td class="label">Cancel User</td>
					<td>
						<!-- cancelUser may be null due to cancellations that occurred before we had this field. -->
						<c:choose>
							<c:when test="${usageDetailsForm.assetUse.cancelUser == null}">
								Not recorded
							</c:when>
							<c:otherwise>
								<c:out value="${usageDetailsForm.assetUse.cancelUser.fullName}" />
							</c:otherwise>
						</c:choose>
					</td>
				</tr>
				<tr>
					<td class="label">Cancel Replacement</td>
					<td>
						<c:choose>
							<c:when test="${usageDetailsForm.assetUse.cancelReplacement == null}">
								None
							</c:when>
							<c:otherwise>
								Description:
								<c:out value="${usageDetailsForm.assetUse.cancelReplacement.asset.description}" />
								<br />
								Source(s): <c:out value="${usageDetailsForm.assetUse.cancelReplacement.asset.sourcesAsString}" />
							</c:otherwise>
						</c:choose>
					</td>
				</tr>
				<tr>
					<td class="label">Cancel Comment</td>
					<td>
						<c:out value="${usageDetailsForm.assetUse.cancelComment}" />
					</td>
				</tr>
			</c:if>
			<tr>
				<td class="label">Replacement for:</td>
				<td class="value"><c:out value="${replacementForDescriptions}" /></td>
			</tr>
		</table>
	</form:form>
	<div class="buttonset">			
		<input type="submit" id="submitUsageB" value="Save"/>
	</div>

</jsp:root>
