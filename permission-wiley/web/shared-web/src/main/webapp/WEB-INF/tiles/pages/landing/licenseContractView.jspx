<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:security="http://www.springframework.org/security/tags">

	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>

	<c:url var="editContractUrl" value="/sapp/landing/license/editContract" />
	
	<table class="width100">
		<tr>
			<th colspan="4">Contract</th>
		</tr>
		<tr>
			<td>invoice number</td>
			<td><c:out value="${license.invoiceNumber}" /></td>
			<td>contract type</td>
			<td><c:out value="${license.contractTypeCalc.description}" /></td>
		</tr>
		<tr>
			<td>source name</td>
			<td><c:out value="${license.sourceName}" /></td>
			<td>invoice date</td>
			<td><fmt:formatDate type="date" value="${license.invoiceDate}" /></td>
		</tr>
		<tr>
			<td>credit line</td>
			<td><c:out value="${license.creditLine}" /></td>
			<td>grant start date</td>
			<td><fmt:formatDate type="date" value="${license.grantStartDate}" /></td>
		</tr>
		<tr>
			<td>currency</td>
			<td><c:out value="${license.currencyCalc.description}" /></td>
			<td>grant end date</td>
			<td><fmt:formatDate type="date" value="${license.grantEndDate}" /></td>
		</tr>
		<tr>
			<td>total amount</td>
			<td><c:out value="${license.totalAmount}" /></td>
		</tr>
		<tr>
			<td colspan="4">
				<div class="buttonset">
					<input id="editContractB" type="button" class="button" value="Edit" />
				</div>
			</td>
		</tr>
	</table>

	<script type="text/javascript">
	//<![CDATA[
	$('#editContractB').click(function() {
		$.ajax({
	    	async: false,
	        type: "get",
	        url: '${editContractUrl}',
	        success: function (response) {
	          	$('#contractBody').empty().html(response);
	        }
	    });
	});
	//]]>
	</script>
</jsp:root>
	