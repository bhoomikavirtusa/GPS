<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/landing/source/submit_previous_edition_asset_search" />
	<c:url var="prevUrl" value="/sapp/landing/source/main" />

	<!--include as jspx so the jsp variable are recognized-->
	<jsp:directive.include file="js/wizard.buttons.js.jspx" />

	<h3>${sourceWizardForm.assetUse.asset.description}</h3>

	<form:form modelAttribute="sourceWizardForm" action="${submitUrl}">
		<form:hidden path="assetSelected" />
		<table>
			<tr>
				<td width="20%">
					From Previous Edition:
				</td>
				<td colspan="3">
				
					<c:if test="${null != sourceWizardForm.editions}">
						<form:select path="edition">
							<form:options items="${sourceWizardForm.editions}" itemValue="value" itemLabel="label" />
						</form:select>
					</c:if>
				</td>
			</tr>
			
			<tr>
				<td width="20%">Search for asset Component:</td>
				<td>
					<form:input path="previousEditionRequestCriteria.component" size="12" maxlength="12"/>
				</td>
			</tr>			
				
			<tr>
				<td width="20%">Search for asset type:</td>
				<td>	
					<form:select path="previousEditionRequestCriteria.mediaType">
						<form:options items="${mediaTypes}" itemValue="code" itemLabel="description" />
					</form:select>
				</td>
			</tr>	
			
			<tr>
				<td width="20%">Search for asset Description:</td>
				<td>
					<form:input path="previousEditionRequestCriteria.assetDescription" size="60" maxlength="60"/>
				</td>
			</tr>		
			
			<tr>
				<td width="20%">Search for asset Usage:</td>
				<td>
					<form:input path="previousEditionRequestCriteria.usage" size="12" maxlength="12"/>
				</td>
			</tr>			
				
			<tr>
				<td width="20%">Search for asset Position:</td>
				<td>
					<form:input path="previousEditionRequestCriteria.pagePosition" size="12" maxlength="12"/>
				</td>
			</tr>			
		
			<tr>
				<td width="20%"> </td>
				<td colspan="3">
				Select the Edition that you want to copy from and enter optional page and or identifier and click next
				</td>
			</tr>
		
		</table>
	</form:form>

	<div class="buttonset">
		<input type="button" id="prevB" value="Previous"/>	
		<input type="submit" id="nextB" value="Next" />
		<a href="#" id="cancelLink" class="button">Cancel</a> 	
	</div>

</jsp:root>
