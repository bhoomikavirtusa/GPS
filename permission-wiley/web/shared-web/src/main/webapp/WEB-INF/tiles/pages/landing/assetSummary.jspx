<?xml version="1.0" encoding="UTF-8"?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page" 
	xmlns:c="http://java.sun.com/jsp/jstl/core" 
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt" 
	xmlns:fn="http://java.sun.com/jsp/jstl/functions" 
	xmlns:form="http://www.springframework.org/tags/form" 
	xmlns:spring="http://www.springframework.org/tags" 
	xmlns:tiles="http://tiles.apache.org/tags-tiles" 
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">

   <c:url var="filterUrl" value="/sapp/landing/cw/assetSummary" />
   
   <script type="text/javascript">
   //<![CDATA[

	function toggleChecked(containerId, status) {
		$("#" + containerId + " input[type='checkbox']").each( function() {
			$(this).attr("checked", status);
		})
	}

	$(document).ready(function() {
		$('#assetSummaryForm').submit(function() {
			$.ajax({
	            type: 'get',
	            url: '${filterUrl}',
	            data: $('#assetSummaryForm').serialize(),
	            success: function (response){
	                $('#modalDiv').empty().html(response);
	                repositionDialog();
	            }
	        });
			return false;
		});
		
		$('#manageSummaryLink').click(function() {
			$("#modalDiv").load($(this).attr("href"));
			// prevent the default action, e.g., following a link
			return false;
	    });
		
		$('#managePhotoEstimateLink').click(function() {
			$("#modalDiv").load($(this).attr("href"));
			// prevent the default action, e.g., following a link
			return false;
	    });
		
		$('#closeLink').click (function() {
			$modalDialog.dialog("close");
		});
	});
	//]]></script>
   
   <table>
      <tr>
         <td>
               <form id="assetSummaryForm" name="assetSummaryForm" action="${filterUrl}">
                  <table class="display">
					  <tr>
				       <!--needs width because it is missing an image as the other columns and is a little higher-->
				         <th colspan="2" style="height: 19px">Asset Summary</th>
				      </tr>
                     <tr>
                        <td valign="top">Filter by Media Type</td>
                        <td valign="top">Filter by creator User Group</td>
                     </tr>
                     <tr>
                        <td valign="top">
                           <a href="javascript:toggleChecked('mediaTypesTable', true)">Select All</a>
                           |
                           <a href="javascript:toggleChecked('mediaTypesTable', false)">None</a>
                        </td>
                        <td valign="top">
                           <a href="javascript:toggleChecked('userGroupsTable', true)">Select All</a>
                           |
                           <a href="javascript:toggleChecked('userGroupsTable', false)">None</a>
                        </td>
                     </tr>
                     <tr>
                        <td valign="top">
                           <table id="mediaTypesTable">
                              <c:forEach var="mediaType" items="${allMediaTypes}" varStatus="status">
                                 <tr class="${(status.index mod 2 == 0) ? 'lightRow' : 'darkRow'}">
                                    <td>
                                    	<c:if test="${wileyfn:contains(mediaTypes, mediaType.code)}">
                                    		<input type="checkbox" name="mediaType" value="${mediaType.code}" checked='checked' />
                                    	</c:if>
                                    	<c:if test="${not wileyfn:contains(mediaTypes, mediaType.code)}">
                                    		<input type="checkbox" name="mediaType" value="${mediaType.code}" />
                                    	</c:if>
                                       <c:out value="${mediaType.description}" />
                                    </td>
                                 </tr>
                              </c:forEach>
                           </table>
                        </td>
                        <td valign="top">
                           <table id="userGroupsTable">
                              <c:forEach var="group" items="${allUserGroups}" varStatus="status">
                                 <tr class="${(status.index mod 2 == 0) ? 'lightRow' : 'darkRow'}">
                                    <td>
                                    	<c:if test="${wileyfn:contains(userGroups, group.id)}">
                                    		<input type="checkbox" name="userGroup" value="${group.id}" checked='checked' />
                                    	</c:if>
                                    	<c:if test="${not wileyfn:contains(userGroups, group.id)}">
                                    		<input type="checkbox" name="userGroup" value="${group.id}" />
                                    	</c:if>
                                       <c:out value="${group.name}" />
                                    </td>
                                 </tr>
                              </c:forEach>
                           </table>
                           <input type="submit" class="button" value="Filter" />
                        </td>
                     </tr>
                  </table>
               </form>
         </td>
         <td valign="top">
            <table class="display">
               <tr>
                  <th>Photo Estimate</th>
                  <th />
                  <th>
                     <jsp:element name="a">
                        <jsp:attribute name="id">managePhotoEstimateLink</jsp:attribute>
                        <jsp:attribute name="href">
                           <c:url value="/sapp/landing/managePhotoEstimate/view" />
                        </jsp:attribute>
                        <jsp:element name="img">
                           <jsp:attribute name="alt">Edit</jsp:attribute>
                           <jsp:attribute name="title">Edit</jsp:attribute>
                           <jsp:attribute name="src">
                              <c:url value="/images/buttons/edit-icon.png" />
                           </jsp:attribute>
                        </jsp:element>
                     </jsp:element>
                  </th>
               </tr>
               <c:forEach var="estimate" items="${photoEstimates}" varStatus="status">
                  <tr class="${(status.index mod 2 == 0) ? 'lightRow' : 'darkRow'}">
                     <td>
                        <c:out value="${estimate.photoEstimateType.description}" />
                     </td>
                     <td>
                        <c:choose>
                           <c:when test="${estimate.photoEstimateType.dataType.code == dataType.INT.code}">
                              <fmt:formatNumber maxFractionDigits="0" value="${estimate.estimatedValue}" />
                           </c:when>
                           <c:otherwise>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${estimate.estimatedValue}" />
                           </c:otherwise>
                        </c:choose>
                     </td>
                     <td>
                        <fmt:formatDate type="date" value="${estimate.date}" />
                     </td>
                  </tr>
               </c:forEach>
            </table>
         </td>
         <td valign="top">
            <table class="display">
               <tr>
                  <th>Progress and Due Dates</th>
                  <th>
                     <jsp:element name="a">
                        <jsp:attribute name="id">manageSummaryLink</jsp:attribute>
                        <jsp:attribute name="href">
                           <c:url value="/sapp/landing/manageSummary?cwId=${commonWork.id}" />
                        </jsp:attribute>
                        <jsp:element name="img">
                           <jsp:attribute name="alt">Edit</jsp:attribute>
                           <jsp:attribute name="title">Edit</jsp:attribute>
                           <jsp:attribute name="src">
                              <c:url value="/images/buttons/edit-icon.png" />
                           </jsp:attribute>
                        </jsp:element>
                     </jsp:element>
                  </th>
               </tr>
               <tr class="lightRow">
                  <td>Research Status</td>
                  <td>
                     <!-- Should use formatNumber but the value is stored as integer instead of fraction -->
                     <!--
                   		    <fmt:formatNumber type="percent" value="${cwSummary.researchStatus}" />
                   		    -->
                     ${cwSummary.researchStatus} %
                  </td>
               </tr>
               <tr class="darkRow">
                  <td>Research Progress Notes</td>
                  <td>${cwSummary.researchProgressNotes}</td>
               </tr>
               <tr class="lightRow">
                  <td>Credit List Submitted</td>
                  <td>${cwSummary.creditListSubmitted ? "Yes" : "No"}</td>
               </tr>
               <tr class="darkRow">
                  <td>Photo Research Due</td>
                  <td>
                     <fmt:formatDate type="date" value="${cwSummary.photoResearchDue}" />
                  </td>
               </tr>
               <tr class="lightRow">
                  <td>Permissions Due</td>
                  <td>
                     <fmt:formatDate type="date" value="${cwSummary.permissionsDue}" />
                  </td>
               </tr>
               <tr class="darkRow">
                  <td>Page Proof Schedule Date</td>
                  <td>
                     <fmt:formatDate type="date" value="${cwSummary.pageProofScheduleDate}" />
                  </td>
               </tr>
               <tr class="lightRow">
                  <td>Release To Printer Date</td>
                  <td>
                     <fmt:formatDate type="date" value="${cwSummary.releaseToPrinterDate}" />
                  </td>
               </tr>
            </table>
         </td>
      </tr>
      <tr>
            <table>
               <tr>
                  <td valign="top">
                     <table class="display">                        
                        <tr>
                           <th>New (incl.pickup)</th>
                           <th>Qty</th>
                           <th>Costs</th>
                        </tr>
                        <tr class="lightRow">
                           <td>Rights Managed</td>
                           <td>${summary.covers["new_rm"] + summary.internals["new_rm"]}</td>
                           <c:set var="cost" value="${summary.costs['new_rm']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="darkRow">
                           <td>Royalty Free</td>
                           <td>${summary.covers["new_royaltyfree"] + summary.internals["new_royaltyfree"]}</td>
                           <c:set var="cost" value="${summary.costs['new_royaltyfree']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="lightRow">
                           <td>Royalty Free$$</td>
                           <td>${summary.covers["new_royaltyfree$$"] + summary.internals["new_royaltyfree$$"]}</td>
                           <c:set var="cost" value="${summary.costs['new_royaltyfree$$']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="darkRow">
                           <td>Other No cost/No Royalty Free</td>
                           <td>${summary.covers["new_free"] + summary.internals["new_free"]}</td>
                           <c:set var="cost" value="${summary.costs['new_free']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="lightRow">
                           <td>
                              <b>Total</b>
                           </td>
                           <td>
                              <b>${summary.newTotal}</b>
                           </td>
                           <td>
                              <b>
                                 <fmt:formatNumber type="currency" currencyCode="USD" value="${summary.newTotalCost}" />
                              </b>
                           </td>
                        </tr>
                        <tr class="lightRow">
                           <td />
                           <td />
                           <td />
                           <td />
                        </tr>
                        <tr>
                           <th>Reuse</th>
                           <th>Qty</th>
                           <th>Costs</th>
                        </tr>
                        <tr class="lightRow">
                           <td>Rights Managed</td>
                           <td>${summary.covers["reuse_rm"] + summary.internals["reuse_rm"]}</td>
                           <c:set var="cost" value="${summary.costs['reuse_rm']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="darkRow">
                           <td>Royalty Free</td>
                           <td>${summary.covers["reuse_royaltyfree"] + summary.internals["reuse_royaltyfree"]}</td>
                           <c:set var="cost" value="${summary.costs['reuse_royaltyfree']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="lightRow">
                           <td>Royalty Free$$</td>
                           <td>${summary.covers["reuse_royaltyfree$$"] + summary.internals["reuse_royaltyfree$$"]}</td>
                           <c:set var="cost" value="${summary.costs['reuse_royaltyfree$$']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="darkRow">
                           <td>Other No cost/No Royalty Free</td>
                           <td>${summary.covers["reuse_free"] + summary.internals["reuse_free"]}</td>
                           <c:set var="cost" value="${summary.costs['reuse_free']}" />
                           <td>
                              <fmt:formatNumber type="currency" currencyCode="USD" value="${cost}" />
                           </td>
                        </tr>
                        <tr class="lightRow">
                           <td>
                              <b>Total</b>
                           </td>
                           <td>
                              <b>${summary.reuseTotal}</b>
                           </td>
                           <td>
                              <b>
                                 <fmt:formatNumber type="currency" currencyCode="USD" value="${summary.reuseTotalCost}" />
                              </b>
                           </td>
                        </tr>
                        <tr class="lightRow">
                           <td>
                              <b>Estimated Total</b>
                           </td>
                           <td />
                           <td>
                              <b>${commonWork.primaryProduct.photoIllusTotalCount}</b>
                           </td>
                        </tr>
                        <tr class="lightRow">
                           <td />
                           <td />
                           <td />
                        </tr>
						<c:forEach items="${statuses}" var="entry">
				        <c:set var="key" value="${entry.code}" />
						<tr>
				           <td>${entry.description}: </td>
				           <td>${summary.covers[key]+summary.internals[key]}</td>
				        </tr>
                        </c:forEach>
                     </table>
                  </td>
               </tr>
               <tr>
                  <td class="label">Total Estimated Cost</td>
                  <td>
                     <fmt:formatNumber type="currency" currencyCode="USD" value="${totalEstimatedCost}" />
                  </td>
               </tr>
               <tr>
                  <td class="label">Current Actual Cost</td>
                  <td>
                     <fmt:formatNumber type="currency" currencyCode="USD" value="${currentActualCost}" />
                  </td>
               </tr>
            </table>
      </tr>
   </table>
   <div class="buttonset">
      <button id="closeLink" class="button">Close</button>
   </div>
</jsp:root>