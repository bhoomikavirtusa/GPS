<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="prUrl" value="/sapp/permissions/paymentrequest.xls" />
	
	<table>
		<tr>
			<th>Source</th>
			<th>Check Number#</th>
			<th>Payment</th>
		</tr>
		<c:forEach items="${contracts}" var="contract">
			<tr>
				<td><c:out value="${contract.source.name}" /></td>
				<td><c:out value="${contract.checkNumber}" /></td>
				<td>
					<c:if test="${contract.paymentType == 'PAYMENT'}">
						<a href="${prUrl}?prId=${contract.paymentRequest.id}">Paid on <fmt:formatDate type="date" value="${contract.paymentDate}" /></a>
					</c:if>
					<c:if test="${contract.paymentType == 'AUTHOR'}">
						Paid by Author on <fmt:formatDate type="date" value="${contract.paymentDate}" />
					</c:if>
					<c:if test="${contract.paymentType == 'WILEY'}">
						Paid by Wiley on <fmt:formatDate type="date" value="${contract.paymentDate}" />
					</c:if>
				</td>
			</tr>
		</c:forEach>
	</table>
</jsp:root>
