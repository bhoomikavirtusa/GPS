<?xml version="1.0" encoding="UTF-8" ?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
>

	<jsp:directive.page pageEncoding="UTF-8" />
	
	<c:url var="landingUrl" value="/sapp/cwlanding/main?cwId=${commonWork.id}" />
	
	<script type="text/javascript">
	$(document).ready(function() {
		$('#sourcePayTable').dataTable( {
			"aoColumns": [
				{ "sWidth" : "40%", "sClass" : "center" }, // Source
				{ "sWidth" : "20%", "sClass" : "center" }, // Invoice
				{ "sWidth" : "20%", "sClass" : "center" }, // # Assets Needing Payment Request
				{ "sWidth" : "20%", "sClass" : "center", "bSortable" : false, "bSearchable" : false } // Payment Request
			],
			"aaSorting": [[0, "asc" ]],

			"bAutoWidth": false,
			"bProcessing": true,
			"bDestroy": true,
			"bStateSave": true,
			"sPaginationType": "full_numbers",
			"aLengthMenu": [10, 15, 25, 50, 100],  // override default of [10, 25, 50, 100]
			"iDisplayLength": 15 // override default of 10
		} );
	} );
	</script>

	<script type="text/javascript">
	//<![CDATA[

	$('#prevC').click (function() {
		$.ajax({
            async: true,
            type: 'get',
            url: '${landingUrl}',
            success: function (response){
                // $('#modalDiv').empty().html(response);
                $modalDialog.dialog("close");
            }
        });
	});	


	$(document).ready(function() {		
		$('#editSource').click(function() {
			$("#modalDiv").load($(this).attr("href"), function() {
				openModalDialog ('Edit source');
	        });
			// prevent the default action, e.g., following a link
			return false;
		});
				
	});

	$(document).ready(function() {		
		$('#createRequest').click(function() {
			$("#modalDiv").load($(this).attr("href"), function() {
				openModalDialog ('Create payment request');
	        });
			// prevent the default action, e.g., following a link
			return false;
		});
				
	});
	
	$(document).ready(function() {		
		$('#editContract').click(function() {
			$("#modalDiv").load($(this).attr("href"), function() {
				openModalDialog ('View/Edit contract');
	        });
			// prevent the default action, e.g., following a link
			return false;
		});
				
	});
	

	
	//]]>
	</script>
	
	<jsp:body>
	
	<h2>Sources that need to generate Payment Request:</h2>
		
			<table class="display" style="width: 100%" id="sourcePayTable">
				<thead>
					<tr>
						<th>Source</th>
						<th>Invoice</th>
						<th># Assets Needing Payment Request</th>
						<th>Payment Request</th>
					</tr>
				</thead>
				<tbody>
					<c:forEach items="${sourceToAssetData}" var="contract">
						<tr>
							<td>
								<c:url var="sourceUrl" value="/sapp/sources/viewSource/form?sourceId=${contract.source.id}" />
								<a href="${sourceUrl}" id="editSource">${wileyfn:sourceAsHTML(contract.source)}</a>
							</td>

							<td>
								<c:url var="contractUrl" value="/sapp/permissions/contract/edit_start?cwId=${commonWork.id}&amp;sourceId=${contract.source.id}" />
								<a id="editContract" href="${contractUrl}"><c:out value="${contract.number}" /></a>
							</td>

							<td>${fn:length(contract.assets)}</td>

							<td>
								<c:url var="managePaymentRequestUrl" value="/sapp/permissions/paymentrequest/managePaymentRequest" /> 
								<a id="createRequest" href="${managePaymentRequestUrl}?sourceId=${contract.source.id}&amp;contractId=${contract.id}">Create</a>
							</td>
						</tr>
					</c:forEach>
				</tbody>
			</table>
		
	<div class="buttonset">
			<a class="button" href="${landingUrl}" id="cancelLink">Cancel</a>
	</div>

	</jsp:body>
</jsp:root>


