<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>

<!-- same url as panel but with limit 0 -->
<c:url var="fullUrl" value="/sapp/landing/cw/history?cwId=${cwId}&amp;limit=0" />
<c:url var="statusDownloadUrl" value="/sapp/commonwork/report/bulkDocumentsUpload.xls" /><!-- Added for DM-532 -->

<script type="text/javascript">
//<![CDATA[
$(function() {
	$('#fullLink_${cwId}').click(function() {
		$("#modalDiv").load('${fullUrl}', function() {
			openModalDialog ('Product History');
        });
		// prevent the default action, e.g., following a link
		return false;
	});
	
	$('#closeLink_${cwId}').click (function() {
		$modalDialog.dialog("close");
	});
});
//]]>
</script>

<div class="greybox">
	<!-- If in panel and not full dialog -->
	<c:if test="${param.limit > 0}">
		<div style="margin-bottom: 0.5em">PRODUCT HISTORY</div>
	</c:if>
	
	<table class="display">
		<tr>
			<th>Description</th>
			<th>User</th>
			<th>Date</th>
		</tr>
		<c:forEach items="${historyList}" var="history">
			<tr>
				<!-- <td><c:out value="${history.description}" /></td> -->
				<td>${history.description}</td><!-- Updated for DM-532 -->
				<td><c:out value="${history.lastUpdatedUser.fullName}" /></td>
				<td><fmt:formatDate type="date" value="${history.lastUpdatedDate}" /></td>
			</tr>
		</c:forEach>
	</table>
	
	<!-- If in panel and not full dialog -->
	<c:if test="${param.limit > 0}">
		<div style="margin-top: 0.5em">
		<a id="fullLink_${cwId}" href="${fullUrl}">See all product history</a>
		</div>
	</c:if>
</div>

<!-- If in full dialog -->
<c:if test="${param.limit == 0}">
	<div class="buttonset">		
		<button id="closeLink_${cwId}" class="button">Close</button>
	</div>
</c:if>
<!-- Start: Added for DM-532 -->
<script type="text/javascript">
function download(urlPath) {
	$.ajax({
        async: true,
        type: 'get',
        url: '${statusDownloadUrl}'+urlPath,
        success: function (response){
        	window.open(response);
        	$modalDialog.dialog("close");
        }
    });
}
</script>
<!-- End: Added for DM-532 -->

</jsp:root>
