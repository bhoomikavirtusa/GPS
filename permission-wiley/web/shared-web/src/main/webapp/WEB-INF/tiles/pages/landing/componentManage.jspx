<?xml version="1.0" encoding="UTF-8" ?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">

	<c:url var="deleteUrl" value="/sapp/landing/component/delete" />
	<c:url var="simpleAddUrl" value="/sapp/landing/component/simpleAdd" />
	<c:url var="editRowUrl" value="/sapp/landing/component/editRow" />
	<c:url var="saveRowUrl" value="/sapp/landing/component/saveRow" />

	<c:url var="downIconUrl" value="/images/buttons/down_arrow.png" />
	<c:url var="upIconUrl" value="/images/buttons/up_arrow.png" />
	<c:url var="sortUrl" value="/sapp//landing/component/sort" />

	<script type="text/javascript">
	//<![CDATA[
	function moveUp (componentId) {
		$.ajax({
            type: 'get',
            url: '${sortUrl}?componentId=' + componentId + '&order=-1',
            success: function (response) {
                $('#modalDiv').html(response);
            }
        });		
	}
	    
	function moveDown (componentId) {
		$.ajax({
            type: 'get',
            url: '${sortUrl}?componentId=' + componentId + '&order=1',
            success: function (response) {
                $('#modalDiv').html(response);
            }
        });		
	}
	
	//Start -- Added for implementing Build DM-364
	function deleteRow(id) {
		var r = confirm("Are you sure you want to delete this component?");
		if (r == true) {
			$.ajax({
	            type: 'post',
	            url: '${deleteUrl}?deleteId=' + componentId,
	            success: function (response) {
	                $('#modalDiv').html(response);
	                repositionDialog();
	            }
	        });
		} else {
		    return false;
		}
	}	
	//End -- Added for implementing Build DM-364

	/* function deleteRow(componentId) {
		$.ajax({
            type: 'post',
            url: '${deleteUrl}?deleteId=' + componentId,
            success: function (response) {
                $('#modalDiv').html(response);
                repositionDialog();
            }
        });
	} */
	
	function editRow(componentId) {
		$('#row_' + componentId).load("${editRowUrl}?componentId=" + componentId);	
	}

	
		
	function saveRow(componentId) {
		$('#row_' + componentId + " td:first").html("saving...");
		
		$.ajax({
            type: 'post',
            url: '${saveRowUrl}',
            data: $('#editForm').serialize(),
            success: function (response) {
                $('#row_' + componentId).html(response);
                repositionDialog();
            }
        });
	}

	$(document).ready(function() {
		$('#componentListTable').dataTable( {
			"aoColumns": [
				{ "sWidth" : "10%", "sClass" : "center", "bSortable" : false, "bSearchable" : false }, // Delete
				{ "sWidth" : "35%" }, // Name
				{ "sWidth" : "35%" }, // Category
				{ "sWidth" : "10%" } // Sort Order
			],
			"aaSorting": [[3, "asc"], [1, "asc" ]],

			"bAutoWidth": false,
			"bProcessing": true,
			"bStateSave": true,
			"bFilter": false,
	        "bSort": false,
			"sScrollY": "500px",
	        "bPaginate": false,
	        "bScrollCollapse": true
		} );
		
		$('#editForm').submit(function() {
			return false;
		});
		
		$('#componentForm').submit(function() {
			$.ajax({
	            type: 'post',
	            url: '${simpleAddUrl}',
	            data: $('#componentForm').serialize(),
	            success: function (response) {
	                $('#modalDiv').html(response);
	                repositionDialog();
	            }
	        });
			return false;
		});
	} );
	
	$('#closeLink').click (function() {
		$modalDialog.dialog("close");
	});	
	//]]>	
	</script>
	
    <jsp:directive.include file="/WEB-INF/tiles/pages/include/generalMessage.jspx" />

		<h3>Existing components for this product</h3>
		<form:form modelAttribute="editForm">
		<table class="display" id="componentListTable">
			<thead>
				<tr>
					<th>Delete</th>
					<th>Category</th>
					<th>Name</th>
					<th>Sort</th>
				</tr>
			</thead>
			<tbody>
				<c:forEach items="${componentList}" var="component" varStatus = "status">
					<tr id="row_${component.id}"   onblur="saveRow(${component.id});">
						<td>
							<jsp:element name="input">
								<jsp:attribute name="type">image</jsp:attribute>
								<jsp:attribute name="alt">Delete Component</jsp:attribute>
								<jsp:attribute name="onclick">deleteRow('${component.id}')</jsp:attribute>
								<jsp:attribute name="src">
									<c:url value="/images/buttons/delete-icon.png" />
								</jsp:attribute>
							</jsp:element>
						</td>
						<td onclick="editRow(${component.id})"><c:out value="${component.category.description}" /></td>
						<td onclick="editRow(${component.id})" ><c:out value="${component.name}" /> </td>
						<td>
							<c:if test="${not status.first}"> 
								<a href="#" onclick="moveUp(${component.id}); return false;"> <img src="${upIconUrl}" /> </a>
							</c:if>
							<c:if test="${not status.last}">
						 		<a href="#" onclick="moveDown(${component.id}); return false;"> <img src="${downIconUrl}" /> </a>
						 	</c:if>
						</td>
					</tr>
				</c:forEach>
			</tbody>
		</table>
		</form:form>


	<form:form modelAttribute="componentForm" action="${simpleAddUrl}">
		<h3>Add component</h3>
		<spring:hasBindErrors name="componentForm">
			<jsp:directive.include file="/WEB-INF/tiles/pages/include/formErrors.jspx" />
		</spring:hasBindErrors>
	    <form:hidden path="component.commonWork.id" />
	    <form:label path="component.category" cssClass="required" cssErrorClass="error">Category: </form:label>
        <form:select path="component.category">
		    <form:options items="${componentCategoryList}" itemValue="code" itemLabel="description" />
		</form:select>
        <form:label path="component.name" cssClass="required" cssErrorClass="error">Name: </form:label>
        <form:input path="component.name" size="20" maxlength="255" />
     
		<jsp:element name="input">
			<jsp:attribute name="type">submit</jsp:attribute>
			<jsp:attribute name="value">Add</jsp:attribute>
		</jsp:element>		
<!-- 	
			    <td class="label">
			        <form:label path="component.sortOrder" cssClass="optional" cssErrorClass="error">Sort Order</form:label>
			    </td>
			    <td class="value">
			        <form:input path="component.sortOrder" size="5" maxlength="5" />
			    </td>
 -->			    
	</form:form>

	<div class="buttonset">		
		<button id="closeLink">Close</button>
	</div>

</jsp:root>
