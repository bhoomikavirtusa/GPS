<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/landing/source/submit_wiley" />
	<c:url var="prevUrl" value="/sapp/landing/source/main" />
	<c:url var="productSearchUrl" value="${wileyfn:getRestUrl(pageContext.request)}/service/product/search" />
	<c:url var="isbnSearchUrl" value="${wileyfn:getRestUrl(pageContext.request)}/service/product/isbnsearch" />
	<c:url var="productDataUrl" value="${wileyfn:getRestUrl(pageContext.request)}/service/product/loadProductData" />
	
	<!--include as jspx so the jsp variable are recognized-->
	<jsp:directive.include file="js/wizard.buttons.js.jspx" />
	
	<h3>${sourceWizardForm.assetUse.asset.description} 
	| ${sourceWizardForm.assetUse.asset.mediaType.description}
	| Page ${sourceWizardForm.assetUse.manuscriptPage}
	| ${sourceWizardForm.assetUse.usage.description} ${sourceWizardForm.assetUse.position} </h3>
	<div class="requiredtxt">* indicates required field</div>
	
	<form:form modelAttribute="sourceWizardForm" action="${submitUrl}">
		<table>
			<tr>
				<td></td>
				<td colspan="3">
					<span class="explanation">Enter the title or ISBN of source Wiley product</span>
				</td>
			</tr>
			<tr>
				<td class="label">
					Title:
				</td>
				<td class="value" colspan="3">
					<form:input path="assetUse.pickupTitle" size="40" class="required"/>
				</td>
				
				<td class="label">
					Author:
				</td>
				<td class="value" colspan="3">
					<form:input path="assetUse.pickupAuthor" size="40" />
				</td>
			</tr>
			
			<tr>
				<td class="label">
					<form:label path="assetUse.pickupISBN" cssClass="required" cssErrorClass="error">ISBN:</form:label>
				</td>
				<td class="value" colspan="3">
					<form:input path="assetUse.pickupISBN" size="13" class="required"/>
				</td>
				
				<td class="label">
					Medium:
				</td>
				<td class="value">
					<form:input path="medium" size="13" />
				</td>
			</tr>
			
			<tr>
				<td>
				
				</td>
				<td colspan="3">
					
				</td>
				<td class="label">
					Edition:
				</td>
				<td class="value">
					<form:input path="editionNumber" size="13"/>
				</td>
			</tr>
			
			<tr>
				<td></td>
				<td colspan="3">
					<span class="explanation">Enter where asset is located in the source product</span>
				</td>
			</tr>
			
			<tr>
				<td class="label">
					Original page #:
				</td>
				<td class="value">
					<form:input path="assetUse.pickupPage" size="7" maxlength="7"/>
				</td>
				
				<td class="label">
					Original figure#:
				</td>
				<td class="value"> 
					<form:input path="assetUse.pickupPosition" size="7" maxlength="7"/>
				</td>
			</tr>
			<tr>
				<td></td>
				<td></td>
				<td></td>
				<td>
					<span class="explanation">e.g. figure #, other label</span>
				</td>
			</tr>
			
			<c:if test="${sourceWizardForm.includeAssetDescription}">	 
				<tr>
					<td class="label">
						<form:label path="assetUse.asset.description" cssClass="required" cssErrorClass="error">Asset Description:</form:label>
					</td>
					<td class="value">
						<form:input path="assetUse.asset.description" size="100" maxlength="100" class="required" />
					</td>
				</tr>
			</c:if>
<!-- 
			<tr>
				<td>
					Estimated cost:
				</td>
				<td colspan="3"> 
					<form:input path="assetUse.estimatedCost" size="10" maxlength="10" />
					<form:select path="assetUse.estimatedCurrency">
						<form:options items="${currencies}" itemValue="code" itemLabel="description" />
					</form:select>			
				</td>				
			</tr>
 -->
			<tr>
				<td>
					Comments or special instructions:
				</td>
				<td colspan="3">
					<form:textarea path="assetUse.pickupComment" htmlEscape="true" cols="40" rows = "3"/>
				</td>
			</tr>
		</table>
	</form:form>

	<div class="buttonset">
		<input type="button" id="prevB" value="Previous"/>	
	
		<c:if test="${!sourceWizardForm.multiAsset}">
			<!--  input type="submit" id="finishB" value="Finish"/-->
			<input type="submit" id="nextB" value="Continue"/>
		</c:if>
		<c:if test="${sourceWizardForm.lastAssetUse}">
			<input type="submit" id="finishB" value="Finish"/>
		</c:if>

		<c:if test="${sourceWizardForm.multiAsset}">
			<c:if test="${!sourceWizardForm.lastAssetUse}">
				<input type="submit" id="finishC" value="Save and process Next Asset"/>
			</c:if>
		</c:if>
	
		<a href="#" id="cancelLink" class="button">Cancel</a> 	
	</div>
		
	<script type="text/javascript">
	//<![CDATA[
	$(document).ready(function() {	 
		$( "input[id='assetUse.pickupTitle']" ).autocomplete({
			source: function( request, response ) {
				$.jsonp({
					"url": '${productSearchUrl}/' + request.term + '?callback=?', 
					"success": function(json) {
					
						response( $.map( json, function( item ) {
							return {
								value: item.title,
								isbn: item.isbn13,
								author: item.author
							}
						}));
					},
					"error": function() {
			        	alert ("Error: failed to search product");
			        }
		        });				
			},
			minLength: 3,
			select: function( event, ui ) {
				$( "input[id='assetUse.pickupAuthor']" ).val (ui.item.author);
				$( "input[id='assetUse.pickupISBN']" ).val (ui.item.isbn);
				getProdData ();

				
			},
			open: function() {
				$( this ).removeClass( "ui-corner-all" ).addClass( "ui-corner-top" );
			},
			close: function() {
				$( this ).removeClass( "ui-corner-top" ).addClass( "ui-corner-all" );
			}
		});


		$( "input[id='assetUse.pickupISBN']" ).autocomplete({
			source: function( request, response ) {
				$.jsonp({
					"url": '${isbnSearchUrl}/' + request.term + '?callback=?', 
					"success": function(json) {
						response( $.map( json, function( item ) {
							return {
								value: item.isbn13,
								title: item.title,
								author: item.author,
								medium: item.mediumCode
							}
						}));
					},
					"error": function() {
			        	alert ("Error: failed to search product");
			        }
		        });				
			},
			minLength: 10,
			select: function( event, ui ) {
				$( "input[id='assetUse.pickupAuthor']" ).val (ui.item.author);
				$( "input[id='assetUse.pickupTitle']" ).val (ui.item.title);
				getProdData ();
			//	$( "input[id='medium']" ).val (ui.item.mediumCode);
			},
			open: function() {
				 var $children = jQuery(this).data('autocomplete').menu.element.children();
				  if ($children.size() == 1)
				  {
				    $children.children('a').mouseenter().click();
				  }			
				$( this ).removeClass( "ui-corner-all" ).addClass( "ui-corner-top" );
			},
			close: function() {
				$( this ).removeClass( "ui-corner-top" ).addClass( "ui-corner-all" );
			}
			
		});

	});

	function getProdData () {
		isbn = $( "input[id='assetUse.pickupISBN']" ).val();
		$.jsonp({
			"url": '${productDataUrl}/' + isbn + '?callback=?', 
			"success": function(json) {
					$( "input[id='medium']" ).val (json[0].mediumCode)
					$( "input[id='editionNumber']" ).val (json[0].editionNumber)
				
			},
			"error": function() {
	        	alert ("Error: failed to find product " + isbn);
	        }
        });	
	}

	//]]>		
	</script>	 

</jsp:root>
