<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"	
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/landing/source/submit_3rdparty" />
	<c:url var="prevUrl" value="/sapp/landing/source/3rdpartyi_sourcedetails?lastAssetUse=false" />
	<c:url var="landingMainUrl" value="/sapp/cwlanding/main?cwId=${cwId}" />
	
	<!--include as jspx so the jsp variable are recognized-->
	<jsp:directive.include file="js/wizard.buttons.js.jspx" />
	
	<h3>${sourceWizardForm.assetUse.asset.description} 
	| ${sourceWizardForm.assetUse.asset.mediaType.description}
	| Page ${sourceWizardForm.assetUse.manuscriptPage}
	| ${sourceWizardForm.assetUse.usage.description} ${sourceWizardForm.assetUse.position} </h3>
	
	<div class="requiredtxt">* indicates required field</div>	
	<form:form modelAttribute="sourceWizardForm" method="POST" enctype="multipart/form-data" action="${nextUrl}">
		<table>		
		<c:if test="${sourceWizardForm.assetUse.asset.mediaType.photoEquivalent}">			
			<tr>
				<td colspan="4">
					How the asset will be used in the book
				</td>
			</tr>
			<tr>
				<td class="label">
					Caption:
				</td>
				<td class="value" colspan="3">
					<form:input path="assetUse.caption" size="20" maxlength="500"/>
				</td>
			</tr>
			<tr>
				<td>
				</td>
				<td colspan="3">
					<span class="explanation">This is the text description you want to appear under the image, etc.</span>				
				</td>
			</tr>
		
			<tr>
				<td class="label">
					<form:label path="assetUse.color" cssClass="required" cssErrorClass="error">BW/Color ?:</form:label>
				</td>
				<td class="value" colspan="3">
					<form:radiobutton path="assetUse.color" value="false" />Black and White
					<form:radiobutton path="assetUse.color" value="true" />Color
				</td>
			</tr>
			<tr>
				<td class="label">
					<form:label path="assetUse.size" cssClass="required" cssErrorClass="error">Photo size:</form:label>
				</td>
				<td class="value" colspan="3">
					<form:select path="assetUse.size" class="required">
						<form:options items="${sizes}" itemValue="code" itemLabel="description" />
					</form:select>	
				</td>
			</tr>
			<tr>
				<td class="label">
					<form:label path="assetUse.pagePosition" cssClass="required" cssErrorClass="error">Photo position:</form:label>
				</td>
				<td class="value" colspan="3">
					<form:select path="assetUse.pagePosition" class="required">
						<form:options items="${pagePositions}" itemValue="code" itemLabel="description" />
					</form:select>	
				</td>
			</tr>
			<tr>
				<td class="label">
					<form:label path="assetUse.asset.modelRelease" cssClass="required" cssErrorClass="error">Model Release/Patient Consent:</form:label>
				</td>
				<td class="value" colspan="3">
					<form:select path="assetUse.asset.modelRelease">
						<form:options items="${modelReleases}" itemValue="code" itemLabel="name" />
					</form:select>
				</td>
			</tr>
			<tr>
				<td colspan="4">
					You can upload the original asset or thumbnail for reference. Max file size is 500MB.
					<table>
						<tr>
							<td>
						       	Select files to upload
							</td>
							<td>
						   		<c:if test="${sourceWizardForm.assetFromCMS}">
						   			<input type="file" name="files" size="40" disabled="disabled" />
						   		</c:if>
						   		<c:if test="${not sourceWizardForm.assetFromCMS}">
						   			<input type="file" name="files" size="40" />
						   		</c:if>
							</td>
						</tr>
						
						<c:if test="${not empty sourceWizardForm.assetUse.asset.originalFile}">
							<tr>
								<td class="label">Original File</td>
								<td class="value">
									(${sourceWizardForm.assetUse.asset.originalFile.objectName})
									(${wileyfn:filesize(sourceWizardForm.assetUse.asset.originalFile.data)})
									uploaded on <fmt:formatDate type="date" value="${sourceWizardForm.assetUse.asset.originalFile.lastUpdatedDate}" />				
								</td>
							</tr>
						</c:if>
					</table> 
				</td>
			</tr>			
		</c:if>
		<c:if test="${sourceWizardForm.assetUse.asset.mediaType.textEquivalent}">	
			<tr><td></td></tr>
			<tr><td></td></tr>
			<tr>
				<td colspan="4">
					<b>Please enter the page ranges from the source publication</b>
				</td>
			</tr>
			<tr>
				<td colspan="4">
					<b>text you are using</b>
				</td>
			</tr>
			
			<tr>
				<td>From 1: </td>
				<td>
					<form:input path="assetUse.asset.from1" size="5" maxlength="25"/>
				</td>
				<td>To 1: </td>
				<td>
					<form:input path="assetUse.asset.to1" size="5" maxlength="25"/>
				</td>
			</tr>
			<tr>
				<td>From 2: </td>
				<td>
					<form:input path="assetUse.asset.from2" size="5" maxlength="25"/>
				</td>
				<td>To 2: </td>
				<td>
					<form:input path="assetUse.asset.to2" size="5" maxlength="25"/>
				</td>
			</tr>
			<tr>
				<td>From 3: </td>
				<td>
					<form:input path="assetUse.asset.from3" size="5" maxlength="25"/>
				</td>
				<td>To 3: </td>
				<td>
					<form:input path="assetUse.asset.to3" size="5" maxlength="25"/>
				</td>			
			</tr>
		</c:if>
	
			<c:if test="${sourceWizardForm.includeAssetDescription}">	 
				<tr>
					<td class="label">
						<form:label path="assetUse.asset.description" cssClass="required" cssErrorClass="error">Asset Description:</form:label>
					</td>
					<td class="value">
						<form:input path="assetUse.asset.description" size="100" maxlength="100" class="required" />
					</td>
				</tr>
			</c:if>

			<tr>
				<td colspan="4">
					Add bibliographic reference <form:checkbox path="hasBiblio"/> 
				</td>
			</tr>	
			
			<tbody id="biblioDiv" style="margin-left: 2em;display:none;" >
			<tr>
				<td>
					Citation:
				</td>
				<td colspan="3">
					<form:textarea path="assetUse.asset.citation" htmlEscape="true" cols="40" rows = "3"/>				
				</td>
			</tr>	
	
			<tr>
				<td>
					Biblio ref.:
				</td>
				<td colspan="3">
					<form:textarea path="assetUse.asset.biblio" htmlEscape="true" cols="40" rows = "3"/>				
				</td>
			</tr>
			</tbody>
			<tr>
				<td>
					Estimated cost:
				</td>
				<td colspan="3"> 
					<form:input path="assetUse.estimatedCost" size="10" maxlength="10" />
					<form:select path="assetUse.estimatedCurrency">
						<form:options items="${currencies}" itemValue="code" itemLabel="description" />
					</form:select>			
				</td>				
			</tr>
			
		<c:if  test="${not empty sourceWizardForm.masterAgreementDeals}"> 
			<tr>
				<td><b>Master Agreement Details</b></td>
				<td>
					<c:if test="${sourceWizardForm.multiDeal}">
					<select id="pricing">
						<option value="">--Select desired deal to see pricing--</option>
						<c:forEach items="${sourceWizardForm.masterAgreementDeals}" var="deal">
							<option value="${deal.pricingInfo}">${deal.name}</option>
						</c:forEach>
					</select>
					</c:if>
					<c:if test="${!sourceWizardForm.multiDeal}">
						<c:forEach items="${sourceWizardForm.masterAgreementDeals}" var="deal">
							${deal.name}
						</c:forEach>
					</c:if>
				</td>
			</tr>
	
			<tr>
				<td>Pricing information for <br/>this agreement</td>
				<!-- Put c:out right after TD since showing white-space -->
				<td id="pricingData" style="white-space: pre-wrap; word-wrap: break-word; word-break: break-all"><c:out value="${sourceWizardForm.selectedDealPricing}" />​
				</td>
			</tr>
		</c:if>
			<tr>
				<td>
					Permission comment:
				</td>
				<td colspan="3">
					<form:textarea path="assetUse.permissionComment" htmlEscape="true" cols="40" rows="3" maxlength="5000" />				
				</td>
			</tr>

		</table>
	<div class="buttonset">	
		<input type="button" id="prevB" value="Previous"/>
		
		<c:if test="${!sourceWizardForm.multiAsset}">
			<input type="submit" id="uploadFinishB" value="Finish"/>
		</c:if>
		
		<c:if test="${sourceWizardForm.multiAsset}">
			<c:if test="${!sourceWizardForm.lastAssetUse}">
				<input type="submit" id="uploadFinishC" value="Save and process Next Asset"/>
			</c:if>
			<c:if test="${sourceWizardForm.lastAssetUse}">
				<input type="submit" id="uploadFinishB" value="Finish"/>
			</c:if>
		</c:if>
		<a href="#" id="cancelLink" class="button">Cancel</a> 	
	</div>
	</form:form> 

	<script type="text/javascript">
	//<![CDATA[
	$(document).ready(function() {
		var hasBiblio = ${sourceWizardForm.hasBiblio};
		var nextAsset = ${sourceWizardForm.multiAsset && !sourceWizardForm.lastAssetUse};
	
		if (hasBiblio)
			$('#biblioDiv').toggle();
			
		$('#hasBiblio1').click (function() {
			$('#biblioDiv').toggle();
		});
		
		//do not use the wizard.button definition - we need the upload function
		$('#sourceWizardForm').ajaxForm({
				beforeSubmit: function() {
					return $("#sourceWizardForm").validate().form();
				}, 
				success: function (response){
					// because of file upload, the error method is not called
					if (response.indexOf ('Error') > -1) {
            			$('#modalDiv').empty().html(response);
            			repositionDialog();
					} else {
	                	fnRefreshRows (${sourceWizardForm.assetUse.id});
	                	refreshPanels (${sourceWizardForm.assetUse.commonWork.id});
	                	if (nextAsset) {
	                		$('#modalDiv').empty().html(response);
	                	} else {
	               			$modalDialog.dialog("close");
	               		}
	               	}
					// reload whole page to strike through no fly asset record
	                document.location.href = "${landingMainUrl}";
            	},
            	error: function(response,error) {
            		 $('#modalDiv').html(response);
            		 repositionDialog();
            	}		
		});

		$('#pricing').change(function() {
			$("#pricing option:selected").each(function () {
				$('#pricingData').html($(this).val());
	        });
		});
	});
	//]]>		
	</script>	
</jsp:root>
