<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:security="http://www.springframework.org/security/tags"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="nextUrl" value="/sapp/landing/source/submit_author" />
	<c:url var="prevUrl" value="/sapp/landing/source/main" />
	
<h3>${sourceWizardForm.assetUse.asset.description} 
	| ${sourceWizardForm.assetUse.asset.mediaType.description}
	| Page ${sourceWizardForm.assetUse.manuscriptPage}
	| ${sourceWizardForm.assetUse.usage.description} ${sourceWizardForm.assetUse.position} </h3>
<div class="requiredtxt">* indicates required field</div>

<!--include as jspx so the jsp variable are recognized-->
<jsp:directive.include file="js/wizard.buttons.js.jspx" />

<form:form modelAttribute="sourceWizardForm" method="POST" enctype="multipart/form-data" action="${nextUrl}">
	<table>
		<tr><td>Asset Type: </td><td>${sourceWizardForm.assetUse.asset.mediaType.description}</td></tr>
	<c:if test="${sourceWizardForm.assetUse.asset.mediaType.description == 'Photo'}">	
		<tr>
			<td class="label">
				<form:label path="assetUse.color" cssClass="required" cssErrorClass="error">BW/Color ?:</form:label>
			</td>
			<td class="value">
				<form:radiobutton path="assetUse.color" value="false" class="required"/>Black and White
				<form:radiobutton path="assetUse.color" value="true" class="required"/>Color
			</td>
		</tr>
	</c:if>
		<tr>
			<td class="label">
				<form:label path="assetUse.size" cssClass="required" cssErrorClass="error">Size:</form:label>
			</td>
			<td class="value">	
				<form:select path="assetUse.size">
					<form:options items="${sizes}" itemValue="code" itemLabel="description" class="required"/>
				</form:select>
			</td>
		</tr>
		<tr>
			<td class="label">
				<form:label path="assetUse.caption" cssClass="required" cssErrorClass="error">Caption:</form:label>
			</td>
			<td class="value">
				<form:textarea path="assetUse.caption" htmlEscape="true" cols="40" rows="3" maxlength="500" />
			</td>
		</tr>
		<tr>
			<td class="label">
				<form:label path="assetUse.mediaReturnRequested" cssClass="required" cssErrorClass="error">Media Return Requested:</form:label>
			</td>
			<td class="value">
				<form:radiobutton path="assetUse.mediaReturnRequested" value="true" class="required"/>Yes
				<form:radiobutton path="assetUse.mediaReturnRequested" value="false" class="required"/>No
			</td>
		</tr>
		<tr>
			<td class="label">
				<form:label path="assetUse.asset.modelRelease" cssClass="required" cssErrorClass="error">Model Release:</form:label>
			</td>
			<td class="value">
				<form:select path="assetUse.asset.modelRelease">
					<form:options items="${modelReleases}" itemValue="code" itemLabel="name" />
				</form:select>
			</td>
		</tr>
		<tr>
			<td class="label">
				<form:label path="assetUse.asset.propertyRelease" cssClass="required" cssErrorClass="error">Property Release:</form:label>
			</td>
			<td class="value">
				<form:radiobutton path="assetUse.asset.propertyRelease" value="true" class="required"/>Yes
				<form:radiobutton path="assetUse.asset.propertyRelease" value="false" class="required"/>No
			</td>
		</tr>
	
		<c:if test="${sourceWizardForm.includeAssetDescription}">	 
			<tr>
				<td class="label">
					<form:label path="assetUse.asset.description" cssClass="required" cssErrorClass="error">Asset Description:</form:label>
				</td>
				<td class="value">
					<form:input path="assetUse.asset.description" size="100" maxlength="100" class="required" />
				</td>
			</tr>
		</c:if>
		<tr>
			<td class="label">
				Estimated cost:
			</td>
			<td class="value">
				<form:input path="assetUse.estimatedCost" size="10" maxlength="10" />
				<form:select path="assetUse.estimatedCurrency">
					<form:options items="${currencies}" itemValue="code" itemLabel="description" />
				</form:select>
			</td>
		</tr>
		<tr>
			<td class="label">
				Comments or special instructions:
			</td>
			<td class="value">
				<form:textarea path="assetUse.permissionComment" htmlEscape="true" cols="40" rows = "3"/>
			</td> 
		</tr>
	</table>
	<security:authorize access="hasAnyRole('upload_asset_file', 'EMPLOYEE_DEFAULT')">
		Would you like to upload an original Photo?
		You can upload files up to 1024 MB.
		<table>
			<tr>
				<td>
			       	Select files to upload
				</td>
				<td>
			   		<c:if test="${sourceWizardForm.assetFromCMS}">
			   			<input type="file" name="files" size="40" disabled="disabled" />
			   		</c:if>
			   		<c:if test="${not sourceWizardForm.assetFromCMS}">
			   			<input type="file" name="files" size="40" />
			   		</c:if>
				</td>
			</tr>
			
			<c:if test="${not empty sourceWizardForm.assetUse.asset.originalFile}">
				<tr>
					<td class="label">Original File</td>
					<td class="value">
						(${sourceWizardForm.assetUse.asset.originalFile.objectName})
						(${wileyfn:filesize(sourceWizardForm.assetUse.asset.originalFile.data)})
						uploaded on <fmt:formatDate type="date" value="${sourceWizardForm.assetUse.asset.originalFile.lastUpdatedDate}" />				
					</td>
				</tr>
			</c:if>
		</table> 
</security:authorize>

	<div class="buttonset">	
	<input type="button" id="prevB" value="Previous"/>
	
	<c:if test="${!sourceWizardForm.multiAsset}">
		<input type="submit" value="Finish"/>
	</c:if>
	<c:if test="${sourceWizardForm.lastAssetUse}">
		<input type="submit" value="Finish"/>
	</c:if>
	
	<c:if test="${sourceWizardForm.multiAsset}">
		<c:if test="${!sourceWizardForm.lastAssetUse}">
			<input type="submit" value="Save and process Next Asset"/>
		</c:if>
	</c:if>
	<a href="#" id="cancelLink" class="button">Cancel</a> 		
	</div>
</form:form>
	
	<script type="text/javascript">
	    $('#sourceWizardForm').ajaxForm({
	        success: function(data) {
            	fnRefreshRows (${sourceWizardForm.assetUse.id});
            	refreshPanels (${sourceWizardForm.assetUse.commonWork.id});
        		if (${sourceWizardForm.multiAsset and !sourceWizardForm.lastAssetUse}) {
        			$('#modalDiv').empty().html(data);
        			// load will do POST again - not good
        			// $('#modalDiv').load("${multiNextUrl}");
        		} else {
            		$modalDialog.dialog("close");
            	}
        	},
        	error: function(request,error) {
        		 $('#modalDiv').html(response);
        		 repositionDialog();
        	}
	    });	
	</script>
</jsp:root>
