<?xml version="1.0" encoding="UTF-8" ?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions"
>
	<jsp:directive.page pageEncoding="UTF-8" />
	
	<jsp:element name="link">
		<jsp:attribute name="rel">stylesheet</jsp:attribute>
		<jsp:attribute name="type">text/css</jsp:attribute>
		<jsp:attribute name="href">
			<c:url value="/css/swfupload/default.css"/>
		</jsp:attribute>
	</jsp:element>
	
	
	
	<jsp:element name="script">
		<jsp:attribute name="type">text/javascript</jsp:attribute>
		<jsp:attribute name="src">
			<c:url value="/js/swfupload/swfupload.js"/>
		</jsp:attribute>
		// Placeholder
	</jsp:element>

	<jsp:element name="script">
		<jsp:attribute name="type">text/javascript</jsp:attribute>
		<jsp:attribute name="src">
			<c:url value="/js/swfupload/swfupload.swfobject.js"/>
		</jsp:attribute>
		// Placeholder
	</jsp:element>

	<jsp:element name="script">
		<jsp:attribute name="type">text/javascript</jsp:attribute>
		<jsp:attribute name="src">
			<c:url value="/js/swfupload/swfupload.queue.js"/>
		</jsp:attribute>
		// Placeholder
	</jsp:element>

	<jsp:element name="script">
		<jsp:attribute name="type">text/javascript</jsp:attribute>
		<jsp:attribute name="src">
			<c:url value="/js/swfupload/fileprogress.js"/>
		</jsp:attribute>
		// Placeholder
	</jsp:element>
				

	<jsp:element name="script">
		<jsp:attribute name="type">text/javascript</jsp:attribute>
		<jsp:attribute name="src">
			<c:url value="/js/swfupload/handlers.js"/>
		</jsp:attribute>
		// Placeholder
	</jsp:element>
	
	

	<script type="text/javascript">
	//<![CDATA[
		$(document).ready(function() {
			$('#productFileTable').dataTable( {
				"aoColumns" : [
					{ "sWidth" : "10px", "sClass" : "center", "bSortable" : false, "bSearchable" : false }, // Delete
					{ "sWidth" : "100%" } // Name
				],
				"aaSorting": [[1, "asc" ]],

				"bAutoWidth": false,
				"bProcessing": true,
				"bStateSave": true,
				"sPaginationType": "full_numbers",
				"aLengthMenu": [10, 15, 25, 50, 100],  // override default of [10, 25, 50, 100]
				"iDisplayLength": 15 // override default of 10
			} );
			
			$('#closeLink').click (function() {
				$modalDialog.dialog("close");
			});
			
			//The below code gets called on unload of the current dialog by clicking close button (including the "X").
			$modalDialog.dialog({
				close: function() {document.location.href = "${landingpageURL}";}
			});
			
		});
	//]]>
	</script>
	
	
	
	<c:url var="flashUrl" value="/js/swfupload/swfupload.swf" />
	<c:url var="uploadUrl" value="/sapp/cw/files/upload" />
	<c:url var="uploadButtonUrl" value="/images/buttons/XPButtonUploadText_61x22.png" />
	<c:url var="uploadCompleteUrl" value="/sapp/cw/files/view" />
	<c:url var="landingpageURL" value="/sapp/cwlanding/scroll?cwId=${commonWorkId}" />

<jsp:body>
	<form id="uploadForm" method="post" enctype="multipart/form-data">
	<table>
		<tr>
			<td>
				Click "Choose Files" to upload files. These files will be stored with this product - if you have returned forms to upload,
				you should upload those at the contract.
				<div id="divSWFUploadUI">
					<!-- <div class="fieldset  flash" id="fsUploadProgress">
					<span class="legend">Upload Queue</span>
					</div>
					<p id="divStatus">0 Files Uploaded</p>
					
						<input id="btnCancel" type="button" value="Cancel All Uploads" disabled="disabled" />-->
						<p>
						<input type="file" id="ajaxFiles" name="ajaxFiles" multiple="multiple" size="60" onchange="myFunction(${commonWorkId},${ISBN})" />
					<!--  	<span id="spanButtonPlaceholder"></span>-->
					
					<div class="progress">
   						 <div class="progress-bar"></div>
					</div>
					
					
					
					
						<br />
					</p>
				</div>
			<!-- <<noscript>
					<div style="margin: 10px 25px; padding: 10px 15px;">
						We're sorry.  SWFUpload could not load.  You must have JavaScript enabled to enjoy SWFUpload.
					</div>
				</noscript>
				<div id="divLoadingContent" class="content" style="margin: 10px 25px; padding: 10px 15px; display: none;">
					SWFUpload is loading. Please wait a moment...
				</div>
				<div id="divLongLoading" class="content" style="margin: 10px 25px; padding: 10px 15px; display: none;">
					SWFUpload is taking a long time to load or the load has failed.
					Please make sure that the Flash Plugin is enabled and that a working version of the Adobe Flash Player is installed.
				</div>
				<div id="divAlternateContent" class="content" style="margin: 10px 25px; padding: 10px 15px; display: none;">
					We're sorry.  SWFUpload could not load.  You may need to install or upgrade Flash Player.
					Visit the <a href="http://www.adobe.com/shockwave/download/download.cgi?P1_Prod_Version=ShockwaveFlash">Adobe website</a>
					to get the Flash Player.
				</div>-->
			</td>
		</tr>
		<tr>
			<td>
				<h3>Available Product Files</h3>
				<table class="display" style="width: 100%" id="productFileTable">
					<thead>
						<tr>
							<th>Delete</th>
							<th>Name</th>
						</tr>
					</thead>
					<tbody>
						<c:forEach items="${files}" var="file">
							<tr>
								<td>
									<div id="file${file.id}">
										<c:url var="deleteFileUrl" value="/sapp/cw/files/delete" />
										<c:url var="deleteIconUrl" value="/images/buttons/delete-icon.png" />
										<a href="#" onClick="fnDeleteFile(${file.id})"><img src="${deleteIconUrl}" /></a>
									</div>
								</td>
								<td>
									<jsp:element name="a">
										<jsp:attribute name="href">
											<c:url value="/sapp/cw/files/download?fileId=${file.id}"/>
										</jsp:attribute>
										<c:out value="${file.fileName}" />
									</jsp:element>
								</td>
							</tr>
						</c:forEach>
					</tbody>
				</table>
			</td>
		</tr>
	</table>
	</form>			

	<script type="text/javascript">
	//Start -- Added for implementing Build RN 160121-001880 //Updated this method for DM-364
	function fnDeleteFile(id) {
		var deleteURL = "${deleteFileUrl}?fileId="+id;
		var r = confirm("Are you sure you want to delete this file?");
		if (r == true) {
			$("#modalDiv").load(deleteURL);
		} else {
		    return false;
		}
	}
	//End -- Added for implementing Build RN 160121-001880
	
	</script>
	
	<script type="text/javascript">
	//Start -- Added for implementing Build RN 160121-001880 //Updated this method for DM-364
	
	<![CDATA[
	function myFunction(commonWorkId,isbn){
		 event.preventDefault();
		 
		 var filename = document.getElementById("ajaxFiles");
	
		 
		  

		  fire_ajax_submit(commonWorkId,filename,isbn);

		} 
	
	function fire_ajax_submit(commonWorkId,filename,isbn) {

	    // Get form
	    var form = $('#uploadForm')[0];

	    var data = new FormData(form);
	    //alert(filename+" "+isbn);
	    var  len = filename.files.length;
	    
	    try {
	    
	    if(len==0)
	    	{
	    	alert("Please select a file");
	    	return;
	    	}
	   
	    	for(var i=0; i<len; i++)
	    		{
	    		var file = filename.files[i];
	    		//alert(file.name+" "+file.size);
	    		var fileName = file.name;
	    		var nameFile=fileName;
	    		
	    		
	    		//fileNamex = fileName.split(".");
	    		//var length = fileNamex[0].length;
	    		
	    		
	    		
	    		
            
	    		
	    		var fileNames = fileName.split("_");
	    		var fileISBN = fileNames[0] ;
	    		
	    		if(fileISBN == isbn) {
	    			if(file.size > 10485760)
	    			{
	    			alert(nameFile+":File bigger than 10 MB not allowed");
	    			$('#uploadForm').val(null);
	    			form=null;
	    			data=null;
	    			throw nameFile+":File bigger than 10 MB not allowed";
	    			}
	    			
	    		}
	    		else
	    			{
	    			alert(nameFile+":Filename ISBN does not match with Product ISBN.");
	    			$('#uploadForm').val(null);
	    			form=null;
	    			data=null;
	    			throw nameFile+":Filename ISBN does not match with Product ISBN.";
	    			
	    			}
	    			
	    		
	    		fileNames = fileNames.slice(1,fileNames.length).join("_").split(".");
	    		fileNames = fileNames.slice(0,fileNames.length-1);
	    		fileName = fileNames.join(".");
	    		
	    		if(/[^a-zA-Z0-9]/.test(fileName)) {  			
	    			alert(nameFile+":Only alphanumaric is allowed for file name. \nExample:- 9876543210123_PermLetter2");
	    			$('#uploadForm').val(null);
	    			form=null;
	    			data=null;
	    			throw nameFile+":Only alphanumaric is allowed for file name. \nExample:- 9876543210123_PermLetter2";
	    			
    			}
	    		
	    		var fileNamex = fileName.split(".");
	    		var length = fileNamex[0].length;
	    		
	    		if(length < 5 || length > 25) {
	    			alert(nameFile+":Character count for filename text must be between 5 and 25.");
	    			$('#uploadForm').val(null);
	    			form=null;
	    			data=null;
	    			throw nameFile+":Character count for filename text must be between 5 and 25.";
	    		}
	    		
	    		
	    		
	    		
	    		/* if(fileISBN == isbn) {
	    			if(file.size > 10485760)
	    			{
	    			alert(nameFile+":File bigger than 10 MB not allowed");
	    			$('#uploadForm').val(null);
	    			form=null;
	    			data=null;
	    			throw nameFile+":File bigger than 10 MB not allowed";
	    			}
	    			
	    		}
	    		else
	    			{
	    			alert(nameFile+":Filename ISBN does not match with Product ISBN.");
	    			$('#uploadForm').val(null);
	    			form=null;
	    			data=null;
	    			throw nameFile+":Filename ISBN does not match with Product ISBN.";
	    			
	    			}*/
	    			} 
	    		
	    
	    }catch(err)
	     {
	    	console.log("ERROR : ", err);
	      }
	    

	    data.append("commonWorkId", commonWorkId);

	   // $("#btnSubmit").prop("disabled", true);

	    $.ajax({
	    	
	    	xhr: function() {
                var xhr = new window.XMLHttpRequest();
                xhr.upload.addEventListener("progress", function(evt) {
                    if (evt.lengthComputable) {
                        var percentComplete = ((evt.loaded / evt.total) * 100);
                        $(".progress-bar").width(percentComplete + '%');
                        $(".progress-bar").html(percentComplete+'%');
                    }
                }, false);
                return xhr;
            },
	        type: "POST",
	        enctype: 'multipart/form-data',
	        url: "/internal-web/sapp/cw/files/upload",
	        data: data,
	        //http://api.jquery.com/jQuery.ajax/
	        //https://developer.mozilla.org/en-US/docs/Web/API/FormData/Using_FormData_Objects
	        processData: false, //prevent jQuery from automatically transforming the data into a query string
	        contentType: false,
	        cache: false,
	        timeout: 600000,
	        beforeSend: function(){
                $(".progress-bar").width('0%');
                
                
            },
	        success: function (data) {

	           // $("#result").text(data);
	            console.log("SUCCESS : ", data);
	           // $("#btnSubmit").prop("disabled", false);
	            $("#modalDiv").load("${uploadCompleteUrl}");

	        },
	        error: function (e) {

	          //  $("#result").text(e.responseText);
	            console.log("ERROR : ", e);
	           // $("#btnSubmit").prop("disabled", false);

	        }
	    });

	}
	
]]>
	
	//End -- Added for implementing Build RN 160121-001880
	
	</script>
	
	
	
	
	
