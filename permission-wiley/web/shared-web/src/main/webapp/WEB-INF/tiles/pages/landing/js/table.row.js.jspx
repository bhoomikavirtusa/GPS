	// same as fnClickEditPaymentRequestHander(event) above except View instead of Edit (Paid link instead of Pay)
	function fnClickViewPaymentRequestHandler(event) {
		event.preventDefault();
        var id = this.id;
        
		/* 
		 * try to save first the changes
		 */
		if (oSelector.oSelectedRow != null && oSelector.oSelectedRow.fnValid ($('#form'))) {
