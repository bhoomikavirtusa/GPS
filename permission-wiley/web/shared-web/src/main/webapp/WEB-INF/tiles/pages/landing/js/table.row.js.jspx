		}
		fnLoadAddContractDetails (id, false);
	}

	function fnLoadAddContractDetails (id, isCustom) {
		if (oSelector.oSelectedRow != null) {
			if (oSelector.oSelectedRow.bInProgress) {
				setTimeout("fnLoadAddContractDetails(" + id + "," + isCustom + ")", 100);
				return;
			} else {
				// if the row is a new row, we have id = 0 and we need the 
				// new saved id to continue
				if (id == 0)
					id = oSelector.oSelectedRow.fnGetId();
				// reset the selected row
				oSelector.fnSetSelectedRow (null);
			}
		}
		$("#modalDiv").load('${contractPage1Url}?auId=' + id + '&custom=' + isCustom, function() {
			openModalDialog ('Enter grant details');
			oSelector.id = id;
        });
	}

	/*
	 * defines the click action for download PO PDF 
	 */
	function fnClickDownloadPdfHandler(event) {
		event.preventDefault();
        var id = this.id;

		$("#modalDiv").load('${poDownloadUrl}?auId=' + id, function() {
			openModalDialog ('Download');
        });        
	}

	/*
	 * defines the click action for download Contract file
	 */
	function fnClickDownloadContractHandler(event) {
		event.preventDefault();
        var id = this.id;
		
		$.ajax({
        	async: false,
       		type: 'get',
        	url: '${contractDownloadUrl}?auId=' + id,
        	success: function (response){
        		// will return the download page if multiple files, else just download the file
        		if (/html/i.test(response)) {
        			openModalDialog ('Download');
        			$('#modalDiv').empty().html(response);
        		} else {
			   		window.open(response);
            	}
        	},
    	});
	}

