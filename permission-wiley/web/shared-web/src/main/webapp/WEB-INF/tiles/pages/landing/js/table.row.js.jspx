	}

	function fnLoadEditPaymentRequest (id) {
		if (oSelector.oSelectedRow != null) {
			if (oSelector.oSelectedRow.bInProgress) {
				setTimeout("fnLoadEditPaymentRequest(" + id + ")", 100);
				return;
			} else {
				// if the row is a new row, we have id = 0 and we need the 
				// new saved id to continue			
				if (id == 0)
					id = oSelector.oSelectedRow.fnGetId();
				// reset the selected row
				oSelector.fnSetSelectedRow (null);
			}
		}
		
		$("#modalDiv").load('${payUrl}?auId=' + id, function() {
			openModalDialog ('Payment Request');
			oSelector.id = id;
        });
		// prevent the default action, e.g., following a link
		return false;
	}
	
	// same as fnLoadEditPaymentRequest above except View instead of Edit (Paid link instead of Pay)
	function fnLoadViewPaymentRequest (id) {
		if (oSelector.oSelectedRow != null) {
			if (oSelector.oSelectedRow.bInProgress) {
				setTimeout("fnLoadViewPaymentRequest(" + id + ")", 100);
				return;
			} else {
				// if the row is a new row, we have id = 0 and we need the 
				// new saved id to continue			
				if (id == 0)
					id = oSelector.oSelectedRow.fnGetId();
				// reset the selected row
				oSelector.fnSetSelectedRow (null);
			}
		}
		
		$("#modalDiv").load('${paidUrl}?auId=' + id, function() {
			openModalDialog ('Payment Request');
			oSelector.id = id;
        });
		// prevent the default action, e.g., following a link
		return false;
	}
	
	function fnMouseoverShowStatusDetailsHandler (event) {
		var id = this.id;
		// Read the status message from DB - send an ajax call 
		// Another solution might be to add the message in the index and read it with all 
		// the other fields and just display it
		$.jsonp({
			"url": '${statusDetailUrl}' + id + '?callback=?', 
			"success": function(json) {	
		        //Add the tooltip value
		        $('#tooltip').html(json.explanation);
        	}
    	});
        $('#tooltip').show();
         
        //Set the X and Y axis of the tooltip
        $('#tooltip').css('top', event.pageY - 20);
        $('#tooltip').css('left', event.pageX - 20);
	}
	
	function fnMouseoutShowStatusDetailsHandler (event) {
		//Remove the appended tooltip template
		$('#tooltip').html('Loading...');
        $('#tooltip').hide();
	}	

	function fnMouseoverShowCommentsHandler (event) {
		var id = this.id;
		// Read the comments from DB - send an ajax call
		$.jsonp({
			"url": '${commentsUrl}' + id + '?callback=?', 
			"success": function(json) {	
		        //Add the tooltip value
		        $('#tooltip').html(json.comments);
        	}
    	});
        $('#tooltip').show();
         
        //Set the X and Y axis of the tooltip
        $('#tooltip').css('top', event.pageY - 20);
        $('#tooltip').css('left', event.pageX - 20);
	}
	
	function fnMouseoutShowCommentsHandler (event) {
		//Remove the appended tooltip template
		$('#tooltip').html('Loading...');
        $('#tooltip').hide();
	}	

	function fnMouseoverShowThumbnailHandler (event) {
		var id = this.id;
		// Read the comments from DB - send an ajax call
        $('#tooltip').html("<img src='${thumbnailUrl}?assetUseId=" + id + "&size=medium' alt='Thumbnail' />");
        $('#tooltip').show();
         
        //Set the X and Y axis of the tooltip
        $('#tooltip').css('top', event.pageY - 20);
        $('#tooltip').css('left', event.pageX - 20);
	}
	
	function fnMouseoutShowThumbnailHandler (event) {
		//Remove the appended tooltip template
		$('#tooltip').html('Loading...');
        $('#tooltip').hide();
	}	
	
	


	/*
	 * defines the click action for Get Permissions
	 */
	function fnClickGetPermissionsHandler (event) {
		event.preventDefault();
        var id = this.id;
        
		/* 
		 * try to save first the changes
		 */
		if (oSelector.oSelectedRow != null && oSelector.oSelectedRow.fnValid ($('#form'))) {
			oSelector.oSelectedRow.fnSaveForm ($('#form'));
			setTimeout("fnLoadGetPermissions(" + id + ")", 100);
			return;
		}
		fnLoadGetPermissions (id);
	}

	function fnLoadSourceWizard (id) {
		if (oSelector.oSelectedRow != null) {
			if (oSelector.oSelectedRow.bInProgress) {
				setTimeout("fnLoadSourceWizard(" + id + ")", 100);
				return;
			} else {
				// if the row is a new row, we have id = 0 and we need the 
				// new saved id to continue			
				if (id == 0)
					id = oSelector.oSelectedRow.fnGetId();
				// reset the selected row
				oSelector.fnSetSelectedRow (null);
			}
		}

		var dSources = oSelector.fnGetCheckedValues();
		if(null != dSources && dSources != "") {
			$("#modalDiv").load('${sourcePageMultiUrl}?ids=' + dSources, function() {
				openModalDialog ('Enter details');		
				oSelector.id = id;
        	});

		} else {
			$("#modalDiv").load('${sourcePage1Url}?auId=' + id, function() {
				openModalDialog ('Enter details');		
				oSelector.id = id;
        	});
		}
	}

	function fnLoadGetPermissions (id) {
		if (oSelector.oSelectedRow != null) {
			if (oSelector.oSelectedRow.bInProgress) {
				setTimeout("fnLoadGetPermissions(" + id + ")", 100);
				return;
			} else {
				// if the row is a new row, we have id = 0 and we need the 
				// new saved id to continue			
				if (id == 0)
					id = oSelector.oSelectedRow.fnGetId();
				// reset the selected row
				oSelector.fnSetSelectedRow (null);
			}
		}
		$("#modalDiv").load('${poPage1Url}?auId=' + id, function() {
			openModalDialog ('Get permissions');		
			oSelector.id = id;
        });
	}
	
