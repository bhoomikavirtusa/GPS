<?xml version="1.0" encoding="UTF-8"?>

<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:form="http://www.springframework.org/tags/form">
	
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8"/>
	
	<c:url var="assetDetailsUrl" value="/sapp/asset/custom/load?cwId=${current_common_work.id}&amp;auId=${param.auId}" />
	<c:url var="assetPermissionsUrl" value="/sapp/asset/usageandpermissions/start?auId=${param.auId}" />
	
	<c:url var="loadUrl" value="/sapp/asset/main/custom/load" />
	<c:url var="nextUrl" value="/sapp/asset/main/custom/next" />
	<c:url var="prevUrl" value="/sapp/asset/main/custom/prev" />
	<c:url var="addUrl" value="/sapp/asset/main/custom/add" />
	
	<style type="text/css">
	.greybox {
		padding: 0px;
		border: 0px;
		background: transparent;
	}
	
	.ui-widget {
		background: #EEE;
	}
	
	#main {
		margin: 0px;
	}

	ul.ui-tabs-nav {
		display: none;
		visibility:hidden;
	}	
	</style>
	
	<script type="text/javascript">
	//<![CDATA[
	$(document).ready(function() {
		$( "#tabs" ).tabs();

		$('#nextB').click(function() {
			cachenext();
		});
	
		$('#prevB').click(function() {
			cacheprev();
		});
	});
	
	function cachenext() {
		if (typeof cacheForm == 'function') {
			cacheForm("next");
		} else {
			next();
		}
	}

	function cacheprev () {
		if (typeof cacheForm == 'function') {
			cacheForm("prev");
		} else {
			prev();
		}
	}

	function prev() {
		$.ajax({
            async: false,
            type: 'get',
            url: '${prevUrl}',
            success: function (response){
                $('#modalDiv').empty().html(response);
                repositionDialog();
            }
        });
	}
	
	function next() {
		if (${isLast == false}) {
			$.ajax({
	            async: false,
	            type: 'get',
	            url: '${nextUrl}',
	            success: function (response){
	                $('#modalDiv').empty().html(response);
	                repositionDialog();
	            }
	        });
		} else {
			$modalDialog.dialog("close");
    	}
	}
	
	function loadNew() {
		load(0, "New asset information successfully entered.");
	}
	
	function load(id, error) {
		$.ajax({
            async: false,
            type: 'get',
            url: '${loadUrl}?generalMessage=' + error + "&auId=" + id,
            success: function (response){
                $('#modalDiv').empty().html(response);
                repositionDialog();
            }
        });
	}

	function add(id, fnCallback) {
		$.ajax({
            async: false,
            type: 'get',
            url: '${addUrl}' + "?auId=" + id,
            success: function (response){
       			if (eval ("typeof " + fnCallback) == 'function') {
			       	eval (fnCallback + "(id)");
			    }
            }
        });
	}
	//]]>		
	</script>
	
	<h1> ${assetUse.asset.description} </h1>
	<jsp:directive.include file="/WEB-INF/tiles/pages/include/generalMessage.jspx" />
	<div id="tabs">
		<ul>
			<li><a href="${assetDetailsUrl}">Details</a></li>
			<c:if test="${param.auId != 0}">
				<li><a href="${assetPermissionsUrl}">Permissions</a></li>
			</c:if>
		</ul>
	</div>	

	<div class="buttonset">
	<c:if test="${!isFirst}">
		<input type="button" id="prevB" value="Previous" />
	</c:if>
	<c:if test="${!isLast}">
		<input type="button" id="nextB" value="Next" />
	</c:if>
	</div>
</jsp:root>
