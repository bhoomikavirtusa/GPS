<?xml version="1.0" encoding="UTF-8" ?>
<jsp:root version="2.2"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:wileyfn="http://permissions.wiley.com/tlds/functions">

	<c:url var="landingUrl" value="/sapp/cwlanding/main" />

	<form:form modelAttribute="assetSearchForm">
		<spring:hasBindErrors name="assetSearchForm">
			<jsp:directive.include file="/WEB-INF/tiles/pages/include/formErrors.jspx" />
		</spring:hasBindErrors>

		<script type="text/javascript">
			function isWhitespace(string) {
				var pattern = /^\s*$/;
				return pattern.test(string);
			}

			function syncCheckbox(textField, checkboxId) {
				var checkbox = document.getElementById(checkboxId);
				checkbox.checked = !isWhitespace(textField.value);
			}

			/** Called below when the page is first loaded. */
			function checkSearchType() {
            	var radioCurrent = document.getElementById("searchByCurrentCommonWork1");
            	changeSearchType(radioCurrent.checked);
			}

			/** Called when the radio value is changed. */
			function changeSearchType(current) {
		    	
		    
		    	/** Removed as this DM-280 requirement is both for current product as well as multiple products */
		    	
				 var productDetails = document.getElementById("productDetails");
				productDetails.style.display = current ? "none" : "block";

				var includeCommonWorkId = document.getElementById("includeCommonWorkId");
		    	includeCommonWorkId.value = current;
		    	
		    	var includeEnteredCwID = document.getElementById("includeEnteredCwID1");
		    	includeEnteredCwID.disabled = current;
		    	
				// display: none does not affect form submission, so also disable
				// all the product details include checkboxes, which will affect
				// form submission
			
				var includeAuthor = document.getElementById("includeAuthor1");
				var includeTitle = document.getElementById("includeTitle1");
				//var includeIsbn13 = document.getElementById("includeIsbn131");//updated for DM-280
				//var includeIsbn10 = document.getElementById("includeIsbn101");//Added for DM-280
				var includeCopyrightYear = document.getElementById("includeCopyrightYear1");

				includeAuthor.disabled = current;
				includeTitle.disabled = current;
				//includeIsbn13.disabled = current; 
				//includeIsbn10.disabled = current; 
				includeCopyrightYear.disabled = current;
				
				//Start: Added for DM-280
				var includeProductNumber = document.getElementById("includeProductNumber1");
				var includeEditionNumber = document.getElementById("includeEditionNumber1");
				var includeBusinessUnit = document.getElementById("includeBusinessUnit1");
				var includeProductPriorit = document.getElementById("includeProductPriority1");
				var includeMedium = document.getElementById("includeMedium1");
				var includeDataSource = document.getElementById("includeDataSource1");
				var includeComplianceStatus = document.getElementById("includeComplianceStatus1");
				var includeEditorCode = document.getElementById("includeEditorCode1");
				var includeEditorName = document.getElementById("includeEditorName1");
				var includeAUNotCancelCount = document.getElementById("includeAUNotCancelCount1");
				var includeCoverCountNotCanceled = document.getElementById("includeCoverCountNotCanceled1");
				var includeStatusNotOkCount = document.getElementById("includeStatusNotOkCount1");
				var includePhotoIllusTotalCount = document.getElementById("includePhotoIllusTotalCount1");
				var includePhotoEditorLastName = document.getElementById("includePhotoEditorLastName1");
				var includePhotoEditorFirstName = document.getElementById("includePhotoEditorFirstName1");
				var includeLastUpdatedDate = document.getElementById("includeLastUpdatedDate1");
				var includeConsolidatedReleaseDate = document.getElementById("includeConsolidatedReleaseDate1");
				var includeTransmittalDate = document.getElementById("includeTransmittalDate1");
				
				
				includeProductNumber.disabled = current;
				includeEditionNumber.disabled = current;
				includeBusinessUnit.disabled = current;
				includeProductPriority.disabled = current;
				includeMedium.disabled = current;
				includeDataSource.disabled = current;
				includeComplianceStatus.disabled = current;
				includeEditorCode.disabled = current;
				includeEditorName.disabled = current;
				includeAUNotCancelCount.disabled = current;
				includeCoverCountNotCanceled.disabled = current;
				includeStatusNotOkCount.disabled = current;
				includePhotoIllusTotalCount.disabled = current;
				includePhotoEditorLastName.disabled = current;
				includePhotoEditorFirstName.disabled = current;
				includeLastUpdatedDate.disabled = current;
				includeConsolidatedReleaseDate.disabled = current;
				includeTransmittalDate.disabled = current;  
				//End: Added for DM-280

			}

			function resetForm() {
				var form = document.getElementById("assetSearchForm");
				form.reset();
				checkSearchType();
			}

			function clearForm() {
				var form = document.getElementById("assetSearchForm");

				for (i = 0; i &lt; form.elements.length; i++) {
    	            var e = form.elements[i];

					switch (e.type) {
					    case "text":
					    case "textarea":
				    	case "password":
					    	e.value = ""; break;
				    	case "radio":
					    	// do nothing
					    	break;
				    	case "checkbox":
					    	e.checked = "";  break;
				    	case "select-one":
				    	case "select-multiple":
				    	case "hidden":
					    	// do nothing
					    	break;
						default:
							// do nothing
							break;
					}
				}
			}
		</script>
		
		<table class="width100">
			<tr>
				<th>
					Assets Advanced Search
				</th>
				<th></th>
			</tr>		
			<tr>
				<td colspan="2">
				    <table>
				        <tr>
				            <td>Search across:</td>
				            <td><form:radiobutton path="searchByCurrentCommonWork" value="true" onclick="changeSearchType(true)" />Current product</td>
				            <td><form:radiobutton path="searchByCurrentCommonWork" value="false" onclick="changeSearchType(false)" />Multiple products</td>
				        </tr>
				    </table>
				</td>
			</tr>
		    <tr>
		        <td>
		            <table id="productDetails">
		                <tr>
		                	<td colspan="3"><h2>Product Details</h2></td>
		                </tr>
		                <tr style="font-weight: bold">
							<td colspan="2">Check to search on</td>
							<td>Search Value</td>
						</tr>
						<tr>
		                	<td class="label">
			        			<form:checkbox path="includeEnteredCwID" />
			    			</td>
			    			<td>
			        			<form:label path="enteredCwID" cssClass="optional" cssErrorClass="error">Common Work ID</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="enteredCwID" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeEnteredCwID1')" />
			    			</td>
		                </tr>
		                <tr>
		                    <!-- Use class label only where we want right-aligned. -->
		                	<td class="label">
			        			<form:checkbox path="includeAuthor" />
			        			<form:hidden path="includeCommonWorkId" />
			        			<form:hidden path="commonWorkId" />
			    			</td>
			    			<td>
			        			<form:label path="author" cssClass="optional" cssErrorClass="error">Author Name</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="author" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeAuthor1')" />
			    			</td>
		                </tr>
		                <tr>
		                	<td class="label">
			        			<form:checkbox path="includeTitle" />
			    			</td>
			    			<td>
			        			<form:label path="title" cssClass="optional" cssErrorClass="error">Title Name</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="title" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeTitle1')" />
			    			</td>
		                </tr>
		           <!--   Removed ISBN13 and ISBN10 as Tim suggested not a sho-stopper but confusing  --> 
		           
		                <tr>
		                	<td class="label">
			        			<form:checkbox path="includeCopyrightYear" />
			    			</td>
			    			<td>
			        			<form:label path="copyrightYear" cssClass="optional" cssErrorClass="error">Copyright Year</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="copyrightYear" size="4" maxlength="4" onchange="syncCheckbox(this, 'includeCopyrightYear1')" />
			    			</td>
		                </tr>
		                <tr>
		                	<td class="label">
			        			<form:checkbox path="includeUserName" />
			    			</td>
			    			<td>
			        			<form:label path="userName" cssClass="optional" cssErrorClass="error">User Name</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="userName" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeUserName1')" />
			    			</td>
		                </tr>
		                <tr>
			    			<td class="label">
			        			<form:checkbox path="includePublicationStatus" />
			    			</td>
			    			<td>
			        			<form:label path="publicationStatus" cssClass="optional" cssErrorClass="error">Publication Status</form:label>
			    			</td>
			    			<td class="value">
			        			<form:select path="publicationStatus" onchange="syncCheckbox(this, 'includePublicationStatus1')">
			        				<form:options items="${publicationStatusList}" itemValue="code" itemLabel="codeAndDescription" />
			        			</form:select>
			    			</td>
						</tr>
						<!-- Start: Added for DM-280 -->
		                <tr>
		                	<td class="label">
			        			<form:checkbox path="includeProductNumber" />
			    			</td>
			    			<td>
			        			<form:label path="productNumber" cssClass="optional" cssErrorClass="error">Product Number</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="productNumber" size="20" maxlength="20" onchange="syncCheckbox(this, 'includeProductNumber1')" />
			    			</td>
		                </tr>
		                <tr>
			    			<td class="label">
			        			<form:checkbox path="includeBusinessUnit" />
			    			</td>
			    			<td>
			        			<form:label path="businessUnit" cssClass="optional" cssErrorClass="error">Business Unit Name</form:label>
			    			</td>
			    			<td class="value">
			        			<form:select path="businessUnit" onchange="syncCheckbox(this, 'includeBusinessUnit1')">
			        				<form:options items="${businessUnits}" itemValue="code" itemLabel="name" />
			        			</form:select>
			    			</td>
						</tr>
						 <tr>
		                	<td class="label">
			        			<form:checkbox path="includeBunitCode" />
			    			</td>
			    			<td>
			        			<form:label path="bunitCode" cssClass="optional" cssErrorClass="error">Business Unit Code</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="bunitCode" size="2" maxlength="2" onchange="syncCheckbox(this, 'includeBunitCode1')" />
			    			</td>
		                </tr>
						<tr>
		                	<td class="label">
			        			<form:checkbox path="includeEditionNumber" />
			    			</td>
			    			<td>
			        			<form:label path="editionNumber" cssClass="optional" cssErrorClass="error">Edition Number</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="editionNumber" size="20" maxlength="20" onchange="syncCheckbox(this, 'includeEditionNumber1')" />
			    			</td>
		                </tr>
		                <tr>
		                	<td class="label">
			        			<form:checkbox path="includeProductPriority" />
			    			</td>
			    			<td>
			        			<form:label path="productPriority" cssClass="optional" cssErrorClass="error">Product Priority</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="productPriority" size="20" maxlength="20" onchange="syncCheckbox(this, 'includeProductPriority1')" />
			    			</td>
		                </tr>
		                <tr>
			    			<td class="label">
			        			<form:checkbox path="includeMedium" />
			    			</td>
			    			<td>
			        			<form:label path="medium" cssClass="optional" cssErrorClass="error">Medium Code</form:label>
			    			</td>
			    			<td class="value">
			        			<form:select path="medium" onchange="syncCheckbox(this, 'includeMedium1')">
			        				<form:options items="${mediums}" itemValue="code" itemLabel="name" />
			        			</form:select>
			    			</td>
						</tr>
						<tr>
			    			<td class="label">
			        			<form:checkbox path="includeDataSource" />
			    			</td>
			    			<td>
			        			<form:label path="dataSource" cssClass="optional" cssErrorClass="error">Data Source</form:label>
			    			</td>
			    			<td class="value">
			        			<form:select path="dataSource" onchange="syncCheckbox(this, 'includeDataSource1')">
			        				<form:option value="AU" label="AU" />
			        				<form:option value="CA" label="CA" />
			        				<form:option value="DE" label="DE" />
			        				<form:option value="SG" label="SG" />
			        				<form:option value="UK" label="UK" />
			        				<form:option value="US" label="US" />
			        			</form:select>
			    			</td>
						</tr>
						<tr>
		                	<td class="label">
			        			<form:checkbox path="includeShortAuthorName" />
			    			</td>
			    			<td>
			        			<form:label path="shortAuthorName" cssClass="optional" cssErrorClass="error">Short Author Name</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="shortAuthorName" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeShortAuthorName1')" />
			    			</td>
		                </tr>
						<tr>
			    			<td class="label">
			        			<form:checkbox path="includeComplianceStatus" />
			    			</td>
			    			<td>
			        			<form:label path="complianceStatus" cssClass="optional" cssErrorClass="error">Compliance Status</form:label>
			    			</td>
			    			<td class="value">
			        			<form:select path="complianceStatus" onchange="syncCheckbox(this, 'includeComplianceStatus1')">
			        				<form:option value="inProgress" label="In Progress" />
			        				<form:option value="noPermReq" label="No Permissions Req." />
			        				<form:option value="complete" label="Complete" />
			        				<form:option value="completeNo3rdPrty" label="Complete: No Third-Party Assets" />
			        			</form:select>
			    			</td>
						</tr>
						<tr>
		                	<td class="label">
			        			<form:checkbox path="includeEditorCode" />
			    			</td>
			    			<td>
			        			<form:label path="editorCode" cssClass="optional" cssErrorClass="error">Editor Code</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="editorCode" size="20" maxlength="20" onchange="syncCheckbox(this, 'includeEditorCode1')" />
			    			</td>
		                </tr>
		                <tr>
		                	<td class="label">
			        			<form:checkbox path="includeEditorName" />
			    			</td>
			    			<td>
			        			<form:label path="editorName" cssClass="optional" cssErrorClass="error">Editor Name</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="editorName" size="60" maxlength="60" onchange="syncCheckbox(this, 'includeEditorName1')" />
			    			</td>
		                </tr>
		                <tr>
		                	<td class="label">
			        			<form:checkbox path="includeAUNotCancelCount" />
			    			</td>
			    			<td>
			        			<form:label path="auCountNotCanceledCnt" cssClass="optional" cssErrorClass="error">Asset Use Not Cancelled Count</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="auCountNotCanceledCnt" size="20" maxlength="20" onchange="syncCheckbox(this, 'includeAUNotCancelCount1')" />
			    			</td>
		                </tr>
