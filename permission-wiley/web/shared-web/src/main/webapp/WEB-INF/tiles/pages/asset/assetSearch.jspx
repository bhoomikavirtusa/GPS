			<jsp:attribute name="value">Search</jsp:attribute>
		</jsp:element>

		<jsp:element name="input">
			<jsp:attribute name="type">button</jsp:attribute>
			<jsp:attribute name="value">Reset</jsp:attribute>
			<jsp:attribute name="onclick">resetForm(); return false;</jsp:attribute>
		</jsp:element>

		<jsp:element name="input">
			<jsp:attribute name="type">button</jsp:attribute>
			<jsp:attribute name="value">Clear</jsp:attribute>
			<jsp:attribute name="onclick">clearForm(); return false;</jsp:attribute>
		</jsp:element>
