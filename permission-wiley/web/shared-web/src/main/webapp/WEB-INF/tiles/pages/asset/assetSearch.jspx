						</tr>
						-->
						<tr>
							<!-- Use class label only where we want right-aligned. -->
			   				<td class="label">
			        			<form:checkbox path="includeSourceName" />
			    			</td>
			    			<td>
			        			<form:label path="sourceName" cssClass="optional" cssErrorClass="error">Source Name</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="sourceName" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeSourceName1')" />
			    			</td>
						</tr>
						<tr>
			    			<td class="label">
			        			<form:checkbox path="includeMediaType" />
			    			</td>
			    			<td>
			        			<form:label path="mediaType" cssClass="optional" cssErrorClass="error">Media Type</form:label>
			    			</td>
			    			<td class="value">
			        			<form:select path="mediaType" onchange="syncCheckbox(this, 'includeMediaType1')">
			        				<form:options items="${mediaTypes}" itemValue="code" itemLabel="description" />
			        			</form:select>
			    			</td>
						</tr>
						<tr>
			    			<td class="label">
			        			<form:checkbox path="includeDescription" />
			    			</td>
			    			<td>
			        			<form:label path="description" cssClass="optional" cssErrorClass="error">Description</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="description" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeDescription1')" />
			    			</td>
						</tr>
						<tr>
			    			<td class="label">
			        			<form:checkbox path="includeKeywords" />
			    			</td>
			    			<td>
			        			<form:label path="keywords" cssClass="optional" cssErrorClass="error">Keywords</form:label>
			    			</td>
			    			<td class="value">
			        			<form:input path="keywords" size="50" maxlength="50" onchange="syncCheckbox(this, 'includeKeywords1')" />
			    			</td>
						</tr>
						<tr>
			    			<td class="label">
			        			<form:checkbox path="includeWorkForHire" />
			    			</td>
			    			<td>
			        			<form:label path="workForHire" cssClass="optional" cssErrorClass="error">Work For Hire</form:label>
			    			</td>
			    			<!-- Use radio button instead of checkbox because seems more intuitive for user. -->
			    			<!--
			    			<td class="value">
			        			<form:checkbox path="workForHire" onchange="syncCheckbox(this, 'includeWorkForHire1')" />
			    			</td>
			    			-->
			    			<td class="value">
