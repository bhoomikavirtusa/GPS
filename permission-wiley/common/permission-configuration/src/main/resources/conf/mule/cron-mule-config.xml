<?xml version="1.0" encoding="UTF-8"?>

<mule
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:quartz="http://www.mulesoft.org/schema/mule/quartz"	
	xmlns:spring="http://www.springframework.org/schema/beans"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/quartz http://www.mulesoft.org/schema/mule/quartz/current/mule-quartz.xsd
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.3.xsd
	">

	<quartz:connector name="quartzConnector" />

	<model name="cron">
		<service name="quartzBuildAssetIndex">
			<description>
				This configuration will create an inbound event for building the asset index weekly at 11pm on Friday.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="buildAssetIndex" cronExpression="0 0 23 ? * 5" jobName="assetIndexBuildTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="buildIndex"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="services.AssetUseIndexService" />
        	</component>
		</service>
		
		<service name="quartzFixCommonWorks">
			<description>
				This configuration will create an inbound event for fixing common works daily at 8:30pm.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="fixCommonWorks" cronExpression="0 30 20 * * ?" jobName="fixCommonWorksTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="fixCommonWorks"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="repository.CommonWorkRepository" />
        	</component>
		</service>
		
		<service name="quartzProductIndexUpdateComputed">
			<description>
				This configuration will create an inbound event for updating all computed fields on the product daily at 9:00pm.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="productIndexUpdateComputed" cronExpression="0 0 21 * * ?" jobName="productIndexUpdatedComputedTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="updateComputedFields"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="services.ProductIndexService" />
        	</component>
		</service>
		
		<service name="quartzCleanCachedMessages">
			<description>
				This configuration will create an inbound event for cleaning the cached messages daily at 1am.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="cleanCachedMesssages" cronExpression="0 0 1 * * ?" jobName="cleanMessagesTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="clean"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="repository.CachedMessageRepository" />
        	</component>
		</service>

		<service name="quartzCountNotProcessedMessages">
			<description>
				This configuration will create an inbound event for checking the number of not processed messages daily at 1:30am.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="countNotProcessedMessages" cronExpression="0 30 1 * * ?" jobName="countNotProcessedMessagesTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="checkNotProcessedCount"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="repository.CachedMessageRepository" />
        	</component>
		</service>

		<service name="quartzOutOfCompliance">
			<description>
				This configuration will create an inbound event for sending notifications and calculating possible out of compliance assets,
				weekly on Sunday at 11pm.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="calculateOutOfCompliance" cronExpression="0 0 23 ? * 7" jobName="outOfComplianceTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="calculateOutOfCompliance"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="services.ContractService" />
        	</component>
		</service>
		
		<service name="quartzEbookSales">
			<description>
				This configuration will create an inbound event for updating ebook sales numbers
				on the second of each month at 7pm.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="updateEbookSales" cronExpression="0 0 19 2 * ?" jobName="ebookSalesTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="updateEbookSales"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="services.ProductService" />
        	</component>
		</service>
		
		<service name="quartzProductGrossUnits">
			<description>
				This configuration will create an inbound event for updating all product sales counts especially eBook on the product everyday at 10pm.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="productGrossUnits" cronExpression="0 0 22 * * ?" jobName="productGrossUnitsTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="updateGrossUnitsFromBMIS"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="services.ProductService" />
        	</component>
		</service>
		
		<service name="productUpdateCron">

		  <description>
		  This configuration will create an inbound event for product updates at 2am daily.
		  </description>
		  <inbound>
		    <quartz:inbound-endpoint name="requestProductUpdateSinceLastCheck" cronExpression="0 0 2 * * ?" jobName="productUpdateTrigger" connector-ref="quartzConnector">
			    <quartz:event-generator-job />		    
		    </quartz:inbound-endpoint>
		  </inbound>
		  <component>
		  	<method-entry-point-resolver>
			  	<include-entry-point method="requestProductUpdateSinceLastCheck"/>
		  	</method-entry-point-resolver>
            <spring-object bean="services.message.PEMessageService" />
            </component>
		</service>

		<service name="masterListUpdateCron">
		  <description>
		  This configuration will create an inbound event for masterList updates at 3am daily.
		  </description>
		  <inbound>
		    <quartz:inbound-endpoint name="requestMasterListUpdateSinceLastCheck" cronExpression="0 0 3 * * ?" jobName="masterListUpdateTrigger" connector-ref="quartzConnector">
			    <quartz:event-generator-job />		    
		    </quartz:inbound-endpoint>
		  </inbound>
		  <component>
		  	<method-entry-point-resolver>
			  	<include-entry-point method="requestMasterListUpdateSinceLastCheck"/>
		  	</method-entry-point-resolver>
            <spring-object bean="services.message.PEMessageService" />
          </component>
		</service>	
		
		<service name="quartzDeleteExcelFiles">
			<description>
				This configuration will create an inbound event for deleting Asset Excel Files older than 30 days
				on the second of each month at 8 pm.
			</description>
			<inbound>
		    	<quartz:inbound-endpoint name="deleteExcelFiles" cronExpression="0 0 19 2 * ?" jobName="deleteExcelFilesTrigger" connector-ref="quartzConnector">
			    	<quartz:event-generator-job />
		    	</quartz:inbound-endpoint>
			</inbound>
			<component>
		  		<method-entry-point-resolver>
			  		<include-entry-point method="deleteExcelFiles"/>
		  		</method-entry-point-resolver>
            	<spring-object bean="services.CommonWorkService" />
        	</component>
		</service>
		</model>
</mule>