		<service name="CompCopyAuService">
			<inbound>
				<vm:inbound-endpoint
					path="services.CompCopyAuService"
					exchange-pattern="request-response"
					responseTransformer-refs="ToString CompCopyXmlToObject">
				</vm:inbound-endpoint>
			</inbound>

			<http:rest-service-component httpMethod="GET" 
			   serviceUrl="${comp.copy.request.au.url}+isbn10(a0100):#[map-payload:isbn10]+account13(a0300):#[map-payload:acctno]+fname(a0300):#[map-payload:fname]+lname(a0300):#[map-payload:lname]+
			   street1(a0300):#[map-payload:street1]+street2(a0300):#[map-payload:street2]+city(a0300):#[map-payload:city]+state(a0300):#[map-payload:state]+isocntry(a0040):#[map-payload:countrycode]+postcode(a0090):#[map-payload:postcode]" />
		</service>
		

		<!-- Not being used but leave here for now -->
		<service name="RightsLinkService">
			<inbound>
				<vm:inbound-endpoint
					path="services.RightsLinkLicenseService"
					exchange-pattern="request-response"
					responseTransformer-refs="ToString XmlDecoder">
				</vm:inbound-endpoint>
			</inbound>

			<http:rest-service-component httpMethod="GET" 
			   serviceUrl="https://dem100.copyright.com/svc-rightslink-rest/rest/licenses/#[map-payload:licenseNumber].xml">
			</http:rest-service-component>
		</service>

	</model>
</mule>
