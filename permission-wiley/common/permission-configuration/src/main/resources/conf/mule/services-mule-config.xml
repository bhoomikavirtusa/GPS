		<service name="CompCopyService">
			<inbound>
				<vm:inbound-endpoint
					path="services.CompCopyService"
					exchange-pattern="request-response"
					responseTransformer-refs="ToString CompCopyXmlToObject">
				</vm:inbound-endpoint>
			</inbound>

			<http:rest-service-component httpMethod="GET" 
			   serviceUrl="${comp.copy.request.url}+isbn10(a0100):#[map-payload:isbn10]+fname(a0300):#[map-payload:fname]+lname(a0300):#[map-payload:lname]+street1(a0300):#[map-payload:street1]+street2(a0300):#[map-payload:street2]+city(a0300):#[map-payload:city]+state(a0300):#[map-payload:state]+isocntry(a0040):#[map-payload:countrycode]+postcode(a0090):#[map-payload:postcode]+vendctry(a0020):#[map-payload:countrycode]" />

