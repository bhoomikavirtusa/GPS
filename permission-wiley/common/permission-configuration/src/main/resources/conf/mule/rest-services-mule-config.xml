	<model name="RestServices">
		<default-service-exception-strategy enableNotifications="false">
			<rollback-transaction exception-pattern="*"/>
		</default-service-exception-strategy>
		
	    <service name="ProductServiceResource">
			<inbound>
			     <inbound-endpoint address="http://${mule.host.bind}:${rest.port.internal}/service/product"/>
			</inbound>
				 <jersey:resources>
					<component>
						<spring-object bean="resources.ProductResource" />
					</component>
				</jersey:resources>
		</service>
		
		<!--  Mule 3 example (still using old tags) -->
		<!--
		<service name="ProductServiceResource">
	    	<inbound>
				<http:inbound-endpoint host="${mule.host.bind}" port="${rest.port.internal}" path="service/product" />
			</inbound>
			<jersey:resources>
				<component>
					<spring-object bean="resources.ProductResource" />
				</component>
			</jersey:resources>
		</service>
		-->
		
	    <service name="UserServiceResource">
			<inbound>
			     <inbound-endpoint address="http://${mule.host.bind}:${rest.port.internal}/service/user"/>
			</inbound>	
				 <jersey:resources>
					<component>
						<spring-object bean="resources.UserResource" />
					</component>
				</jersey:resources>			
		</service>
		
	    <service name="AssetServiceResource">
			<inbound>
			     <inbound-endpoint address="http://${mule.host.bind}:${rest.port.internal}/service/asset"/>
			</inbound>	
				 <jersey:resources>
					<component>
						<spring-object bean="resources.AssetResource" />
					</component>
				</jersey:resources>			
		</service>

	    <service name="SourceServiceResource">
			<inbound>
			     <inbound-endpoint address="http://${mule.host.bind}:${rest.port.internal}/service/source"/>
			</inbound>		
				 <jersey:resources>
					<component>
						<spring-object bean="resources.SourceResource" />
					</component>
				</jersey:resources>			
		</service>
	</model>
</mule>
