<?xml version="1.0" encoding="ISO-8859-1"?>
<workbook>
	<worksheet name="Asset List">
		<section startRow="${row}" endRow="${row}" />
		<section startRow="${row}" endRow="${row}" />
		<loop startRow="${row}" endRow="${row}" items="assets" var="assetUse"
			varType="com.wiley.permissions.domain.persistence.permissions.ExtendedAssetUse">
			<section startRow="${row}" endRow="${row}">
				<definitions/>
			</section>
			<loopbreakcondition>
 				<rowcheck offset="0">
 					<cellcheck offset="0"></cellcheck>
 					<cellcheck offset="1"></cellcheck>
 					<cellcheck offset="2"></cellcheck>
 					<cellcheck offset="3"></cellcheck>
 					<cellcheck offset="4"></cellcheck>
 					<cellcheck offset="5"></cellcheck>
 					<cellcheck offset="6"></cellcheck>
 					<cellcheck offset="7"></cellcheck>
 					<cellcheck offset="8"></cellcheck>
 				</rowcheck>
 			</loopbreakcondition>			
		</loop>
	</worksheet>
</workbook>