<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.wiley.permissions.common</groupId>
		<artifactId>common</artifactId>
		<version>1.0-SNAPSHOT</version>
	</parent>
	
	<!-- When groupId and version tags omitted here, same as parent -->
	<modelVersion>4.0.0</modelVersion>
	<artifactId>permission-security-lib</artifactId>
	<packaging>jar</packaging>
	<name>Permissions Security Library</name>
	<url>http://maven.apache.org</url>
	
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		
		<dependency>
			<!-- This jar file needed for imports in our SecurityRealm.java -->
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-catalina</artifactId>
			<!-- This should match the version of Tomcat we are using. -->
			<version>7.0.53</version>
			<scope>provided</scope>
		</dependency>
		
		<dependency>
	        <groupId>org.springframework.security</groupId>
	        <artifactId>spring-security-web</artifactId>
	    </dependency>
		    		
		<dependency>
			<groupId>commons-logging</groupId>
			<artifactId>commons-logging-api</artifactId>
			<version>1.1</version>
			<scope>provided</scope>
		</dependency>
		
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>${jaxb-api.version}</version>
		</dependency>

		<dependency>
			<groupId>com.sun.xml.bind</groupId>
			<artifactId>jaxb-impl</artifactId>
			<version>${jaxb-impl.version}</version>
		</dependency>
		
		<dependency>
            <groupId>com.wiley.sf</groupId>
            <artifactId>sf-common2</artifactId>
        </dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar.version}</version>
				<executions>
					<!--
						This execution makes sure it's on the library with the rest of our
						Mule jars
					-->
					<execution>
						<id>mule</id>
						<phase>package</phase>

						<goals>
							<goal>jar</goal>
						</goals>
						
						<configuration>
							<outputDirectory>${perm.mule.dir}</outputDirectory>
						</configuration>
					</execution>
					
					<!--
						This execution makes sure it's available for Tomcat on dev machines

					<execution>
						<id>tomcat</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<outputDirectory>${perm.tomcat.lib.dir}</outputDirectory>
							<finalName>${project.artifactId}</finalName>
						</configuration>
					</execution>
					-->					
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
