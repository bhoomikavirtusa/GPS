		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.6.1</version>
				<configuration>
					<!-- smarkoff: If change source/target to 1.7 then when run get following exception. -->
					<!-- I think a library we are using to generate bytecode dynamically needs to be updated to work with Java 7 -->
					<!-- Info: http://stackoverflow.com/questions/15122890/java-lang-verifyerror-expecting-a-stackmap-frame-at-branch-target-jdk-1-7 -->
					<!-- Info: http://chrononsystems.com/blog/java-7-design-flaw-leads-to-huge-backward-step-for-the-jvm -->
					<!--
					org.springframework.beans.factory.BeanCreationException: Error creating bean with name 'permissions' defined in class path resource
					  [conf/spring/persistence-context.xml]: Invocation of init method failed; nested exception is java.lang.VerifyError:
					  Expecting a stackmap frame at branch target 15
					Exception Details:
  					Location:
    					com/wiley/permissions/domain/persistence/permissions/Account.$javassist_write_accountNumber(Ljava/lang/String;)V @6: ifnonnull
  					Reason:
    					Expected stackmap frame at this location.
					 -->
					<source>1.8</source>
					<target>1.8</target>
