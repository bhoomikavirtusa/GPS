	<!-- ****************************  Profiles  ******************************** -->

	<profiles>
		<profile>
			<id>test</id>

			<properties>
				<maven.test.skip>false</maven.test.skip>
			</properties>
		</profile>

		<!-- The local profile (the default) is used on local developer machines. -->
		<profile>
			<id>local</id>

			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>

			<properties>
				<perm.mule.dir>${env.MULE_HOME}/lib/user</perm.mule.dir>
				<perm.tomcat.apps.dir>${env.CATALINA_HOME}/webapps</perm.tomcat.apps.dir>
				<perm.tomcat.lib.dir>${env.CATALINA_HOME}/lib</perm.tomcat.lib.dir>
				<perm.build.profile>local</perm.build.profile>
			</properties>
		</profile>

		<!-- The development profile is now used for development, qa, and production deployments. -->
		<!-- (Hudson needs to specify this profile.) -->
		<profile>
			<id>development</id>
			
			<activation>
			</activation>

			<properties>
				<perm.build.profile>development</perm.build.profile>
				<perm.build.root>${env.PERMISSIONS_HOME}/deploy/${perm.build.profile}</perm.build.root>
				<perm.mule.dir>${perm.build.root}/mule</perm.mule.dir>
				<perm.tomcat.apps.dir>${perm.build.root}/tomcat</perm.tomcat.apps.dir>
				<perm.tomcat.lib.dir>${perm.build.root}/tomcat</perm.tomcat.lib.dir>
			</properties>
		</profile>
	</profiles>
