<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.wiley.permissions.message</groupId>
		<artifactId>messaging-parent</artifactId>
		<version>1.0-SNAPSHOT</version>
	</parent>
	
	<!-- When groupId and version tags omitted here, same as parent -->
	<modelVersion>4.0.0</modelVersion>
	<artifactId>permission-message-services</artifactId>
	<name>Permissions Message Services Module</name>
	<url>http://maven.apache.org</url>
	
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		
		<dependency>
			<groupId>com.wiley.permissions.common</groupId>
			<artifactId>permission-common-utils</artifactId>
			<version>1.0-SNAPSHOT</version>
		</dependency>

		<dependency>
			<groupId>com.wiley.permissions.common</groupId>
			<artifactId>permission-persistence</artifactId>
			<version>1.0-SNAPSHOT</version>
			<exclusions>
                <exclusion>
                    <artifactId>geronimo-j2ee-management_1.0_spec.osgi</artifactId>
                    <groupId>org.apache.geronimo.specs</groupId>
                </exclusion>
            </exclusions>
		</dependency>

		<dependency>
			<groupId>com.wiley.permissions.services</groupId>
			<artifactId>permission-services</artifactId>
			<version>1.0-SNAPSHOT</version>
		</dependency>

		<dependency>
				<groupId>com.ibm.mq</groupId>
				<artifactId>com.ibm.mq.allclient</artifactId>
				<version>9.1.3.0</version>
			</dependency>

		

		
	</dependencies>
	
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar.version}</version>
				<configuration>
					<outputDirectory>${perm.mule.dir}</outputDirectory>
				</configuration>
			</plugin>
			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.version}</version>
				<configuration>
					<excludes>
						<exclude>**/*Test.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
